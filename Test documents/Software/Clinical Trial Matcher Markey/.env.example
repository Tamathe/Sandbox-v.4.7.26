# ──────────────────────────────────────────────────────────────────────────
# UK Markey Cancer Center - Clinical Trial Matcher
# Copy this file to .env and fill in your credentials
# ──────────────────────────────────────────────────────────────────────────

# Required: Anthropic API key for Claude
# Get at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: OncoKB token for variant actionability annotation
# Free for academic use - request at: https://www.oncokb.org/api-access
ONCOKB_TOKEN=

# Optional: NCI Clinical Trials API key (for cancer-specific metadata)
# Request at: https://clinicaltrialsapi.cancer.gov/
NCI_API_KEY=

# Claude model selection (defaults are set in config.py)
# CLAUDE_MODEL=claude-sonnet-4-6
# CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# Output directory for reports and cached trial data
OUTPUT_DIR=output
