                  </div>
                ) : (
                  <div className="space-y-3">
                    {form.customMetrics.map((metric, i) => (
                      <div
                        key={i}
                        className="bg-gray-50 rounded-xl p-4 border border-gray-200 space-y-3"
                      >
                        <div className="flex items-center justify-between">
                          <span className="text-xs font-semibold text-gray-500">
                            Metric {i + 1}
                          </span>
                          <button
                            type="button"
                            onClick={() => removeMetric(i)}
                            className="text-gray-400 hover:text-red-500 transition-colors"
                          >
                            <Trash2 className="w-4 h-4" />
                          </button>
                        </div>
                        <input
                          type="text"
                          value={metric.name}
                          onChange={(e) => updateMetric(i, 'name', e.target.value)}
                          placeholder="Metric name (e.g., score, attempts, confidence)"
                          className="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm text-gray-800 outline-none focus:border-[#0033A0]"
                        />
                        <div className="grid grid-cols-2 sm:grid-cols-5 gap-1.5">
                          {METRIC_TYPE_INFO.map((info) => (
                            <button
                              key={info.type}
                              type="button"
                              onClick={() => updateMetric(i, 'type', info.type)}
                              title={info.example}
                              className={`px-2 py-2 rounded-lg border text-left transition-all ${
                                metric.type === info.type
                                  ? 'border-[#0033A0] bg-blue-50 text-[#0033A0]'
                                  : 'border-gray-200 text-gray-600 hover:border-gray-300'
                              }`}
                            >
                              <div className="text-xs font-semibold">{info.label}</div>
                              <div className="text-[10px] text-gray-400 leading-tight mt-0.5 hidden sm:block">{info.example}</div>
                            </button>
                          ))}
                        </div>
                        <input
                          type="text"
                          value={metric.description}
                          onChange={(e) => updateMetric(i, 'description', e.target.value)}
                          placeholder="Description (optional)"
                          className="w-full px-3 py-2 rounded-lg border border-gray-300 text-sm text-gray-800 outline-none focus:border-[#0033A0]"
                        />
                      </div>
                    ))}
                  </div>
                )}

                {form.toolType === 'EXTERNAL' && (
                  <div className="mt-3 bg-amber-50 border border-amber-200 rounded-xl p-4">
                    <div className="font-medium text-amber-800 text-sm mb-1">Webhook Payload Format</div>
                    <pre className="text-xs text-amber-700 bg-amber-100 rounded-lg p-3 overflow-x-auto">
                      {JSON.stringify(
                        {
                          sessionId: 'optional-session-id',
                          metrics: [
                            { name: 'score', value: 87 },
                            { name: 'completed', value: true },
                          ],
                        },
                        null,
                        2
                      )}
                    </pre>
                  </div>
                )}
              </div>

              {form.toolType === 'CHATBOT' && (
                <div className="rounded-2xl border border-gray-200 p-4 space-y-3">
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1.5">
                      Number of rounds/steps
                      <span className="font-normal text-gray-400 ml-1">(optional)</span>
                    </label>
                    <input
                      type="number"
                      min="1"
                      max="50"
                      value={form.totalSteps}
                      onChange={(e) => update('totalSteps', e.target.value)}
                      placeholder="e.g., 5"
                      className="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-800 outline-none focus:border-[#0033A0] focus:ring-1 focus:ring-[#0033A0]"
                    />
                  </div>
                  <div>
                    <label className="block text-sm font-medium text-gray-700 mb-1.5">
                      Step label
                      <span className="font-normal text-gray-400 ml-1">(optional)</span>
                    </label>
                    <input
                      type="text"
                      value={form.stepLabel}
                      onChange={(e) => update('stepLabel', e.target.value)}
                      placeholder="Round, Question, Case, Step..."
                      className="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-800 outline-none focus:border-[#0033A0] focus:ring-1 focus:ring-[#0033A0]"
                    />
                    <p className="mt-1 text-xs text-gray-400">
                      If you set a total step count, students will see a progress bar during chat.
                    </p>
                    {form.totalSteps && parseInt(form.totalSteps) > 0 && (
                      <div className="mt-2 rounded-xl border border-gray-200 bg-gray-50 px-4 py-3">
                        <p className="text-xs text-gray-400 mb-2">Preview:</p>
                        <div className="flex items-center gap-2">
                          <div className="flex gap-1">
                            {Array.from({ length: Math.min(parseInt(form.totalSteps) || 5, 10) }).map((_, i) => (
                              <div
                                key={i}
                                className={`w-2.5 h-2.5 rounded-full transition-colors ${i < 2 ? 'bg-[#0033A0]' : 'bg-gray-200'}`}
                              />
                            ))}
                            {parseInt(form.totalSteps) > 10 && <span className="text-xs text-gray-400">…</span>}
                          </div>
                          <span className="text-sm font-medium text-gray-700">
                            {form.stepLabel.trim() || 'Step'} 2 of {form.totalSteps}
                          </span>
                        </div>
                      </div>
                    )}
                  </div>
                </div>
              )}
            </>
          )}

          {/* Step 5: Preview */}
          {step === 5 && (
            <>
              <div>
                <div className="flex items-center justify-between mb-1.5">
                  <label className="block text-sm font-medium text-gray-700">
                    Full Description
                    <span className="font-normal text-gray-400 ml-1">(shown on the tool detail page)</span>
                  </label>
                  <div className="flex items-center gap-2">
                    <button
                      type="button"
                      onClick={async () => {
                        if (!form.shortDescription && !form.systemPrompt) return
                        update('fullDescription', '')
                        try {
                          const res = await fetch('/api/publish/generate-description', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'x-demo-user-email': currentUser.email },
                            body: JSON.stringify({
                              name: form.name,
                              shortDescription: form.shortDescription,
                              systemPrompt: form.systemPrompt,
                              intendedAudience: form.intendedAudience,
                              toolType: form.toolType,
                            }),
                          })
                          if (!res.ok || !res.body) return
                          const reader = res.body.getReader()
                          const decoder = new TextDecoder()
                          let result = ''
                          while (true) {
                            const { done, value } = await reader.read()
                            if (done) break
                            result += decoder.decode(value)
                            update('fullDescription', result.trim())
                          }
                        } catch { /* ignore */ }
                      }}
                      disabled={!form.shortDescription && !form.systemPrompt}
                      className="flex items-center gap-1.5 text-xs font-semibold text-[#0033A0] hover:text-[#002580] disabled:opacity-40 transition-colors"
                    >
                      <Sparkles className="w-3.5 h-3.5" />
                      Generate ✨
                    </button>
                    <button
                      type="button"
                      onClick={() => setPreviewMarkdown(!previewMarkdown)}
                      className="flex items-center gap-1.5 text-xs text-gray-500 hover:text-[#0033A0] transition-colors"
                    >
                      {previewMarkdown ? <><EyeOff className="w-3.5 h-3.5" /> Edit</> : <><Eye className="w-3.5 h-3.5" /> Preview</>}
                    </button>
                  </div>
                </div>
                {previewMarkdown ? (
                  <div className="prose max-w-none border border-gray-200 rounded-xl px-4 py-3 bg-gray-50 min-h-[120px]">
                    {form.fullDescription ? <ReactMarkdown>{form.fullDescription}</ReactMarkdown> : <p className="text-gray-400 italic">Start typing to preview...</p>}
                  </div>
                ) : (
                  <textarea
                    value={form.fullDescription}
                    onChange={(e) => update('fullDescription', e.target.value)}
                    placeholder="Markdown supported. Describe what the experience does, how to use it, and what students will gain..."
                    rows={5}
                    className="w-full px-4 py-2.5 rounded-xl border border-gray-300 text-sm text-gray-800 outline-none focus:border-[#0033A0] focus:ring-1 focus:ring-[#0033A0] resize-y"
                  />
                )}
              </div>

              <div>
                <h3 className="font-semibold text-gray-700 text-sm mb-3">Card Preview</h3>
                <div className="max-w-xs">
                  <ToolCard tool={previewTool} />
                </div>
              </div>

              <div>
                <h3 className="font-semibold text-gray-700 text-sm mb-3">Detail Header Preview</h3>
                <div className="bg-gray-50 rounded-xl border border-gray-200 p-5 space-y-2">
                  <div className="font-bold text-xl text-gray-900">
                    {form.name || '(untitled)'}
                  </div>
                  <p className="text-gray-500 text-sm">
                    {form.shortDescription || '(no short description)'}
                  </p>
                  {form.toolType === 'CHATBOT' && (
                    <div className="text-sm font-medium text-[#0033A0]">
                      {form.personaName.trim() || 'Sandy'}
                    </div>
                  )}
                  <div className="flex gap-2 flex-wrap mt-2">
                    <span className="text-xs px-2 py-0.5 rounded-full bg-gray-200 text-gray-600">
                      {form.category}
                    </span>
                    <span className="text-xs px-2 py-0.5 rounded-full bg-gray-200 text-gray-600">
                      {form.difficultyLevel}
                    </span>
                    <span className="text-xs px-2 py-0.5 rounded-full bg-gray-200 text-gray-600">
                      {form.toolType === 'CHATBOT' ? 'Conversational AI tutor' : 'Outside tool link'}
                    </span>
                  </div>
                </div>
              </div>

              {form.toolType === 'CHATBOT' && (
                <div className="space-y-3">
                  <div className="flex flex-wrap items-center justify-between gap-3">
                    <div>
                      <h3 className="font-semibold text-gray-700 text-sm">Preview as a student →</h3>
                      <p className="mt-1 text-xs text-gray-500">
                        See how the tutor responds before you publish it.
                      </p>
                    </div>
                    <button
                      type="button"
                      onClick={() => {
                        setShowPreviewChat((current) => {
                          if (!current) setHasOpenedPreview(true)
                          return !current
                        })
                      }}
                      className="inline-flex items-center gap-2 rounded-xl bg-[#0033A0] px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#002580]"
                    >
                      {showPreviewChat ? 'Hide preview' : 'Open preview'}
                    </button>
                  </div>

                  {showPreviewChat ? (
                    <ToolPreviewChat
                      key={previewDraftKey}
                      draftKey={previewDraftKey}
                      toolName={form.name}
                      personaName={form.personaName}
                      systemPrompt={form.systemPrompt}
                      welcomeMessage={form.welcomeMessage}
                      starterQuestions={form.starterQuestions.filter((question) => question.trim())}
                    />
                  ) : null}

                  {!hasOpenedPreview && (
                    <div className="flex items-start gap-2.5 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
                      <AlertTriangle className="w-4 h-4 text-amber-500 mt-0.5 flex-shrink-0" />
                      <span>You haven&apos;t tested this tool yet. We recommend sending a few messages in the preview above before publishing — it only takes a minute and often reveals issues you&apos;ll want to fix.</span>
                    </div>
                  )}
                </div>
              )}

              {error && (
                <div className="bg-red-50 border border-red-200 rounded-xl px-4 py-3 text-sm text-red-600">
                  {error}
                </div>
              )}

              {currentUser.role !== 'STUDENT' && (
                <>
                  <div className="rounded-xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-900">
                    Your tool will be live as <strong>Community</strong> — visible to all students immediately, no review required.{' '}
                    Check the box below to request a <strong>Verified</strong> badge from the admin team, usually approved within 1–2 days.
                  </div>
                  <label className="flex items-start gap-3 rounded-2xl border border-gray-200 bg-gray-50 px-4 py-3 cursor-pointer hover:bg-gray-100 transition-colors">
                    <input
                      type="checkbox"
                      checked={requestVerification}
                      onChange={(event) => setRequestVerification(event.target.checked)}
                      className="mt-0.5 h-4 w-4 rounded border-gray-300 text-[#0033A0] focus:ring-[#0033A0]"
                    />
                    <div>
                      <div className="text-sm font-semibold text-gray-800">Request admin review (gets a Verified badge)</div>
                      <div className="text-xs text-gray-500 mt-0.5">
                        An admin will review this experience. Approved experiences appear in the main marketplace.
                      </div>
                    </div>
                  </label>
                </>
              )}
            </>
          )}
        </div>

        {/* Navigation */}
        <div className="px-6 py-4 border-t border-gray-100 bg-gray-50 flex items-center justify-between">
          <button
            type="button"
            onClick={() => setStep((s) => s - 1)}
            disabled={step === 1}
            className="flex items-center gap-2 px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 disabled:opacity-40 transition-colors"
          >
            <ChevronLeft className="w-4 h-4" />
            Back
          </button>

          <div className={`flex gap-2 ${step < STEP_LABELS.length ? 'items-center' : 'w-full max-w-sm flex-col items-stretch'}`}>
            {step < STEP_LABELS.length ? (
              <button
                type="button"
                onClick={() => setStep((s) => s + 1)}
                disabled={
                  (step === 1 && (!form.name || !form.shortDescription)) ||
                  (step === 2 && form.toolType === 'EXTERNAL' && !form.externalUrl)
                }
                className="flex items-center gap-2 px-5 py-2.5 bg-[#0033A0] text-white rounded-xl text-sm font-medium hover:bg-[#002580] transition-colors disabled:opacity-50"
              >
                Next
                <ChevronRight className="w-4 h-4" />
              </button>
            ) : (
              <>
                {currentUser.role === 'STUDENT' && (
                  <div className="flex items-start gap-3 p-4 bg-amber-50 border border-amber-200 rounded-xl mb-2">
                    <input
                      type="checkbox"
                      id="student-verify"
                      checked={studentVerified}
                      onChange={(e) => setStudentVerified(e.target.checked)}
                      className="mt-0.5 w-4 h-4 rounded border-gray-300 text-[#0033A0] focus:ring-[#0033A0]"
                    />
                    <label htmlFor="student-verify" className="text-sm text-amber-800 leading-relaxed cursor-pointer">
                      I confirm this experience is appropriate for educational use and does not contain harmful, misleading, or inappropriate content. Student submissions are reviewed before appearing in the Marketplace.
                    </label>
                  </div>
                )}
                <div className="space-y-3">
                  {/* Inline audit result — students only */}
                  {isAuditing && (
                    <div className="rounded-xl border border-gray-200 bg-gray-50 px-4 py-4 flex items-center gap-3">
                      <Loader2 className="w-4 h-4 animate-spin text-[#0033A0] flex-shrink-0" />
                      <span className="text-sm font-medium text-gray-700">{auditMessage}</span>
                    </div>
                  )}

                  {auditResult?.verdict === 'AUTO_REJECT' && (
                    <div className="rounded-xl border border-red-200 bg-red-50 px-4 py-4 space-y-1.5">
                      <p className="text-sm font-semibold text-red-800">Not published.</p>
                      <p className="text-sm text-red-700">{auditResult.reason}</p>
                      <p className="text-xs text-red-500 mt-1">Edit the tool and try again.</p>
                    </div>
                  )}

                  {auditResult?.verdict === 'HUMAN_REVIEW' && (
                    <div className="rounded-xl border border-amber-200 bg-amber-50 px-4 py-4 space-y-1.5">
                      <p className="text-sm font-semibold text-amber-800">Submitted — pending review.</p>
                      <p className="text-sm text-amber-700">
                        Your tool is saved and in the review queue. An admin will approve or return it with feedback, usually within 1–2 business days.
                        You&apos;ll get an in-app notification when there&apos;s an update.
                      </p>
                      <p className="text-xs text-amber-600">You can continue editing your draft at any time from My Apps.</p>
                    </div>
                  )}

                  {!isAuditing && auditResult?.verdict !== 'HUMAN_REVIEW' && (
                    <>
                      {currentUser.role !== 'STUDENT' ? (
                        <div className="rounded-xl border border-blue-100 bg-blue-50 px-4 py-3 text-sm text-blue-900">
                          This will be visible to all UK students and faculty in the Marketplace.
                        </div>
                      ) : null}
                      <button
                        type="button"
                        onClick={() => handleSubmit(true)}
                        disabled={submitting || isAuditing || (currentUser.role === 'STUDENT' && !studentVerified)}
                        className="w-full rounded-xl bg-[#0033A0] py-3 text-sm font-semibold text-white transition-colors hover:bg-[#002580] disabled:opacity-60 flex items-center justify-center gap-2"
                      >
                        {submitting ? <Loader2 className="w-4 h-4 animate-spin" /> : null}
                        {submitting
                          ? (currentUser.role === 'STUDENT' ? 'Sharing…' : 'Publishing…')
                          : editingToolId
                            ? 'Update'
                            : currentUser.role === 'STUDENT' ? 'Share with Community' : 'Publish'}
                      </button>
                      <p className="text-xs text-center text-gray-500">
                        {currentUser.role === 'STUDENT'
                          ? 'Your tool will be reviewed before it appears in The Commons.'
                          : 'Visible to all UK students and faculty immediately. You can unpublish anytime.'}
                      </p>
                      <button
                        type="button"
                        onClick={() => handleSubmit(false)}
                        disabled={submitting || isAuditing}
                        className="w-full rounded-xl border border-gray-200 py-3 text-sm font-medium text-gray-600 transition-colors hover:bg-gray-50 disabled:opacity-60"
                      >
                        {submitting ? 'Saving…' : 'Save draft'}
                      </button>
                      <p className="text-xs text-center text-gray-500">
                        {currentUser.role === 'STUDENT'
                          ? 'Only you can see drafts. Come back anytime to finish and share.'
                          : 'Only you can see drafts. Come back anytime to finish and publish.'}
                      </p>
                    </>
                  )}
                </div>
              </>
            )}
          </div>
        </div>
      </div></>)}
    </div>
  )
}
</file>

<file path="prisma/schema.prisma">
generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  role            UserRole       @default(EDUCATOR)
  suspended       Boolean        @default(false)
  suspendedAt     DateTime?
  suspendedReason String?
  department      String?
  college         String?
  avatarUrl       String?
  bio             String?
  personalContext String?
  totalXP         Int            @default(0)
  createdAt       DateTime       @default(now())
  tools           Tool[]
  upvotes         Upvote[]
  favorites       Favorite[]
  ratings         ToolRating[]
  comments        Comment[]
  bountiesPosted  Bounty[]       @relation("BountiesPosted")
  bountiesClaimed Bounty[]       @relation("BountiesClaimed")
  courses         Course[]
  xpEvents        XPEvent[]
  userBadges      UserBadge[]
  userQuests      UserQuest[]
  userPlatformQuests UserPlatformQuest[]
  buildSessions   BuildSession[]
  toolSessions    ToolSession[]
  sandTransactions SandTransaction[]
  bountyReviews   BountyReview[]
  libraryEntries  LibraryEntry[]
  leaderboardEntries LeaderboardEntry[]
  challengesIssued   Challenge[]   @relation("ChallengesIssued")
  challengesReceived Challenge[]   @relation("ChallengesReceived")
  collabRequests  CollabRequest[] @relation("CollabRequests")
  collabReviews   CollabReview[]  @relation("CollabReviews")
  conversations   ConversationParticipant[]
  sentMessages    Message[]
  lastSeenAt      DateTime       @default(now())
  lastPath        String?        // Tracks current route (e.g., /courses/...) to derive Learn/Live/Build status
  portfolioItems  PortfolioItem[]
  memories        UserMemory[]
  studentNotes    StudentNote[]
  discussionThreads DiscussionThread[]
  discussionPosts DiscussionPost[]
  permittedContacts UserContact[] @relation("UserPermittedContacts") // People I allow to contact me
  contacting        UserContact[] @relation("UserContacts")          // People who allow me to contact them
  bracketPoolsCreated BracketPool[]     @relation("BracketPoolsCreated")
  bracketEntries      BracketEntry[]    @relation("BracketEntries")
  bracketEmailSubs    BracketEmailSub[] @relation("BracketEmailSubs")
  bookProfile         BookProfile?
  bookDigestSub       BookDigestSub?
  playgroundApps      PlaygroundApp[]
  appStoreDelegations AppStoreDelegate[]
  objectiveProgress   StudentObjectiveProgress[]
  courseEnrollments   CourseEnrollment[]
  materialReadStatuses MaterialReadStatus[]
  hostedCollabSessions CollabSession[]   @relation("CollabHost")
  collabParticipations CollabParticipant[]
  collabMessages       CollabMessage[]
  createdLeagues       League[]          @relation("LeagueCreator")
  leagueMemberships    LeagueMember[]
  leagueEmailSubs      LeagueEmailSub[]
  leagueEvents         LeagueEvent[]     @relation("LeagueEventActor")
  adminAnnouncements   AdminAnnouncement[] @relation("AdminAnnouncementCreator")
  adminAuditLogs       AdminAuditLog[]     @relation("AdminAuditActor")
  sandcastleSubmissions SandcastleSubmission[] @relation("SandcastleSubmissionCreator")
  sandcastleReviews     SandcastleSubmission[] @relation("SandcastleSubmissionReviewer")
  notifications       Notification[]
  submissions         Submission[]
  gradebookReviews    GradebookEntry[]        @relation("GradebookReviewer")
  interests           UserInterest[]

  // Onboarding
  title                 String?
  onboardingCompleted   Boolean   @default(false)
  onboardingCompletedAt DateTime?
  enrichmentSource      String?   // "ai-inferred" | "manual" | "partial"
  enrichmentConfidence  String?   // "high" | "medium" | "low"
  onboardingIntent      String?   // "course-tools" | "browse" | "referred" | "explore" | "assignment"
  onboardingIntentSetAt DateTime?

  // SIS / Registrar fields
  sisStudentId          String?
  program               String?   // e.g. "CS-BS" or "ENG-BA"
  catalogYear           String?   // e.g. "2024-2025"

  // Registrar relations
  degreeAuditResults    DegreeAuditResult[]   @relation("StudentAuditResults")
  petitions             Petition[]            @relation("StudentPetitions")
  petitionReviews       Petition[]            @relation("PetitionReviewer")
  petitionAuditEntries  PetitionAuditEntry[]  @relation("PetitionAuditActor")
}

model UserInterest {
  id       String   @id @default(cuid())
  userId   String
  tag      String
  source   String   // "bio-extraction" | "department-taxonomy" | "title-inference" | "manual" | "free-form" | "enrichment"
  accepted Boolean  @default(true)  // false = was suggested but user removed it
  addedAt  DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tag])
  @@index([userId])
}

model UserMemory {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  MemoryCategory
  content   String         @db.Text
  source    String         @default("notebook")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, category])
}

model StudentNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  content   String   @db.Text
  courseId  String?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  source    String   @default("sandy")   // "sandy" | "manual"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([userId, courseId])
}

enum MemoryCategory {
  IDENTITY
  GOALS
  STRENGTHS
  CHALLENGES
  PROJECTS
  WRITING_STYLE
  PERSONAL
}

enum UserRole {
  EDUCATOR
  STUDENT
  ADMIN
  REGISTRAR
}

model Tool {
  id                 String                   @id @default(cuid())
  name               String
  shortDescription   String
  fullDescription    String
  category           String
  difficultyLevel    String                   @default("Introductory")
  estimatedMinutes   Int?
  thumbnailUrl       String?
  toolType           ToolType
  externalUrl        String?
  systemPrompt       String?
  personaName        String?                  @default("Sandy")
  personaAvatar      String?
  welcomeMessage     String?
  starterQuestions   String[]
  referenceDocUrls   String[]
  learningObjectives String[]
  intendedAudience   String?
  published          Boolean                  @default(false)
  featured           Boolean                  @default(false)
  approvalStatus     ApprovalStatus           @default(COMMUNITY)
  fastTrackApprovedAt DateTime?
  suspendedAt        DateTime?
  suspendedReason    String?
  isOfficialService  Boolean                  @default(false)
  serviceProtocol    String?
  escalationEmail    String?
  webhookSecret      String?                  @default(cuid())
  collabEnabled      Boolean                  @default(false)
  collabModes        String[]                 @default([])
  collabMaxUsers     Int                      @default(4)
  audioEnabled       Boolean                  @default(false)
  audioPersonaName   String?
  audioEngine        String                   @default("openai")
  audioVoiceName     String?
  audioSpeakingStyle String?
  audioSpeed         Float                    @default(1.0)
  audioSystemSuffix  String?
  audioBackgroundTrack String?
  creatorId          String
  creator            User                     @relation(fields: [creatorId], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  upvotes            Upvote[]
  favorites          Favorite[]
  ratings            ToolRating[]
  comments           Comment[]
  customMetrics      CustomMetricDefinition[]
  metricEvents       MetricEvent[]
  sessions           ToolSession[]
  gamificationConfig GamificationConfig?
  quests             Quest[]
  documents          ToolDocument[]
  sandTransactions   SandTransaction[]
  courseLinks        CourseToolLink[]
  libraryEntries     LibraryEntry[]
  leaderboardEntries LeaderboardEntry[]
  challenges         Challenge[]
  collabRequests     CollabRequest[]
  collabSessions     CollabSession[]
  leagues            League[]
  assignments        Assignment[]

  @@index([creatorId])
  @@index([published, createdAt])
  @@index([category])
  @@index([toolType])
  @@index([approvalStatus])
  @@index([isOfficialService])
}

enum ToolType {
  EXTERNAL
  CHATBOT
  SIMULATION
  QUIZ
  AI_INTERVIEW
  DEBATE
  STUDY_BUDDY
}

enum ApprovalStatus {
  COMMUNITY
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum ArticulationRecommendation {
  APPROVE
  DENY
  NEEDS_REVIEW
}

enum ArticulationStatus {
  PENDING
  APPROVED
  DENIED
}

model ArticulationRequest {
  id                        String                    @id @default(cuid())
  studentEmail              String
  externalCourseTitle       String
  externalInstitution       String
  externalSyllabus          String                    @db.Text
  internalCourseCode        String
  internalCourseTitle       String
  internalCourseDescription String                    @db.Text
  similarityScore           Float
  reasoning                 String                    @db.Text
  recommendation            ArticulationRecommendation
  status                    ArticulationStatus        @default(PENDING)
  reviewedBy                String?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt

  @@index([studentEmail, createdAt])
  @@index([status, createdAt])
}

model Upvote {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  pinned    Boolean   @default(false)
  userId    String
  toolId    String
  parentId  String?
  user      User      @relation(fields: [userId], references: [id])
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
}

enum NotificationType {
  COMMENT_ON_TOOL
  COMMENT_REPLY
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model ToolRating {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([toolId])
}

model CustomMetricDefinition {
  id          String     @id @default(cuid())
  toolId      String
  tool        Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  name        String
  type        MetricType
  description String?
}

enum MetricType {
  COUNTER
  DURATION
  RATING
  BOOLEAN
  TEXT
}

model MetricEvent {
  id          String   @id @default(cuid())
  toolId      String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sessionId   String?
  metricName  String
  metricValue String
  createdAt   DateTime @default(now())

  @@index([toolId])
}

model ToolSession {
  id           String    @id @default(cuid())
  toolId       String
  tool         Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id])
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  messageCount Int       @default(0)
  notes        String?   @db.Text
  summary      String?   @db.Text  // AI-generated wrap-up summary (Covered / Strong / Review)
  status       String    @default("active")
  audioSessionDurationSecs Int?
  audioActivated         Boolean   @default(false)
  chatMessages ChatMessage[]
  hostedCollabSession CollabSession?     @relation("HostCollabSession")
  collabParticipant   CollabParticipant? @relation("ParticipantCollabSession")
  submission          Submission?

  @@index([toolId, startedAt])
  @@index([courseId])
}

model ChatMessage {
  id           String      @id @default(cuid())
  sessionId    String
  session      ToolSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role         String
  content      String      @db.Text
  flagged      Boolean     @default(false)
  flagCategory String?
  flagReason   String?
  tokensUsed   Int         @default(0)
  inputTokens  Int         @default(0)
  outputTokens Int         @default(0)
  createdAt    DateTime    @default(now())

  @@index([sessionId, createdAt])
  @@index([flagged, createdAt])
}

model AdminAnnouncement {
  id          String   @id @default(cuid())
  title       String
  message     String   @db.Text
  tone        String   @default("INFO")
  isActive    Boolean  @default(true)
  dismissible Boolean  @default(true)
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  createdById String
  createdBy   User     @relation("AdminAnnouncementCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive, startsAt])
  @@index([createdById, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminId     String
  admin       User     @relation("AdminAuditActor", fields: [adminId], references: [id])
  action      String
  targetType  String
  targetId    String?
  targetLabel String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([targetType, targetId, createdAt])
}

model SandcastleSubmission {
  id                String         @id @default(cuid())
  slug              String?        @unique
  title             String
  category          String
  tagline           String?
  description       String         @db.Text
  emoji             String?
  sandCost          Int            @default(0)
  systemPrompt      String         @db.Text
  starterPrompts    String[]
  approvalStatus    ApprovalStatus @default(PENDING)
  aiVerdict         String?
  aiRejectReason    String?
  aiFlags           String[]       @default([])
  creatorId         String
  creator           User           @relation("SandcastleSubmissionCreator", fields: [creatorId], references: [id])
  reviewedByAdminId String?
  reviewedByAdmin   User?          @relation("SandcastleSubmissionReviewer", fields: [reviewedByAdminId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([approvalStatus, createdAt])
  @@index([creatorId, createdAt])
}

model Bounty {
  id              String       @id @default(cuid())
  title           String
  description     String
  category        String
  difficulty      String?
  estimatedHours  Int?
  rewardSand      Int          @default(250)
  status          BountyStatus @default(OPEN)
  postedById      String
  postedBy        User         @relation("BountiesPosted", fields: [postedById], references: [id])
  claimedById     String?
  claimedBy       User?        @relation("BountiesClaimed", fields: [claimedById], references: [id])
  claimedAt       DateTime?
  fulfilledToolId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reviews         BountyReview[]
  sandTransactions SandTransaction[]
}

enum BountyStatus {
  OPEN
  CLAIMED
  FULFILLED
  CLOSED
}

model SandTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  reason      String
  description String?
  bountyId    String?
  bounty      Bounty?  @relation(fields: [bountyId], references: [id], onDelete: SetNull)
  toolId      String?
  tool        Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bountyId])
  @@index([toolId])
}

model BountyReview {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  promptUsed String?
  content    String
  createdAt  DateTime @default(now())

  @@index([bountyId, createdAt])
  @@index([reviewerId, createdAt])
}

// ── Builder ───────────────────────────────────────────────────────────────────

model BuildSession {
  id        String         @id @default(cuid())
  creatorId String
  creator   User           @relation(fields: [creatorId], references: [id])
  title     String?
  toolSpec  Json?
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  documents ToolDocument[]
}

model ToolDocument {
  id        String        @id @default(cuid())
  toolId    String?
  tool      Tool?         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sessionId String?
  session   BuildSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename  String
  content   String
  fileType  String        @default("application/pdf")
  wordCount Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([toolId])
  @@index([sessionId])
}

// ── Courses ──────────────────────────────────────────────────────────────────

model PlaygroundApp {
  id           String             @id @default(cuid())
  creatorId    String
  creator      User               @relation(fields: [creatorId], references: [id])
  title        String             @default("Untitled App")
  description  String?
  htmlContent  String             @db.Text
  publishedAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  storeEntries AppStoreEntry[]
  delegates    AppStoreDelegate[]

  @@index([creatorId, createdAt])
}

model AppStoreEntry {
  id        String        @id @default(cuid())
  appId     String
  app       PlaygroundApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  uniqueKey String?       @unique
  type      String
  bucket    String
  userId    String?
  data      Json
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([appId, type, bucket])
  @@index([appId, type, bucket, userId])
}

model AppStoreDelegate {
  id        String        @id @default(cuid())
  appId     String
  app       PlaygroundApp @relation(fields: [appId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  grantedAt DateTime      @default(now())

  @@unique([appId, userId])
  @@index([userId])
}

model Course {
  id             String           @id @default(cuid())
  courseCode     String           @unique
  title          String
  description    String?
  semester       String?          // "Spring 2026"
  enrollmentKey  String?          @unique @default(cuid())
  importSource   String?          // "catalog" | "faculty-page" | "manual" | "onboarding"
  instructorId   String
  instructor     User             @relation(fields: [instructorId], references: [id])
  isPublic       Boolean          @default(true)
  canvasCourseId String?          // Canvas LMS course ID — used for grade push
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  discussionThreads DiscussionThread[]
  materials      CourseMaterial[]
  linkedTools    CourseToolLink[]
  toolSessions   ToolSession[]
  collabSessions CollabSession[]
  objectives     LearningObjective[]
  enrollments    CourseEnrollment[]
  studentNotes   StudentNote[]
  assignments    Assignment[]
  rubrics        Rubric[]
}

model CourseMaterial {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  title        String
  content      String
  materialType String   @default("lecture")
  moduleNumber Int?
  isVisible    Boolean  @default(true)
  embeddedAt   DateTime?  // set after RAG chunks are generated
  createdAt    DateTime @default(now())
  objectives   LearningObjective[]
  readStatuses MaterialReadStatus[]
  chunks       DocumentChunk[]
}

// RAG: one record per ~512-token chunk of a CourseMaterial.
// embedding column uses pgvector; Azure AI Search replaces this when migrated.
model DocumentChunk {
  id          String         @id @default(cuid())
  materialId  String
  material    CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  courseId    String         // denormalized for fast per-course similarity search
  chunkIndex  Int
  content     String
  tokenCount  Int
  embedding   Unsupported("vector(1536)")?
  createdAt   DateTime       @default(now())

  @@index([materialId])
  @@index([courseId])
}

// A discrete learning objective extracted from course materials.
model LearningObjective {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  materialId   String?                          // Source material, if known
  material     CourseMaterial? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  title        String                           // Short label, e.g. "Define mitosis"
  description  String?                          // Fuller explanation of what mastery looks like
  moduleNumber Int?                             // Inherited from the source material
  orderIndex   Int      @default(0)             // Display order within the module
  createdAt    DateTime @default(now())
  progress     StudentObjectiveProgress[]

  @@index([courseId, moduleNumber])
}

// Tracks a student's mastery of a single learning objective.
model StudentObjectiveProgress {
  id             String   @id @default(cuid())
  studentId      String
  student        User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  objectiveId    String
  objective      LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)
  courseId       String              // Denormalised for fast per-course queries
  attempts       Int      @default(0)
  correct        Int      @default(0)
  // 'not_started' | 'struggling' | 'mastered'
  masteryLevel   String   @default("not_started")
  flaggedForReview Boolean @default(false)
  lastSeen       DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, objectiveId])
  @@index([studentId, courseId])
  @@index([objectiveId])
}

// Records that a student has joined a course (explicit enrollment).
model CourseEnrollment {
  id         String   @id @default(cuid())
  studentId  String
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  courseId   String
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt DateTime @default(now())

  @@unique([studentId, courseId])
  @@index([studentId])
  @@index([courseId])
}

// Records that a student has read a specific course material.
model MaterialReadStatus {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  materialId String
  material   CourseMaterial @relation(fields: [materialId], references: [id], onDelete: Cascade)
  readAt     DateTime @default(now())

  @@unique([userId, materialId])
}

model CourseToolLink {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  toolId       String
  tool         Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  syllabusContext String?
  weekLabel    String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([courseId, toolId])
  @@index([courseId])
  @@index([toolId])
}

model PlatformQuest {
  id           String             @id @default(cuid())
  title        String
  description  String
  cadence      QuestCadence
  xpReward     Int
  sandReward   Int
  condition    PlatformQuestType
  targetValue  Int                @default(1)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  userProgress UserPlatformQuest[]
}

enum QuestCadence {
  DAILY
  WEEKLY
}

enum PlatformQuestType {
  COMPLETE_ANY_SESSION
  COMPLETE_SESSIONS_N
  SCORE_ABOVE_THRESHOLD
  LEAVE_COMMENT
  LAUNCH_MARKETPLACE_TOOL
  COMPLETE_COURSE_TOOL
  HIGH_SCORE_N_TOOLS
}

model UserPlatformQuest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  questId       String
  quest         PlatformQuest @relation(fields: [questId], references: [id])
  periodStart   DateTime
  progress      Int           @default(0)
  completedAt   DateTime?
  rewardClaimed Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@unique([userId, questId, periodStart])
  @@index([userId, periodStart])
}

model LeaderboardEntry {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  toolId     String
  tool       Tool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  courseId   String?
  score      Float
  metricKey  String
  sessionId  String?
  achievedAt DateTime    @default(now())

  @@index([toolId, courseId])
  @@index([userId])
}

model Challenge {
  id              String          @id @default(cuid())
  challengerId    String
  challenger      User            @relation("ChallengesIssued", fields: [challengerId], references: [id])
  challengedId    String
  challenged      User            @relation("ChallengesReceived", fields: [challengedId], references: [id])
  toolId          String
  tool            Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)
  challengerScore Float
  status          ChallengeStatus @default(PENDING)
  challengedScore Float?
  createdAt       DateTime        @default(now())
  expiresAt       DateTime
  completedAt     DateTime?

  @@index([challengedId, status])
  @@index([challengerId, status])
  @@index([toolId])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  EXPIRED
}

model LibraryEntry {
  id      String   @id @default(cuid())
  userId  String
  toolId  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool    Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  posts     DiscussionPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, createdAt])
}

model DiscussionPost {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   DiscussionPost[] @relation("PostReplies")
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model CollabRequest {
  id          String        @id @default(cuid())
  toolId      String
  tool        Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation("CollabRequests", fields: [requesterId], references: [id])
  message     String
  status      CollabStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviews     CollabReview[]

  @@index([status, createdAt])
  @@index([requesterId])
}

// ── Portfolio ────────────────────────────────────────────────────────────────

model PortfolioItem {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         PortfolioType
  title        String
  organization String?       // Company, University, or Course Name
  startDate    DateTime?
  endDate      DateTime?
  description  String?       @db.Text
  skills       String[]
  url          String?
  isVerified   Boolean       @default(false) // True if generated from Sandbox activity
  metadata     Json?         // Store raw tool stats or AI summary
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([type])
}

enum PortfolioType {
  EDUCATION
  EXPERIENCE
  PROJECT
  PUBLICATION
  CERTIFICATION
  SKILL
  AWARD
}

model CollabReview {
  id              String        @id @default(cuid())
  requestId       String
  request         CollabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User          @relation("CollabReviews", fields: [reviewerId], references: [id])
  transcript      String?
  summary         String?
  rating          Int?
  aiGuidedAnswers Json?
  createdAt       DateTime      @default(now())
}

enum CollabStatus {
  OPEN
  CLOSED
}

// ── Messaging system ──────────────────────────────────────────────────────────

model Conversation {
  id            String                    @id @default(cuid())
  title         String?                   // Optional title for group chats
  isGroup       Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime                  @default(now()) // Critical for sorting inbox
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // ADMIN, MEMBER
  
  // "Blue Dot" logic: If conversation.lastMessageAt > this.lastReadAt, show unread dot
  lastReadAt     DateTime?    
  joinedAt       DateTime     @default(now())

  @@id([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model UserContact {
  id        String   @id @default(cuid())
  userId    String   // The user granting permission (The "User" in "Contact Me" list)
  user      User     @relation("UserPermittedContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactId String   // The user being added (The "Member" who can see the status)
  contact   User     @relation("UserContacts", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
}

