model CollabParticipant {
  id              String        @id @default(cuid())
  collabSessionId String
  collabSession   CollabSession @relation(fields: [collabSessionId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  toolSessionId   String?       @unique
  toolSession     ToolSession?  @relation("ParticipantCollabSession", fields: [toolSessionId], references: [id])
  messageCount    Int           @default(0)
  joinedAt        DateTime      @default(now())
  leftAt          DateTime?
  isActive        Boolean       @default(true)
  turnOrder       Int?
  xpAwarded       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@unique([collabSessionId, userId])
  @@index([collabSessionId, isActive])
  @@index([userId])
}

model CollabMessage {
  id                     String            @id @default(cuid())
  collabSessionId        String
  collabSession          CollabSession     @relation(fields: [collabSessionId], references: [id], onDelete: Cascade)
  senderId               String?
  sender                 User?             @relation(fields: [senderId], references: [id])
  role                   CollabMessageRole
  content                String            @db.Text
  turnNumber             Int?
  triggeredArtifactUpdate Boolean          @default(false)
  clientMessageId        String?
  createdAt              DateTime          @default(now())

  @@index([collabSessionId, createdAt])
  @@index([senderId])
  @@index([collabSessionId, clientMessageId])
}

enum CollabMode {
  CO_PRESENCE
  TURN_BASED
  ARTIFACT_BUILDER
  COLLABORATIVE_QUEST
}

enum CollabSessionStatus {
  WAITING
  ACTIVE
  ENDED
  EXPIRED
}

enum CollabMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// ─── NCAA Bracket Challenge ───────────────────────────────────────────────────

model League {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  kind          LeagueKind
  status        LeagueStatus  @default(DRAFT)
  joinCode      String        @unique
  creatorId     String
  creator       User          @relation("LeagueCreator", fields: [creatorId], references: [id])
  toolId        String?
  tool          Tool?         @relation(fields: [toolId], references: [id], onDelete: SetNull)
  visibility    String        @default("PRIVATE")
  cadence       LeagueCadence
  timezone      String        @default("America/New_York")
  startsAt      DateTime?
  endsAt        DateTime?
  nextDigestAt  DateTime?
  scoringMetric String        @default("score")
  configJson    Json
  members       LeagueMember[]
  cycles        LeagueCycle[]
  submissions   LeagueSubmission[]
  standings     LeagueStanding[]
  emailSubs     LeagueEmailSub[]
  events        LeagueEvent[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([kind, status])
  @@index([creatorId, createdAt])
}

model LeagueMember {
  id           String           @id @default(cuid())
  leagueId     String
  league       League           @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         LeagueMemberRole @default(MEMBER)
  status       String           @default("ACTIVE")
  joinedAt     DateTime         @default(now())
  lastActiveAt DateTime?
  statsJson    Json?
  submissions  LeagueSubmission[]
  standings    LeagueStanding[]

  @@unique([leagueId, userId])
  @@index([userId])
}

model LeagueCycle {
  id          String            @id @default(cuid())
  leagueId    String
  league      League            @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  cycleNumber Int
  label       String
  status      LeagueCycleStatus @default(OPEN)
  opensAt     DateTime
  locksAt     DateTime?
  closesAt    DateTime
  resolvedAt  DateTime?
  stateJson   Json
  summaryJson Json?
  submissions LeagueSubmission[]
  events      LeagueEvent[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@unique([leagueId, cycleNumber])
  @@index([leagueId, status, opensAt])
}

model LeagueSubmission {
  id          String       @id @default(cuid())
  leagueId    String
  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  cycleId     String
  cycle       LeagueCycle  @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  memberId    String
  member      LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  status      String       @default("SUBMITTED")
  payloadJson Json
  scoreDelta  Float        @default(0)
  tiebreaker  Float?
  submittedAt DateTime     @default(now())
  resolvedAt  DateTime?

  @@unique([cycleId, memberId])
  @@index([leagueId, submittedAt])
}

model LeagueStanding {
  id           String       @id @default(cuid())
  leagueId     String
  league       League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  memberId     String
  member       LeagueMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  score        Float        @default(0)
  rank         Int?
  wins         Int          @default(0)
  losses       Int          @default(0)
  streak       Int          @default(0)
  lastDelta    Float        @default(0)
  metadataJson Json?
  updatedAt    DateTime     @updatedAt

  @@unique([leagueId, memberId])
  @@index([leagueId, rank])
}

model LeagueEmailSub {
  id        String   @id @default(cuid())
  leagueId  String
  league    League   @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([leagueId, userId])
}

model LeagueEvent {
  id          String       @id @default(cuid())
  leagueId    String
  league      League       @relation(fields: [leagueId], references: [id], onDelete: Cascade)
  cycleId     String?
  cycle       LeagueCycle? @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?        @relation("LeagueEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  type        String
  message     String
  payloadJson Json?
  createdAt   DateTime     @default(now())

  @@index([leagueId, createdAt])
  @@index([cycleId, createdAt])
}

enum LeagueKind {
  PREDICTION_MARKET
  SURVIVOR_POOL
  COFFEE_ROULETTE
  WEEKLY_TRIVIA
  PITCH_COMPETITION
  MEETING_BINGO
  SECRET_SANTA
  FANTASY_TRADING
}

enum LeagueStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum LeagueCadence {
  ONE_OFF
  WEEKLY
  SEASONAL
}

enum LeagueCycleStatus {
  OPEN
  LOCKED
  CLOSED
  RESOLVED
}

enum LeagueMemberRole {
  OWNER
  ADMIN
  MEMBER
  JUDGE
}

model BracketPool {
  id          String            @id @default(cuid())
  name        String
  joinCode    String            @unique
  creatorId   String
  creator     User              @relation("BracketPoolsCreated", fields: [creatorId], references: [id])
  year        Int               @default(2026)
  locked      Boolean           @default(false)
  lockedAt    DateTime?
  scoringType String            @default("standard")
  entries     BracketEntry[]
  games       BracketGame[]
  emailSubs   BracketEmailSub[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model BracketEntry {
