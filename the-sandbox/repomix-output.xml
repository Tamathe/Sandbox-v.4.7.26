function scoreColor(score: number) {
  if (score >= 88) return 'text-green-700 bg-green-50'
  if (score >= 80) return 'text-blue-700 bg-blue-50'
  if (score >= 70) return 'text-amber-700 bg-amber-50'
  return 'text-red-700 bg-red-50'
}

