import { NextRequest, NextResponse } from 'next/server'
import { estimateHaikuCostUsd } from '../../lib/admin-control-tower'
import { prisma } from '../../lib/prisma'
import { redis } from '../../lib/redis'
import { requireAdminUser, isAuthFailure } from '../../lib/server-auth'

function settled<T>(result: PromiseSettledResult<T>, fallback: T): T {
  return result.status === 'fulfilled' ? result.value : fallback
}

function getMonthStart(date = new Date()) {
  return new Date(date.getFullYear(), date.getMonth(), 1)
}

// Cache key for economics — keyed by YYYY-MM so it auto-refreshes each month.
function economicsCacheKey(monthStart: Date) {
  return `admin:economics:${monthStart.toISOString().slice(0, 7)}`
}

export async function GET(req: NextRequest) {
  try {
    const auth = await requireAdminUser(req)
    if (isAuthFailure(auth)) return auth.response

    const monthStart = getMonthStart()
    const page = Math.max(1, Number(req.nextUrl.searchParams.get('page') ?? '1'))
    const pageSize = 50
    const toolsOffset = (page - 1) * pageSize

    const results = await Promise.allSettled([
      // 0: summary counts
      prisma.tool.count({ where: { published: true, approvalStatus: { not: 'SUSPENDED' } } }),
      prisma.toolSession.count(),
      prisma.user.count(),
      prisma.upvote.count(),

      // 4: recent tools (last 5)
      prisma.tool.findMany({
        where: { published: true, approvalStatus: { notIn: ['REJECTED', 'SUSPENDED'] } },
        orderBy: { createdAt: 'desc' },
        take: 5,
        include: {
          creator: true,
          _count: { select: { upvotes: true, favorites: true, comments: true, sessions: true } },
        },
      }),

      // 5: top creators
      prisma.user.findMany({
        orderBy: { tools: { _count: 'desc' } },
        take: 5,
        include: { _count: { select: { tools: true } } },
      }),

      // 6: ALL tools — paginated (was unbounded)
      prisma.tool.findMany({
        orderBy: { createdAt: 'desc' },
        take: pageSize,
        skip: toolsOffset,
        include: {
          creator: true,
          _count: { select: { upvotes: true, favorites: true, comments: true, sessions: true } },
        },
      }),

      // 7: total tool count for pagination
      prisma.tool.count(),

      // 8: service bots
      prisma.tool.findMany({
        where: { isOfficialService: true },
        orderBy: { createdAt: 'desc' },
        include: {
          creator: true,
          _count: { select: { upvotes: true, favorites: true, comments: true, sessions: true } },
        },
      }),

      // 9: pending tools
      prisma.tool.findMany({
        where: { approvalStatus: 'PENDING' },
        orderBy: { createdAt: 'desc' },
        include: {
          creator: true,
          _count: { select: { upvotes: true, favorites: true, comments: true, sessions: true } },
        },
      }),

      // 10: flagged sessions
      prisma.toolSession.findMany({
        where: { chatMessages: { some: { flagged: true } } },
        orderBy: { startedAt: 'desc' },
        take: 10,
        include: {
          user: { select: { id: true, name: true, email: true } },
          tool: { select: { id: true, name: true, category: true, isOfficialService: true } },
          chatMessages: {
            where: { flagged: true },
            orderBy: { createdAt: 'desc' },
            take: 1,
            select: {
              id: true,
              role: true,
              content: true,
              flagCategory: true,
              flagReason: true,
              createdAt: true,
            },
          },
        },
      }),

      // 11: recent announcements
      prisma.adminAnnouncement.findMany({
        orderBy: { createdAt: 'desc' },
        take: 5,
        include: {
          createdBy: { select: { id: true, name: true, email: true } },
        },
      }),

      // 12: sandcastle queue
      prisma.sandcastleSubmission.findMany({
        where: { approvalStatus: 'PENDING' },
        orderBy: { createdAt: 'desc' },
        take: 10,
        include: {
          creator: { select: { id: true, name: true, email: true } },
        },
      }),

      // 13: audit log
      prisma.adminAuditLog.findMany({
        orderBy: { createdAt: 'desc' },
        take: 12,
        include: {
          admin: { select: { id: true, name: true, email: true } },
        },
      }),

      // 14: service bot samples
      prisma.toolSession.findMany({
        where: { tool: { isOfficialService: true } },
        orderBy: { startedAt: 'desc' },
        take: 6,
        include: {
          user: { select: { id: true, name: true, email: true } },
          tool: { select: { id: true, name: true, serviceProtocol: true } },
          chatMessages: {
            orderBy: { createdAt: 'desc' },
            take: 2,
            select: { id: true, role: true, content: true, createdAt: true },
          },
        },
      }),
    ])

    const [
      totalTools,
      totalSessions,
      totalUsers,
      totalUpvotes,
      recentTools,
      topCreators,
      allTools,
      totalToolCount,
      serviceBots,
      pendingTools,
      flaggedSessions,
      recentAnnouncements,
      sandcastleQueue,
      auditLog,
      serviceBotSamples,
    ] = [
      settled(results[0], 0),
      settled(results[1], 0),
      settled(results[2], 0),
      settled(results[3], 0),
      settled(results[4], []),
      settled(results[5], []),
      settled(results[6], []),
      settled(results[7], 0),
      settled(results[8], []),
      settled(results[9], []),
      settled(results[10], []),
      settled(results[11], []),
      settled(results[12], []),
      settled(results[13], []),
      settled(results[14], []),
    ]

    // ── Economics: Redis-cached, computed with DB-level aggregation ────────────
    const cacheKey = economicsCacheKey(monthStart)
    const ECONOMICS_TTL_SECONDS = 300 // 5 minutes

    let economics: unknown = null

    if (redis) {
      economics = await redis.get(cacheKey).catch(() => null)
    }

    if (!economics) {
      economics = await computeEconomics(monthStart)
      if (redis) {
        redis.set(cacheKey, JSON.stringify(economics), { ex: ECONOMICS_TTL_SECONDS }).catch(() => {})
      }
    } else if (typeof economics === 'string') {
      try { economics = JSON.parse(economics) } catch { economics = await computeEconomics(monthStart) }
    }

    return NextResponse.json({
      totalTools,
      totalSessions,
      totalUsers,
      totalUpvotes,
      recentTools,
      topCreators,
      allTools,
      allToolsPagination: { page, pageSize, total: totalToolCount },
      serviceBots,
      pendingTools,
      flaggedSessions,
      recentAnnouncements,
      sandcastleQueue,
      auditLog,
      serviceBotSamples,
      economics,
    })
  } catch (error) {
    console.error('GET /api/admin error:', error)
    return NextResponse.json({ error: 'Failed to fetch admin stats' }, { status: 500 })
  }
}

// ── Economics helper ───────────────────────────────────────────────────────────

async function computeEconomics(monthStart: Date) {
  // Group token usage by session at the DB level — no full table scan in JS.
  type GroupRow = {
    sessionId: string
    inputTokens: number
    outputTokens: number
    tokensUsed: number
  }

  const grouped = await prisma.$queryRaw<GroupRow[]>`
    SELECT
      "sessionId",
      COALESCE(SUM("inputTokens"), 0)::int  AS "inputTokens",
      COALESCE(SUM("outputTokens"), 0)::int AS "outputTokens",
      COALESCE(SUM("tokensUsed"), 0)::int   AS "tokensUsed"
    FROM "ChatMessage"
    WHERE "createdAt" >= ${monthStart}
      AND "role" = 'assistant'
    GROUP BY "sessionId"
  `

  // Fetch just the sessions we need (ids from grouped result).
  const sessionIds = grouped.map((r) => r.sessionId)
  const sessions =
    sessionIds.length === 0
      ? []
      : await prisma.toolSession.findMany({
          where: { id: { in: sessionIds } },
          select: {
            id: true,
            tool: { select: { id: true, name: true } },
            user: { select: { id: true, name: true, email: true } },
          },
        })

  const sessionMap = new Map(sessions.map((s) => [s.id, s]))

  const toolMap = new Map<string, { toolId: string; toolName: string; inputTokens: number; outputTokens: number; tokensUsed: number }>()
  const userMap = new Map<string, { userId: string; userName: string; userEmail: string; inputTokens: number; outputTokens: number; tokensUsed: number }>()
  let totalInput = 0, totalOutput = 0, totalTokens = 0

  for (const row of grouped) {
    totalInput += row.inputTokens
    totalOutput += row.outputTokens
    totalTokens += row.tokensUsed

    const session = sessionMap.get(row.sessionId)
    if (!session) continue

    if (session.tool) {
      const entry = toolMap.get(session.tool.id) ?? { toolId: session.tool.id, toolName: session.tool.name, inputTokens: 0, outputTokens: 0, tokensUsed: 0 }
      entry.inputTokens += row.inputTokens
      entry.outputTokens += row.outputTokens
      entry.tokensUsed += row.tokensUsed
      toolMap.set(session.tool.id, entry)
    }

    if (session.user) {
      const entry = userMap.get(session.user.id) ?? { userId: session.user.id, userName: session.user.name, userEmail: session.user.email, inputTokens: 0, outputTokens: 0, tokensUsed: 0 }
      entry.inputTokens += row.inputTokens
      entry.outputTokens += row.outputTokens
      entry.tokensUsed += row.tokensUsed
      userMap.set(session.user.id, entry)
    }
  }

  return {
    monthStart,
    totalInputTokens: totalInput,
    totalOutputTokens: totalOutput,
    totalTokens,
    totalEstimatedCostUsd: estimateHaikuCostUsd(totalInput, totalOutput),
    topTools: [...toolMap.values()]
      .sort((a, b) => b.tokensUsed - a.tokensUsed)
      .slice(0, 10)
      .map((entry) => ({ ...entry, estimatedCostUsd: estimateHaikuCostUsd(entry.inputTokens, entry.outputTokens) })),
    topUsers: [...userMap.values()]
      .sort((a, b) => b.tokensUsed - a.tokensUsed)
      .slice(0, 10)
      .map((entry) => ({ ...entry, estimatedCostUsd: estimateHaikuCostUsd(entry.inputTokens, entry.outputTokens) })),
  }
}
</file>

