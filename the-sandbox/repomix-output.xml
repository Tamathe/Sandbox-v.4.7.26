<file path="app/tools/uk-now/page.tsx">
'use client'

import { useEffect, useState, useCallback } from 'react'
import { formatDistanceToNow } from 'date-fns'
import { RefreshCw, ExternalLink, Tag, Loader2, AlertCircle } from 'lucide-react'

type Article = {
  id: string
  title: string
  url: string
  summaryAi: string | null
  tags: string[]
  category: string | null
  thumbnailUrl: string | null
  publishedAt: string
  outletName: string | null
  source: { name: string; category: string | null }
}

const CATEGORIES = ['All', 'Research', 'Athletics', 'HealthCare', 'Campus Life', 'Arts', 'Administration', 'General']

function ArticleCard({ article }: { article: Article; onTagClick?: (tag: string) => void }) {
  return (
    <a
      href={article.url}
      target="_blank"
      rel="noopener noreferrer"
      className="group flex flex-col overflow-hidden rounded-2xl border border-gray-200 bg-white transition hover:shadow-md hover:border-[#0033A0]/30"
    >
      <div className="relative h-44 w-full overflow-hidden bg-[#0033A0]/10 flex items-center justify-center">
        {article.thumbnailUrl ? (
          // eslint-disable-next-line @next/next/no-img-element
          <img
            src={article.thumbnailUrl}
            alt={article.title}
            className="h-full w-full object-cover"
            onError={(e) => {
              ;(e.target as HTMLImageElement).style.display = 'none'
            }}
          />
        ) : (
          <div className="flex items-center justify-center text-[#0033A0]/30">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm-1-4h2v2h-2zm0-8h2v6h-2z" />
            </svg>
          </div>
        )}
        {article.source?.name ? (
          <span className="absolute top-2 left-2 rounded-full bg-[#0033A0] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow">
            {article.source.name}
          </span>
        ) : null}
      </div>

      <div className="flex flex-1 flex-col p-4">
        <h3 className="mb-2 line-clamp-2 text-sm font-bold leading-snug text-slate-900 group-hover:text-[#0033A0]">
          {article.title}
        </h3>
        {article.summaryAi ? (
          <p className="mb-3 line-clamp-3 text-xs leading-relaxed text-slate-500">{article.summaryAi}</p>
        ) : null}

        {article.tags.length > 0 ? (
          <div className="mb-3 flex flex-wrap gap-1">
            {article.tags.slice(0, 3).map((tag) => (
              <span
                key={tag}
