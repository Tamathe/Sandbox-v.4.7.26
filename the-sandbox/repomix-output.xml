                  >
                    <div className="flex items-center justify-between">
                      <Icon className="h-5 w-5 opacity-70" />
                      <span className="text-2xl font-bold">{card.value}</span>
                    </div>
                    <p className="text-xs font-medium leading-tight">{card.label}</p>
