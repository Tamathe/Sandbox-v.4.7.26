                  <p className="mt-0.5 text-sm text-blue-200">Today at Kentucky</p>
                </div>
              </div>
            </div>
            <div className="flex items-center gap-3 text-sm text-blue-200">
              {lastUpdated ? (
                <span>Updated {formatDistanceToNow(lastUpdated, { addSuffix: true })}</span>
              ) : null}
              <button
                type="button"
