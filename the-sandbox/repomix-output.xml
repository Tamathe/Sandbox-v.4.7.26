  | 'CO_PRESENCE'
  | 'TURN_BASED'
  | 'ARTIFACT_BUILDER'
  | 'COLLABORATIVE_QUEST'

export type CollabMessageRoleValue = 'user' | 'assistant' | 'system'

export interface CollabParticipantSummary {
