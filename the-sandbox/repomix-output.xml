type DateRange = '1' | '7' | '30' | '90'

type Article = {
  id: string
  title: string
  url: string
  summaryAi: string | null
  tags: string[]
  category: string | null
  sentiment: 'POSITIVE' | 'NEUTRAL' | 'NEGATIVE' | null
  sentimentScore: number | null
  outletName: string | null
  outletCity: string | null
  outletState: string | null
  publishedAt: string
}

type StatsData = {
  sentimentBreakdown: { POSITIVE: number; NEUTRAL: number; NEGATIVE: number }
  topTags: { tag: string; count: number }[]
  coverageByOutlet: { outlet: string; city: string | null; state: string | null; count: number; sentiment: string }[]
  spike: boolean
  totalArticles: number
  last24hCount: number
}

const SENTIMENT_STYLES = {
  POSITIVE: 'bg-emerald-100 text-emerald-700',
  NEUTRAL: 'bg-slate-100 text-slate-600',
  NEGATIVE: 'bg-red-100 text-red-700',
}

const SENTIMENT_LABELS = {
  POSITIVE: 'Positive',
  NEUTRAL: 'Neutral',
  NEGATIVE: 'Negative',
}

function SentimentBadge({ sentiment }: { sentiment: 'POSITIVE' | 'NEUTRAL' | 'NEGATIVE' | null }) {
  if (!sentiment) return null
  return (
    <span className={`rounded-full px-2.5 py-0.5 text-xs font-semibold ${SENTIMENT_STYLES[sentiment]}`}>
      {SENTIMENT_LABELS[sentiment]}
    </span>
  )
}

export default function UKInTheNewsPage() {
  const [articles, setArticles] = useState<Article[]>([])
  const [stats, setStats] = useState<StatsData | null>(null)
  const [loading, setLoading] = useState(true)
  const [loadingMore, setLoadingMore] = useState(false)
  const [error, setError] = useState<string | null>(null)
  const [dateRange, setDateRange] = useState<DateRange>('7')
  const [sentimentFilter, setSentimentFilter] = useState<'POSITIVE' | 'NEUTRAL' | 'NEGATIVE' | null>(null)
  const [activeTag, setActiveTag] = useState<string | null>(null)
  const [page, setPage] = useState(1)
  const [hasMore, setHasMore] = useState(false)

  const fetchArticles = useCallback(async (
    days: DateRange,
    sentiment: 'POSITIVE' | 'NEUTRAL' | 'NEGATIVE' | null,
    tag: string | null,
    pg: number,
    append = false
  ) => {
    if (pg === 1) setLoading(true)
    else setLoadingMore(true)

    try {
      const params = new URLSearchParams({
        type: 'EXTERNAL',
        page: String(pg),
        limit: '20',
        days,
      })
      if (sentiment) params.set('sentiment', sentiment)
      if (tag) params.set('tag', tag)

      const [articlesRes, statsRes] = await Promise.all([
        fetch(`/api/news/articles?${params.toString()}`),
        pg === 1 ? fetch('/api/news/stats') : Promise.resolve(null),
      ])

      if (!articlesRes.ok) throw new Error('Failed to fetch articles')
      const data = await articlesRes.json() as { articles: Article[]; hasMore: boolean }

      if (append) {
        setArticles((prev) => [...prev, ...data.articles])
      } else {
        setArticles(data.articles)
      }
      setHasMore(data.hasMore)

      if (statsRes?.ok) {
        const statsData = await statsRes.json() as StatsData
        setStats(statsData)
      }
    } catch {
      setError('Failed to load news coverage.')
    } finally {
      setLoading(false)
      setLoadingMore(false)
    }
  }, [])

  useEffect(() => {
    setPage(1)
    void fetchArticles(dateRange, sentimentFilter, activeTag, 1, false)
  }, [dateRange, sentimentFilter, activeTag, fetchArticles])

  const handleLoadMore = async () => {
    const nextPage = page + 1
    setPage(nextPage)
    await fetchArticles(dateRange, sentimentFilter, activeTag, nextPage, true)
  }

  // Build map markers from coverage data
  const mapMarkers = (stats?.coverageByOutlet ?? [])
    .filter((o) => o.city && CITY_COORDS[o.city])
    .map((o) => ({
      ...o,
      coords: CITY_COORDS[o.city!] as [number, number],
    }))

  const sentimentTotal = stats
    ? stats.sentimentBreakdown.POSITIVE + stats.sentimentBreakdown.NEUTRAL + stats.sentimentBreakdown.NEGATIVE
    : 0
  const positivePercent = sentimentTotal > 0 ? (stats!.sentimentBreakdown.POSITIVE / sentimentTotal) * 100 : 0
  const neutralPercent = sentimentTotal > 0 ? (stats!.sentimentBreakdown.NEUTRAL / sentimentTotal) * 100 : 0
  const negativePercent = sentimentTotal > 0 ? (stats!.sentimentBreakdown.NEGATIVE / sentimentTotal) * 100 : 0

  return (
    <div className="min-h-screen bg-slate-50">
      {/* Header */}
      <div className="bg-[#0033A0] text-white">
        <div className="mx-auto max-w-7xl px-4 py-8 sm:px-6">
          <div className="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
            <div>
              <div className="flex items-center gap-3">
                <div className="flex h-10 w-10 items-center justify-center rounded-xl bg-white/20">
                  <TrendingUp className="h-5 w-5 text-white" />
                </div>
                <div>
                  <h1 className="text-3xl font-extrabold tracking-tight">UK in the News</h1>
                  <p className="mt-0.5 text-sm text-blue-200">External media coverage of the University of Kentucky</p>
                </div>
              </div>
            </div>
            {/* Date range selector */}
            <div className="flex gap-2">
              {(['1', '7', '30', '90'] as DateRange[]).map((d) => (
                <button
                  key={d}
                  type="button"
                  onClick={() => setDateRange(d)}
                  className={`rounded-xl px-3 py-1.5 text-sm font-semibold transition ${
                    dateRange === d ? 'bg-white text-[#0033A0]' : 'bg-white/20 text-white hover:bg-white/30'
                  }`}
                >
                  {d === '1' ? 'Last 24h' : `${d}d`}
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <div className="mx-auto max-w-7xl px-4 py-6 sm:px-6">
        {/* Spike alert */}
        {stats?.spike ? (
          <div className="mb-4 flex items-center gap-3 rounded-2xl border border-amber-200 bg-amber-50 p-4">
            <AlertTriangle className="h-5 w-5 shrink-0 text-amber-600" />
            <div>
              <p className="font-semibold text-amber-900">Coverage Spike Detected</p>
              <p className="text-sm text-amber-700">Article volume in the last 24 hours is significantly higher than the 7-day average.</p>
            </div>
          </div>
        ) : null}

        {error ? (
          <div className="flex items-center gap-3 rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-700">
            <AlertCircle className="h-5 w-5 shrink-0" />
            {error}
          </div>
        ) : loading ? (
          <div className="flex min-h-[40vh] items-center justify-center">
            <Loader2 className="h-8 w-8 animate-spin text-[#0033A0]" />
          </div>
        ) : (
          <>
            {/* Map + Coverage by outlet */}
            {stats ? (
              <div className="mb-6 grid gap-4 lg:grid-cols-2">
                {/* Map */}
                <div className="overflow-hidden rounded-3xl border border-gray-200 bg-white p-4">
                  <h2 className="mb-3 text-sm font-bold text-slate-700">Coverage Geography</h2>
                  <div className="relative">
                    <ComposableMap
                      projection="geoAlbersUsa"
                      projectionConfig={{ scale: 800 }}
                      style={{ width: '100%', height: 'auto' }}
                    >
                      <Geographies geography={US_TOPO}>
                        {({ geographies }: { geographies: { rsmKey: string }[] }) =>
                          geographies.map((geo) => (
                            <Geography
                              key={geo.rsmKey}
                              // eslint-disable-next-line @typescript-eslint/no-explicit-any
                              geography={geo as any}
                              fill="#E8ECF5"
                              stroke="#C8D2E8"
                              strokeWidth={0.5}
                            />
                          ))
                        }
                      </Geographies>
                      {mapMarkers.map((marker) => (
                        <Marker key={marker.outlet} coordinates={marker.coords}>
                          <circle
                            r={Math.min(12, Math.max(4, marker.count * 2))}
                            fill={
                              marker.sentiment === 'POSITIVE' ? '#10b981' :
                              marker.sentiment === 'NEGATIVE' ? '#ef4444' : '#6b7280'
                            }
                            fillOpacity={0.8}
                            stroke="white"
                            strokeWidth={1}
                          />
                          <title>{marker.outlet}: {marker.count} articles</title>
                        </Marker>
                      ))}
                    </ComposableMap>
                    {mapMarkers.length === 0 ? (
                      <div className="absolute inset-0 flex items-center justify-center">
                        <p className="text-xs text-slate-400">No mapped locations yet</p>
                      </div>
                    ) : null}
                  </div>
                  <div className="mt-2 flex items-center gap-4 text-xs text-slate-500">
                    <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-emerald-500 inline-block" /> Positive</span>
                    <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-slate-400 inline-block" /> Neutral</span>
                    <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-red-500 inline-block" /> Negative</span>
                  </div>
                </div>

                {/* Coverage by outlet */}
                <div className="overflow-hidden rounded-3xl border border-gray-200 bg-white p-4">
                  <h2 className="mb-3 text-sm font-bold text-slate-700">Coverage by Outlet</h2>
                  <div className="space-y-2 max-h-64 overflow-y-auto">
                    {stats.coverageByOutlet.length === 0 ? (
                      <p className="text-sm text-slate-400">No external coverage yet.</p>
                    ) : stats.coverageByOutlet.map((outlet) => (
                      <div key={outlet.outlet} className="flex items-center gap-3">
                        <div className="min-w-0 flex-1">
                          <div className="flex items-center gap-2">
                            <span className="truncate text-xs font-semibold text-slate-800">{outlet.outlet}</span>
                            {outlet.city ? <span className="text-xs text-slate-400">{outlet.city}{outlet.state ? `, ${outlet.state}` : ''}</span> : null}
                          </div>
                          <div className="mt-0.5 h-1.5 w-full overflow-hidden rounded-full bg-slate-100">
                            <div
                              className={`h-full rounded-full ${
                                outlet.sentiment === 'POSITIVE' ? 'bg-emerald-500' :
                                outlet.sentiment === 'NEGATIVE' ? 'bg-red-500' : 'bg-slate-400'
                              }`}
                              style={{ width: `${Math.min(100, (outlet.count / (stats.coverageByOutlet[0]?.count ?? 1)) * 100)}%` }}
                            />
                          </div>
                        </div>
                        <span className="shrink-0 text-xs font-bold text-slate-600">{outlet.count}</span>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            ) : null}

            {/* Sentiment bar + top tags */}
            {stats && sentimentTotal > 0 ? (
              <div className="mb-6 rounded-3xl border border-gray-200 bg-white p-5">
                <h2 className="mb-3 text-sm font-bold text-slate-700">Overall Sentiment</h2>
                <div className="flex h-5 w-full overflow-hidden rounded-full">
                  {positivePercent > 0 ? (
                    <div
                      className="flex items-center justify-center bg-emerald-500 text-[10px] font-bold text-white"
                      style={{ width: `${positivePercent}%` }}
                    >
                      {positivePercent > 10 ? `${Math.round(positivePercent)}%` : ''}
                    </div>
                  ) : null}
                  {neutralPercent > 0 ? (
                    <div
                      className="flex items-center justify-center bg-slate-400 text-[10px] font-bold text-white"
                      style={{ width: `${neutralPercent}%` }}
                    >
                      {neutralPercent > 10 ? `${Math.round(neutralPercent)}%` : ''}
                    </div>
                  ) : null}
                  {negativePercent > 0 ? (
                    <div
                      className="flex items-center justify-center bg-red-500 text-[10px] font-bold text-white"
                      style={{ width: `${negativePercent}%` }}
                    >
                      {negativePercent > 10 ? `${Math.round(negativePercent)}%` : ''}
                    </div>
                  ) : null}
                </div>
                <div className="mt-2 flex gap-4 text-xs text-slate-500">
                  <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-emerald-500 inline-block" /> {stats.sentimentBreakdown.POSITIVE} positive</span>
                  <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-slate-400 inline-block" /> {stats.sentimentBreakdown.NEUTRAL} neutral</span>
                  <span className="flex items-center gap-1"><span className="h-2 w-2 rounded-full bg-red-500 inline-block" /> {stats.sentimentBreakdown.NEGATIVE} negative</span>
                </div>

                {/* Top tags */}
                {stats.topTags.length > 0 ? (
                  <div className="mt-4">
                    <h3 className="mb-2 text-xs font-semibold text-slate-500 uppercase tracking-wider">Top Topics</h3>
                    <div className="flex flex-wrap gap-1.5">
                      {stats.topTags.slice(0, 15).map(({ tag, count }) => (
                        <button
                          key={tag}
                          type="button"
                          onClick={() => setActiveTag(activeTag === tag ? null : tag)}
                          className={`rounded-full px-2.5 py-1 text-xs font-semibold transition ${
                            activeTag === tag
                              ? 'bg-[#0033A0] text-white'
                              : 'bg-blue-50 text-blue-700 hover:bg-blue-100'
                          }`}
                        >
                          {tag} <span className="opacity-60">({count})</span>
                        </button>
                      ))}
                    </div>
                  </div>
                ) : null}
              </div>
            ) : null}

            {/* Sentiment filter */}
            <div className="mb-4 flex flex-wrap items-center gap-2">
              <span className="text-sm font-semibold text-slate-600">Filter by sentiment:</span>
              {([null, 'POSITIVE', 'NEUTRAL', 'NEGATIVE'] as const).map((s) => (
                <button
                  key={s ?? 'all'}
                  type="button"
                  onClick={() => setSentimentFilter(s)}
                  className={`rounded-full px-3 py-1 text-sm font-semibold transition ${
                    sentimentFilter === s
                      ? 'bg-[#0033A0] text-white'
                      : 'bg-white border border-gray-200 text-slate-600 hover:border-[#0033A0]/50'
                  }`}
                >
                  {s === null ? 'All' : SENTIMENT_LABELS[s]}
                </button>
              ))}
            </div>

            {/* Articles feed */}
            {articles.length === 0 ? (
              <div className="flex min-h-[20vh] items-center justify-center rounded-3xl border border-gray-200 bg-white p-12">
                <div className="text-center text-slate-400">
                  <p className="font-semibold">No external coverage found</p>
                  <p className="mt-1 text-sm">Try a wider date range or trigger a news fetch from the admin panel.</p>
                </div>
              </div>
            ) : (
              <div className="space-y-3">
                {articles.map((article) => (
                  <a
                    key={article.id}
                    href={article.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    className="group flex flex-col gap-3 overflow-hidden rounded-2xl border border-gray-200 bg-white p-4 transition hover:shadow-md hover:border-[#0033A0]/30 sm:flex-row"
                  >
                    <div className="min-w-0 flex-1">
                      <div className="mb-1 flex flex-wrap items-center gap-2">
                        {article.outletName ? (
                          <span className="text-xs font-bold text-[#0033A0]">{article.outletName}</span>
                        ) : null}
                        {(article.outletCity ?? article.outletState) ? (
                          <span className="text-xs text-slate-400">
                            {[article.outletCity, article.outletState].filter(Boolean).join(', ')}
                          </span>
                        ) : null}
                        <SentimentBadge sentiment={article.sentiment} />
                      </div>
                      <h3 className="mb-1 text-sm font-bold text-slate-900 group-hover:text-[#0033A0] line-clamp-2">
                        {article.title}
                      </h3>
                      {article.summaryAi ? (
                        <p className="text-xs leading-relaxed text-slate-500 line-clamp-2">{article.summaryAi}</p>
                      ) : null}
                    </div>
                    <div className="flex shrink-0 flex-col items-end justify-between gap-2 sm:text-right">
                      <span className="text-xs text-slate-400">
                        {formatDistanceToNow(new Date(article.publishedAt), { addSuffix: true })}
                      </span>
                      <span className="flex items-center gap-1 text-xs font-semibold text-[#0033A0]">
                        Read <ExternalLink className="h-3 w-3" />
                      </span>
                    </div>
                  </a>
                ))}
              </div>
            )}

            {hasMore ? (
              <div className="mt-6 flex justify-center">
                <button
                  type="button"
                  onClick={() => void handleLoadMore()}
                  disabled={loadingMore}
                  className="flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-slate-700 hover:bg-slate-50 disabled:opacity-60"
                >
                  {loadingMore ? <Loader2 className="h-4 w-4 animate-spin" /> : null}
                  Load More
                </button>
              </div>
            ) : null}
          </>
        )}
      </div>
    </div>
  )
}
