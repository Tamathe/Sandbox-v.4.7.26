import { NextRequest, NextResponse } from 'next/server'
import { getPrismaClient } from '../../../lib/prisma'

export async function GET(request: NextRequest) {
  const { searchParams } = request.nextUrl
  const type = searchParams.get('type') as 'INTERNAL' | 'EXTERNAL' | null
  const category = searchParams.get('category')
  const tag = searchParams.get('tag')
  const page = Math.max(1, Number.parseInt(searchParams.get('page') ?? '1', 10) || 1)
  const limit = Math.min(50, Math.max(1, Number.parseInt(searchParams.get('limit') ?? '20', 10) || 20))
  const days = searchParams.get('days') ? Number.parseInt(searchParams.get('days')!, 10) : null
  const sentiment = searchParams.get('sentiment') as 'POSITIVE' | 'NEUTRAL' | 'NEGATIVE' | null

  const prisma = getPrismaClient()

  try {
    const where: Record<string, unknown> = {}

    if (type) where.sourceType = type
    if (category && category !== 'All') where.category = category
    if (tag) where.tags = { has: tag }
    if (sentiment) where.sentiment = sentiment

    if (days) {
      const since = new Date()
      since.setDate(since.getDate() - days)
      where.publishedAt = { gte: since }
    }

    const [articles, total] = await Promise.all([
      getPrismaClient().newsArticle.findMany({
        where,
        orderBy: { publishedAt: 'desc' },
        skip: (page - 1) * limit,
        take: limit,
        include: {
          source: { select: { name: true, category: true } },
        },
      }),
      getPrismaClient().newsArticle.count({ where }),
    ])

    return NextResponse.json({
      articles,
      total,
      page,
      hasMore: page * limit < total,
    })
  } catch (err) {
    console.error('GET /api/news/articles error:', err)
    return NextResponse.json({ error: 'Failed to fetch articles' }, { status: 500 })
  }
}
