/**
 * GET /api/tools/recommended?limit=6
 *
 * Returns personalized tool recommendations based on role:
 * - STUDENT: tools from enrolled courses → backfilled with globally popular tools
 * - EDUCATOR: tools in same department/college, ordered by session count
 * - ADMIN: recently approved tools
 *
 * Response: { tools: ToolCard[], reason: string }
 */

import { NextRequest, NextResponse } from 'next/server'
import { prisma } from '../../../lib/prisma'

export const runtime = 'nodejs'

type ToolCard = {
  id: string
  name: string
  category: string
  shortDescription: string | null
  creator: { name: string; college: string | null; department: string | null; role: string }
  _count: { upvotes: number }
}

function formatTool(tool: {
  id: string; name: string; category: string; shortDescription: string | null
  creator: { name: string | null; college: string | null; department: string | null; role: string }
  _count: { upvotes: number }
}): ToolCard {
  return {
    id: tool.id, name: tool.name, category: tool.category,
    shortDescription: tool.shortDescription,
    creator: { name: tool.creator.name ?? '', college: tool.creator.college, department: tool.creator.department, role: tool.creator.role },
    _count: { upvotes: tool._count.upvotes },
  }
}

export async function GET(req: NextRequest) {
  try {
    const email = req.headers.get('x-demo-user-email')
    if (!email) return NextResponse.json({ error: 'Unauthorized' }, { status: 401 })

    const user = await prisma.user.findUnique({ where: { email } })
    if (!user) return NextResponse.json({ error: 'Not found' }, { status: 404 })

    const limit = Math.min(12, parseInt(req.nextUrl.searchParams.get('limit') ?? '6'))

    // ── ADMIN ──
    if (user.role === 'ADMIN') {
      const tools = await prisma.tool.findMany({
        where: { approvalStatus: 'APPROVED' },
        orderBy: { updatedAt: 'desc' },
        take: limit,
        include: { creator: { select: { name: true, college: true, department: true, role: true } }, _count: { select: { upvotes: true } } },
      })
      return NextResponse.json({ tools: tools.map(formatTool), reason: 'Recently approved' })
    }

    // ── EDUCATOR ──
    if (user.role === 'EDUCATOR') {
      const where = user.department || user.college
        ? {
            approvalStatus: 'APPROVED' as const,
            creator: { OR: [
              ...(user.department ? [{ department: user.department }] : []),
              ...(user.college ? [{ college: user.college }] : []),
            ]},
          }
        : { approvalStatus: 'APPROVED' as const }

      const tools = await prisma.tool.findMany({
        where,
        include: { creator: { select: { name: true, college: true, department: true, role: true } }, _count: { select: { upvotes: true } } },
        orderBy: { sessions: { _count: 'desc' } },
        take: limit,
      })

      const reason = user.department ? `Popular in ${user.department}` : 'Popular in your college'
      return NextResponse.json({ tools: tools.map(formatTool), reason })
    }

    // ── STUDENT ──
    const [savedToolIds, usedToolIds, enrollments] = await Promise.all([
      prisma.libraryEntry.findMany({ where: { userId: user.id }, select: { toolId: true } }).then(r => r.map(e => e.toolId)),
      prisma.toolSession.findMany({ where: { userId: user.id }, select: { toolId: true }, distinct: ['toolId'] }).then(r => r.map(s => s.toolId)),
      prisma.courseEnrollment.findMany({ where: { studentId: user.id }, select: { courseId: true } }),
    ])

    const excludeIds = [...new Set([...savedToolIds, ...usedToolIds])]
    const excludeFilter = excludeIds.length > 0 ? { id: { notIn: excludeIds } } : {}
    const enrolledCourseIds = enrollments.map(e => e.courseId)

    let tools: ToolCard[] = []
    let reason = 'Popular on campus'

    if (enrolledCourseIds.length > 0) {
      const courseLinks = await prisma.courseToolLink.findMany({
        where: { courseId: { in: enrolledCourseIds }, tool: { approvalStatus: 'APPROVED', ...excludeFilter } },
        include: {
          tool: {
            include: { creator: { select: { name: true, college: true, department: true, role: true } }, _count: { select: { upvotes: true } } },
          },
        },
      })
      courseLinks.sort((a, b) => b.tool._count.upvotes - a.tool._count.upvotes)
      tools = courseLinks.slice(0, limit).map(link => formatTool(link.tool))
      if (tools.length > 0) reason = 'From your enrolled courses'
    }

    // Backfill with popular tools if needed
    if (tools.length < limit) {
      const needed = limit - tools.length
      const alreadyIncluded = tools.map(t => t.id)
      const fallbackExclude = [...excludeIds, ...alreadyIncluded]
      const fallbackFilter = fallbackExclude.length > 0 ? { id: { notIn: fallbackExclude } } : {}

      const fallback = await prisma.tool.findMany({
        where: { approvalStatus: 'APPROVED', ...fallbackFilter },
        include: { creator: { select: { name: true, college: true, department: true, role: true } }, _count: { select: { upvotes: true } } },
        orderBy: { upvotes: { _count: 'desc' } },
        take: needed,
      })
      tools = [...tools, ...fallback.map(formatTool)]
    }

    return NextResponse.json({ tools, reason })
  } catch (err) {
    console.error('[GET /api/tools/recommended]', err)
    return NextResponse.json({ error: 'Internal server error' }, { status: 500 })
  }
}
