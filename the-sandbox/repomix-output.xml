/**
 * Canvas LMS API client.
 *
 * Current role: write-only grade sink.
 * Future: Sandbox becomes system of record; Canvas becomes an optional sync target.
 *
 * Required env vars (set when Canvas integration is active):
 *   CANVAS_BASE_URL   — e.g. https://uk.instructure.com
 *   CANVAS_API_TOKEN  — Canvas API token (faculty/admin, or OAuth)
 *
 * Canvas REST API docs: https://canvas.instructure.com/doc/api/
 */

export interface GradePushParams {
  canvasCourseId: string
  canvasAssignmentId: string
  /** Student email — used to look up Canvas user ID */
  studentEmail: string
  score: number
  comment?: string
}

export interface GradePushResult {
  success: boolean
  error?: string
}

/**
 * Push a single student grade + optional comment to Canvas.
 *
 * If CANVAS_BASE_URL or CANVAS_API_TOKEN are not configured, returns
 * { success: false, error: "Canvas not configured" } without throwing.
 */
export async function pushGradeToCanvas(params: GradePushParams): Promise<GradePushResult> {
  const baseUrl = process.env.CANVAS_BASE_URL
  const token = process.env.CANVAS_API_TOKEN

  if (!baseUrl || !token) {
    console.warn('[canvas-client] Canvas not configured — skipping grade push')
    return { success: false, error: 'Canvas not configured' }
  }

  try {
    // Step 1: Resolve student email → Canvas user ID
    const userRes = await fetch(
      `${baseUrl}/api/v1/accounts/self/users?search_term=${encodeURIComponent(params.studentEmail)}&per_page=1`,
      { headers: { Authorization: `Bearer ${token}` } }
    )
    if (!userRes.ok) {
      return { success: false, error: `Canvas user lookup failed: ${userRes.status}` }
    }
    const users = await userRes.json() as Array<{ id: number }>
    if (!users.length) {
      return { success: false, error: `Student not found in Canvas: ${params.studentEmail}` }
    }
    const canvasUserId = users[0].id

    // Step 2: PUT grade submission
    const body: Record<string, unknown> = {
      submission: { posted_grade: String(params.score) },
    }
    if (params.comment) {
      body.comment = { text_comment: params.comment }
    }

    const gradeRes = await fetch(
      `${baseUrl}/api/v1/courses/${params.canvasCourseId}/assignments/${params.canvasAssignmentId}/submissions/${canvasUserId}`,
      {
        method: 'PUT',
        headers: {
          Authorization: `Bearer ${token}`,
          'Content-Type': 'application/json',
        },
        body: JSON.stringify(body),
      }
    )

    if (!gradeRes.ok) {
      const errText = await gradeRes.text().catch(() => '')
      return { success: false, error: `Canvas grade push failed: ${gradeRes.status} ${errText}` }
    }

    return { success: true }
  } catch (err) {
    const msg = err instanceof Error ? err.message : String(err)
    console.error('[canvas-client] Grade push error:', msg)
    return { success: false, error: msg }
  }
}

/**
 * Check whether Canvas is configured in the current environment.
 */
export function canvasConfigured(): boolean {
  return !!(process.env.CANVAS_BASE_URL && process.env.CANVAS_API_TOKEN)
}
