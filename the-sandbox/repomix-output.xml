                placeholder="e.g. finaid@uky.edu"
              />
            </div>
            <div>
              <label className="block text-sm font-medium text-gray-700 mb-1.5">Focus Areas (optional)</label>
              <textarea
                value={focusAreas}
                onChange={(e) => setFocusAreas(e.target.value)}
