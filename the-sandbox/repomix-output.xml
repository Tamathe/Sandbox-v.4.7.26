        </section>

        {/* How tools get shared */}
        <section>
          <h2 className="text-sm font-extrabold text-gray-400 uppercase tracking-widest mb-4">How tools get shared</h2>
          <div className="grid grid-cols-1 sm:grid-cols-3 gap-4">
            {PUBLISHING_TIERS.map(tier => {
              const Icon = tier.icon
              return (
                <div key={tier.label} className="rounded-2xl border border-gray-200 bg-white p-5">
                  <div className="flex items-center gap-2 mb-3">
                    <span className={`text-xs font-bold px-2.5 py-1 rounded-full ${tier.badge}`}>
                      {tier.label}
                    </span>
                  </div>
                  <p className="text-sm text-gray-600 leading-relaxed mb-3">{tier.description}</p>
                  <p className="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">{tier.who}</p>
                </div>
              )
            })}
          </div>
        </section>

      </div>
    </div>
  )
}
