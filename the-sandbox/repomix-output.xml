    }

    void fetchNotifications()
    const intervalId = window.setInterval(() => {
      void fetchNotifications()
    }, 30000)

    return () => {
      cancelled = true
      window.clearInterval(intervalId)
    }
  }, [currentUser.email])

  useEffect(() => {
    if (currentUser.role !== 'STUDENT') {
      return
    }

