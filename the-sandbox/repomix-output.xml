import { NextRequest, NextResponse } from 'next/server'
import { getPrismaClient } from '../../../lib/prisma'

export async function GET(_request: NextRequest) {
  const prisma = getPrismaClient()

  try {
    const now = new Date()
    const last24h = new Date(now.getTime() - 24 * 60 * 60 * 1000)
    const last7d = new Date(now.getTime() - 7 * 24 * 60 * 60 * 1000)

    const [articles, last24hCount, last7dCount] = await Promise.all([
      prisma.newsArticle.findMany({
        where: { publishedAt: { gte: last7d } },
        select: {
          sentiment: true,
          tags: true,
          outletName: true,
          outletCity: true,
          outletState: true,
          sourceType: true,
        },
      }),
      prisma.newsArticle.count({ where: { publishedAt: { gte: last24h } } }),
      prisma.newsArticle.count({ where: { publishedAt: { gte: last7d } } }),
    ])

    const totalArticles = await prisma.newsArticle.count()

    // Sentiment breakdown
    const sentimentBreakdown = { POSITIVE: 0, NEUTRAL: 0, NEGATIVE: 0 }
    for (const a of articles) {
      if (a.sentiment === 'POSITIVE') sentimentBreakdown.POSITIVE++
      else if (a.sentiment === 'NEGATIVE') sentimentBreakdown.NEGATIVE++
      else sentimentBreakdown.NEUTRAL++
    }

    // Top tags
    const tagCounts: Record<string, number> = {}
    for (const a of articles) {
      for (const tag of a.tags) {
        tagCounts[tag] = (tagCounts[tag] ?? 0) + 1
      }
    }
    const topTags = Object.entries(tagCounts)
      .sort((a, b) => b[1] - a[1])
      .slice(0, 20)
      .map(([tag, count]) => ({ tag, count }))

    // Coverage by outlet (EXTERNAL only)
    const outletMap: Record<string, { outlet: string; city: string | null; state: string | null; count: number; sentimentCounts: Record<string, number> }> = {}
    for (const a of articles) {
      if (a.sourceType !== 'EXTERNAL') continue
      const key = a.outletName ?? 'Unknown'
      if (!outletMap[key]) {
        outletMap[key] = { outlet: key, city: a.outletCity ?? null, state: a.outletState ?? null, count: 0, sentimentCounts: { POSITIVE: 0, NEUTRAL: 0, NEGATIVE: 0 } }
      }
      outletMap[key].count++
      const s = a.sentiment ?? 'NEUTRAL'
      outletMap[key].sentimentCounts[s] = (outletMap[key].sentimentCounts[s] ?? 0) + 1
    }

    const coverageByOutlet = Object.values(outletMap)
      .sort((a, b) => b.count - a.count)
      .slice(0, 20)
      .map(({ sentimentCounts, ...rest }) => {
        const max = Object.entries(sentimentCounts).sort((a, b) => b[1] - a[1])[0]
        return { ...rest, sentiment: max?.[0] ?? 'NEUTRAL' }
      })

    // Spike detection: last 24h > 2× daily avg over last 7d
    const dailyAvg7d = last7dCount / 7
    const spike = last24hCount > 2 * dailyAvg7d && dailyAvg7d > 0

    return NextResponse.json({
      sentimentBreakdown,
      topTags,
      coverageByOutlet,
      spike,
      totalArticles,
      last24hCount,
    })
  } catch (err) {
    console.error('GET /api/news/stats error:', err)
    return NextResponse.json({ error: 'Failed to fetch stats' }, { status: 500 })
  }
}
</file>

