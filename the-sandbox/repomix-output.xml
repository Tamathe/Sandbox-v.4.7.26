                          const next = new Set(prev)
                          if (next.has(tag)) next.delete(tag)
                          else next.add(tag)
                          return next
                        })}
                        className={`inline-flex items-center gap-1 px-3 py-1 rounded-full text-xs font-medium border transition ${
                          active
                            ? 'bg-[#0033A0] text-white border-[#0033A0]'
                            : 'bg-white text-gray-500 border-gray-200 hover:border-[#0033A0] hover:text-[#0033A0]'
