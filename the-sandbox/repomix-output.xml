function countSessionsThisWeek(sessions: { date: string }[]): number {
  return sessions.filter(s => {
    const d = s.date.toLowerCase()
    return d.includes('hour') || d.includes('yesterday') || /^[1-6] day/.test(d)
  }).length
}

function scoreTrend(sessions: { score: number }[], avg: number): 'up' | 'down' | 'flat' {
  const scored = sessions.filter(s => s.score > 0).slice(0, 3)
  if (scored.length < 2) return 'flat'
  const recent = scored.reduce((sum, s) => sum + s.score, 0) / scored.length
  if (recent > avg + 3) return 'up'
  if (recent < avg - 3) return 'down'
  return 'flat'
}

