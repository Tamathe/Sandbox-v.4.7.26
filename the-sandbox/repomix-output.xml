// Helper: detect multiple-choice options in quiz responses
function extractMultipleChoiceOptions(text: string): string[] | null {
  const lines = text.split('\n').map(l => l.trim()).filter(Boolean)
  const choices = lines.filter(l => /^[A-D][).]\s+\S/.test(l))
  return choices.length >= 3 ? choices : null
}

// Helper: detect structured flashcard format
// Supports new <card><term>...</term><def>...</def></card> format with fallback to **Term:**/**Definition:** markdown
function extractFlashcard(text: string): { front: string; back: string } | null {
  // Primary: XML-style card tags (new format)
  const cardMatch = text.match(/<card>[\s\S]*?<term>([\s\S]*?)<\/term>[\s\S]*?<def>([\s\S]*?)<\/def>[\s\S]*?<\/card>/i)
  if (cardMatch) {
    return { front: cardMatch[1].trim(), back: cardMatch[2].trim() }
  }
  // Fallback: markdown bold format
  const patterns = [
    /\*\*(?:Term|Front|Question)\*\*[:\s]+(.+?)[\n\r]+\*\*(?:Definition|Back|Answer)\*\*[:\s]+([\s\S]+?)(?:\n\n|$)/i,
    /^(?:Term|Front|Q)[:\s]+(.+?)[\n\r]+(?:Definition|Back|A)[:\s]+([\s\S]+?)(?:\n\n|$)/im,
  ]
  for (const pattern of patterns) {
    const match = text.trim().match(pattern)
    if (match) {
      return { front: match[1].trim(), back: match[2].trim() }
    }
  }
  return null
}

interface Doc {
  id: string
  filename: string
  wordCount: number
  source: 'course' | 'student'
  lowExtraction?: boolean  // True if wordCount is suspiciously low for the file size
}

interface Message {
  id: string
  role: 'user' | 'assistant'
  content: string
}

interface PastSession {
  id: string
  startedAt: string
  messageCount: number
  courseId: string | null
}

interface StudyBuddyInterfaceProps {
  toolId: string
  toolName: string
  welcomeMessage?: string | null
  starterQuestions?: string[]
  userEmail: string
  courseId?: string
  courseName?: string
  suggestedTopics?: string[]
  onDone?: () => void   // Called when student finishes — used by CourseStudyPanel to navigate back
}

export default function StudyBuddyInterface({
  toolId,
  toolName,
  welcomeMessage,
  starterQuestions = [],
  userEmail,
  courseId,
  courseName,
  suggestedTopics,
  onDone,
}: StudyBuddyInterfaceProps) {
  const [screen, setScreen] = useState<Screen>('select')
  const [mode, setMode] = useState<Mode>('tutor')
  const [sessionId, setSessionId] = useState<string | null>(null)
  const [messages, setMessages] = useState<Message[]>([])
  const [input, setInput] = useState('')
  const [isLoading, setIsLoading] = useState(false)
  const [docs, setDocs] = useState<Doc[]>([])
  const [docsOpen, setDocsOpen] = useState(false)
  const [uploading, setUploading] = useState(false)
  const [uploadError, setUploadError] = useState('')
  const [isDragOver, setIsDragOver] = useState(false)
  // Fix 2b: dismiss banner
  const [noBannerDismissed, setNoBannerDismissed] = useState(false)
  // Fix 3: pending mode switch confirmation
  const [pendingModeSwitch, setPendingModeSwitch] = useState<Mode | '__back__' | null>(null)
  // Wrap-up summary
  const [wrapupSummary, setWrapupSummary] = useState<string>('')
  const [summaryLoading, setSummaryLoading] = useState(false)
  // Background pre-generated summary (built after 5th user message, shown instantly on wrap-up)
  const [backgroundSummary, setBackgroundSummary] = useState<string>('')

  // Rate limit countdown (seconds remaining, 0 = not rate limited)
  const [rateLimitCountdown, setRateLimitCountdown] = useState(0)
  // Silence countdown during voice recording (3.5s before auto-stop)
  const [silenceCountdown, setSilenceCountdown] = useState(0)
  // ID of the last failed assistant message (for retry UI)
  const [failedMessageId, setFailedMessageId] = useState<string | null>(null)
  // Student-requested difficulty: 'easier' | null | 'harder'
  const [difficultyBias, setDifficultyBias] = useState<'easier' | 'harder' | null>(null)
  // Quiz score tracking
  const [quizScore, setQuizScore] = useState<{ correct: number; total: number }>({ correct: 0, total: 0 })
  // Quiz question log: captures each Q&A pair for end-of-session review
  const [quizLog, setQuizLog] = useState<{ question: string; userAnswer: string; correct: boolean }[]>([])
  // Flashcard flip state
  const [flippedCards, setFlippedCards] = useState<Set<string>>(new Set())
  // Flashcard mastery state: known = confident, review = needs revisiting
  const [knownCards, setKnownCards] = useState<Set<string>>(new Set())
  const [reviewCards, setReviewCards] = useState<Set<string>>(new Set())
  // Session history
  const [pastSessions, setPastSessions] = useState<PastSession[]>([])
  const [loadingSessions, setLoadingSessions] = useState(false)
  const [sessionsOpen, setSessionsOpen] = useState(false)
  const [resuming, setResuming] = useState(false)
  // Learning objective mastery (green = mastered, yellow = uncertain)
  const [masteryMap, setMasteryMap] = useState<Record<string, 'green' | 'yellow'>>({})
  const [masteryOpen, setMasteryOpen] = useState(false)

  const messagesEndRef = useRef<HTMLDivElement>(null)
  const fileInputRef = useRef<HTMLInputElement>(null)
  // sessionIdRef avoids stale closure in sendMessage
  const sessionIdRef = useRef<string | null>(null)
  // Prevents duplicate session creation if sendMessage is called before the first resolves
  const sessionCreatingRef = useRef<Promise<string | null> | null>(null)
  // Session start time for duration tracking
  const sessionStartRef = useRef<number>(Date.now())

  const { isRecording, interimTranscript, isSupported, startRecording, stopRecording } = useSpeechRecognition()

  const currentModeConfig = MODES.find(m => m.id === mode)!

  // Session is created lazily on first message send (see sendMessage below)
  // This avoids orphan sessions for users who browse away without interacting.

  // Restore last-used mode from localStorage
  useEffect(() => {
    const last = localStorage.getItem(`study-buddy-last-mode-${toolId}`)
    if (last && MODES.find(m => m.id === last)) {
      setMode(last as Mode)
    }
  }, [toolId])

  // Load documents
  useEffect(() => {
    async function loadDocs() {
      try {
        const url = `/api/study/${toolId}/documents${sessionIdRef.current ? `?sessionId=${sessionIdRef.current}` : ''}`
        const res = await fetch(url, { headers: { 'x-demo-user-email': userEmail } })
        if (!res.ok) return
        const data: { id: string; filename: string; wordCount: number; toolId: string | null }[] = await res.json()
        setDocs(data.map(d => ({ ...d, source: d.toolId ? 'course' : 'student' })))
      } catch { /* non-critical */ }
    }
    loadDocs()
  }, [toolId, sessionId, userEmail])

  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' })
  }, [messages])

  useEffect(() => {
    if (interimTranscript) setInput(interimTranscript)
  }, [interimTranscript])

  // Background summary: pre-generate after 5th user message so wrap-up is instant
  const userMsgCount = messages.filter(m => m.role === 'user').length
  useEffect(() => {
    if (userMsgCount !== 5 || backgroundSummary) return
    // Fire-and-forget: build summary silently
    void (async () => {
      try {
        const summaryPrompt = `Based on this study session so far, write a brief wrap-up in exactly this format:
**Covered:** [2-3 topics we discussed, comma separated]
**Strong:** [one thing the student clearly understood]
**Review:** [one thing to revisit]
Be specific. Use course terminology. Maximum 3 sentences total.`
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
          body: JSON.stringify({
            toolId,
            messages: [...messages.map(m => ({ role: m.role, content: m.content })), { role: 'user', content: summaryPrompt }],
            sessionId: sessionIdRef.current,
            mode,
            courseId,
          }),
        })
        if (!res.ok) return
        const reader = res.body!.getReader()
        const decoder = new TextDecoder()
        let text = ''
        while (true) {
          const { done, value } = await reader.read()
          if (done) break
          text += decoder.decode(value)
        }
        setBackgroundSummary(text)
        // Persist summary to the session record so it survives tab closes
        if (sessionIdRef.current && text) {
          fetch(`/api/sessions/${sessionIdRef.current}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
            body: JSON.stringify({ summary: text }),
          }).catch(() => {})
        }
      } catch { /* non-critical */ }
    })()
  }, [userMsgCount, backgroundSummary, messages, toolId, userEmail, mode, courseId])

  // Auto-save wrap-up summary to Notes when the wrapup screen loads with a summary
  useEffect(() => {
    if (screen !== 'wrapup' || !wrapupSummary || !sessionId) return
    const date = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
    fetch('/api/notes', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
      body: JSON.stringify({
        title: `Study Session: ${toolName} — ${date}`,
        content: wrapupSummary,
        sourceSessionId: sessionId,
      }),
    }).catch(() => {}) // non-critical — silent fail
  }, [screen, wrapupSummary, sessionId, toolName, userEmail])

  // Rate limit countdown ticker
  useEffect(() => {
    if (rateLimitCountdown <= 0) return
    const timer = setTimeout(() => setRateLimitCountdown(c => Math.max(0, c - 1)), 1000)
    return () => clearTimeout(timer)
  }, [rateLimitCountdown])

  // Silence countdown: start at 3.5s when recording, reset on each interim transcript
  useEffect(() => {
    if (!isRecording) { setSilenceCountdown(0); return }
    setSilenceCountdown(4) // start slightly above 3.5s to account for effect delay
    const timer = setInterval(() => setSilenceCountdown(c => Math.max(0, c - 1)), 1000)
    return () => clearInterval(timer)
  }, [isRecording, interimTranscript])

  // Auto-open docs panel when entering doc-centric modes with zero docs attached
  useEffect(() => {
    if (screen !== 'chat') return
    const docCentricModes: Mode[] = ['essay', 'tutor']
    if (docCentricModes.includes(mode) && docs.length === 0) {
      setDocsOpen(true)
    }
  }, [screen, docs.length, mode])

  // Load past sessions when the select screen is shown
  useEffect(() => {
    if (screen !== 'select') return
    setLoadingSessions(true)
    fetch(`/api/study/${toolId}/sessions`, { headers: { 'x-demo-user-email': userEmail } })
      .then(r => r.ok ? r.json() : [])
      .then(data => setPastSessions(data))
      .catch(() => {})
      .finally(() => setLoadingSessions(false))
  }, [screen, toolId, userEmail])

  const resumeSession = useCallback(async (session: PastSession) => {
    setResuming(true)
    try {
      const res = await fetch(`/api/study/${toolId}/sessions/${session.id}/messages`, {
        headers: { 'x-demo-user-email': userEmail },
      })
      if (!res.ok) throw new Error('Failed to load session')
      const dbMessages: { id: string; role: string; content: string }[] = await res.json()

      sessionIdRef.current = session.id
      setSessionId(session.id)
      setMessages(dbMessages.map(m => ({
        id: m.id,
        role: m.role as 'user' | 'assistant',
        content: m.content,
      })))
      setQuizScore({ correct: 0, total: 0 })
      setQuizLog([])
      setFlippedCards(new Set())
      sessionStartRef.current = Date.now()
      setScreen('chat')
    } catch { /* non-critical — if load fails, just start fresh */ }
    finally { setResuming(false) }
  }, [toolId, userEmail])

  const enterMode = (selectedMode: Mode) => {
    setMode(selectedMode)
    setMessages([])
    setQuizScore({ correct: 0, total: 0 })
    setQuizLog([])
    setFlippedCards(new Set())
    setKnownCards(new Set())
    setReviewCards(new Set())
    // Clear any resumed session so a new one is created on first send
    sessionIdRef.current = null
    setSessionId(null)
    sessionStartRef.current = Date.now()
    setScreen('chat')
    localStorage.setItem(`study-buddy-last-mode-${toolId}`, selectedMode)
    // No auto-prompts — student taps the Start button in the welcome area (Fix 5)
  }

  // Lazily creates a session on first send — avoids orphan sessions for users who browse away
  const ensureSession = useCallback(async (): Promise<string | null> => {
    if (sessionIdRef.current) return sessionIdRef.current

    // If a creation is already in flight, wait for it instead of making a duplicate
    if (sessionCreatingRef.current) return sessionCreatingRef.current

    sessionCreatingRef.current = fetch('/api/sessions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
      body: JSON.stringify({ toolId, courseId }),
    })
      .then(r => r.ok ? r.json() : null)
      .then(data => {
        const id = data?.sessionId ?? null
        if (id) {
          sessionIdRef.current = id
          setSessionId(id)
        }
        return id
      })
      .catch(() => null)
      .finally(() => { sessionCreatingRef.current = null })

    return sessionCreatingRef.current
  }, [toolId, userEmail, courseId])

  // sendMessage reads sessionId from ref to avoid stale closure
  const sendMessage = useCallback(async (content: string) => {
    if (!content.trim() || isLoading) return

    const userMsg: Message = { id: Date.now().toString(), role: 'user', content: content.trim() }
    const assistantId = (Date.now() + 1).toString()
    const assistantMsg: Message = { id: assistantId, role: 'assistant', content: '' }

    setMessages(prev => [...prev, userMsg, assistantMsg])
    setInput('')
    setIsLoading(true)

    // Create session on first send if it doesn't exist yet
    await ensureSession()

    try {
      const history = [...messages, userMsg]
      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
        body: JSON.stringify({
          toolId,
          messages: history.map(m => ({ role: m.role, content: m.content })),
          sessionId: sessionIdRef.current,  // read from ref, not stale closure
          mode,
          courseId,
          difficultyBias,
        }),
      })

      if (!res.ok) {
        const err = await res.json().catch(() => ({ error: 'Failed to connect' }))
        if (res.status === 429 && err.error === 'rate_limit') {
          // Rate limited: remove the placeholder assistant message and show inline banner
          setMessages(prev => prev.filter(m => m.id !== assistantId))
          setRateLimitCountdown(err.retryAfter ?? 30)
          return
        }
        throw new Error(err.error || 'Failed to connect')
      }

      const reader = res.body!.getReader()
      const decoder = new TextDecoder()
      let fullText = ''

      while (true) {
        const { done, value } = await reader.read()
        if (done) break
        fullText += decoder.decode(value)
        // Strip hidden signal tags from displayed content while streaming
        // (prevents partial tags from flashing; ReactMarkdown handles complete ones too)
        const displayText = fullText
          .replace(/<!--QUIZ:(correct|incorrect)-->/gi, '')
          .replace(/<!--OBJECTIVES:[\s\S]*?-->/gi, '')
        setMessages(prev => prev.map(m => m.id === assistantId ? { ...m, content: displayText } : m))
      }

      // Quiz score detection via structured AI signal (replaces fragile regex)
      if (mode === 'quiz' && fullText) {
        const correctSignal = /<!--QUIZ:correct-->/i.test(fullText)
        const incorrectSignal = /<!--QUIZ:incorrect-->/i.test(fullText)
        if (correctSignal || incorrectSignal) {
          setQuizScore(prev => ({
            correct: prev.correct + (correctSignal ? 1 : 0),
            total: prev.total + 1,
          }))
          // Log Q&A pair for end-of-session review
          setMessages(prev => {
            const assistantMsgs = prev.filter(m => m.role === 'assistant')
            const userMsgs = prev.filter(m => m.role === 'user')
            // The question is the second-to-last assistant message (the one before the evaluation)
            const questionMsg = assistantMsgs[assistantMsgs.length - 2]
            const answerMsg = userMsgs[userMsgs.length - 1]
            if (questionMsg && answerMsg) {
              setQuizLog(log => [...log, {
                question: questionMsg.content.replace(/<!--[\s\S]*?-->/g, '').trim().slice(0, 300),
                userAnswer: answerMsg.content.trim().slice(0, 200),
                correct: correctSignal,
              }])
            }
            return prev
          })
        }
      }

      // Parse learning objective mastery signals and update masteryMap
      if (fullText && courseId) {
        const objMatch = fullText.match(/<!--OBJECTIVES:([\s\S]*?)-->/)
        if (objMatch) {
          try {
            const parsed: { id: string; quality: 'green' | 'yellow' }[] = JSON.parse(objMatch[1])
            setMasteryMap(prev => {
              const next = { ...prev }
              for (const { id, quality } of parsed) {
                // Green overrides yellow, never downgrade green to yellow
                if (!next[id] || next[id] === 'yellow' || quality === 'green') {
                  next[id] = quality
                }
              }
              return next
            })
          } catch { /* malformed tag — ignore */ }
        }
      }
    } catch (err) {
      const msg = err instanceof Error ? err.message : 'Something went wrong.'
      setMessages(prev => prev.map(m => m.id === assistantId ? { ...m, content: `⚠️ ${msg}` } : m))
      setFailedMessageId(assistantId)
    } finally {
      setIsLoading(false)
    }
  }, [messages, isLoading, toolId, userEmail, mode, courseId, ensureSession])

  // Retry last failed message: remove the broken assistant message and resend the last user message
  const retryLastMessage = useCallback(() => {
    setFailedMessageId(null)
    const lastUserMsg = [...messages].reverse().find(m => m.role === 'user')
    if (!lastUserMsg) return
    // Remove the failed assistant placeholder
    setMessages(prev => prev.filter(m => m.role !== 'assistant' || !m.content.startsWith('⚠️')))
    // Re-send by removing the failed assistant message and re-calling sendMessage with history up to the last user message
    const historyUpToUser = messages.filter(m => m.id !== failedMessageId)
    void (async () => {
      const assistantId = (Date.now() + 1).toString()
      const assistantMsg: Message = { id: assistantId, role: 'assistant', content: '' }
      setMessages(prev => [...prev.filter(m => !m.content.startsWith('⚠️')), assistantMsg])
      setIsLoading(true)
      await ensureSession()
      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
          body: JSON.stringify({
            toolId,
            messages: historyUpToUser.map(m => ({ role: m.role, content: m.content })),
            sessionId: sessionIdRef.current,
            mode,
            courseId,
          }),
        })
        if (!res.ok) throw new Error('Retry failed')
        const reader = res.body!.getReader()
        const decoder = new TextDecoder()
        let fullText = ''
        while (true) {
          const { done, value } = await reader.read()
          if (done) break
          fullText += decoder.decode(value)
          const displayText = fullText
            .replace(/<!--QUIZ:(correct|incorrect)-->/gi, '')
            .replace(/<!--OBJECTIVES:[\s\S]*?-->/gi, '')
          setMessages(prev => prev.map(m => m.id === assistantId ? { ...m, content: displayText } : m))
        }
      } catch (err) {
        const msg = err instanceof Error ? err.message : 'Retry failed.'
        setMessages(prev => prev.map(m => m.id === assistantId ? { ...m, content: `⚠️ ${msg}` } : m))
        setFailedMessageId(assistantId)
      } finally {
        setIsLoading(false)
      }
    })()
  }, [messages, failedMessageId, toolId, userEmail, mode, courseId, ensureSession])

  const handleUpload = async (file: File) => {
    setUploading(true)
    setUploadError('')
    try {
      const formData = new FormData()
      formData.append('file', file)
      if (sessionIdRef.current) formData.append('sessionId', sessionIdRef.current)

      const res = await fetch(`/api/study/${toolId}/upload`, {
        method: 'POST',
        headers: { 'x-demo-user-email': userEmail },
        body: formData,
      })

      if (!res.ok) {
        const err = await res.json()
        throw new Error(err.error || 'Upload failed')
      }

      const doc = await res.json()
      // Flag potentially scanned/unextractable PDFs (very few words for a presumably non-trivial file)
      const lowExtraction = doc.wordCount < 50
      setDocs(prev => [...prev, { id: doc.id, filename: doc.filename, wordCount: doc.wordCount, source: 'student', lowExtraction }])

      // Announce the new doc without clearing conversation history
      const notice: Message = {
        id: Date.now().toString(),
        role: 'assistant',
        content: `📄 Loaded **${doc.filename}** (${doc.wordCount.toLocaleString()} words) — I'll use this material going forward.`,
      }
      setMessages(prev => [...prev, notice])
    } catch (err) {
      setUploadError(err instanceof Error ? err.message : 'Upload failed')
    } finally {
      setUploading(false)
    }
  }

  const removeDoc = async (docId: string) => {
    const removed = docs.find(d => d.id === docId)
    try {
      await fetch(`/api/study/${toolId}/upload?docId=${docId}`, {
        method: 'DELETE',
        headers: { 'x-demo-user-email': userEmail },
      })
      setDocs(prev => prev.filter(d => d.id !== docId))
      if (removed) {
        const notice: Message = {
          id: Date.now().toString(),
          role: 'assistant',
          content: `Removed **${removed.filename}** from my context.`,
        }
        setMessages(prev => [...prev, notice])
      }
    } catch { /* non-critical */ }
  }

  const handleMic = () => {
    if (isRecording) {
      stopRecording()
    } else {
      startRecording((finalText: string) => {
        if (finalText.trim()) sendMessage(finalText)
      })
    }
  }

  // Fix 12: AI-generated wrap-up summary
  const generateSummary = useCallback(async (currentMessages: Message[], currentMastery: Record<string, 'green' | 'yellow'> = {}) => {
    if (currentMessages.length < 4) return
    setSummaryLoading(true)
    try {
      const masteryLines = Object.entries(currentMastery).length > 0
        ? `\nObjective mastery signals from this session: ${Object.entries(currentMastery).map(([id, q]) => `${id}=${q}`).join(', ')}`
        : ''
      const summaryPrompt = `Based on this study session, write a brief wrap-up in exactly this format:
**Covered:** [2-3 topics we discussed, comma separated]
**Strong:** [one thing the student clearly understood]
**Review:** [one thing to revisit]
Be specific. Use course terminology. Maximum 3 sentences total.${masteryLines}`

      const res = await fetch('/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'x-demo-user-email': userEmail },
        body: JSON.stringify({
          toolId,
          messages: [
            ...currentMessages.map(m => ({ role: m.role, content: m.content })),
            { role: 'user', content: summaryPrompt },
          ],
          sessionId: sessionIdRef.current,
          mode,
          courseId,
        }),
      })
      if (!res.ok) return

      const reader = res.body!.getReader()
      const decoder = new TextDecoder()
      let text = ''
      while (true) {
        const { done, value } = await reader.read()
        if (done) break
        text += decoder.decode(value)
        setWrapupSummary(text)
      }
    } catch { /* non-critical */ }
    finally { setSummaryLoading(false) }
  }, [toolId, userEmail, mode, courseId, masteryMap])

  const messageCount = messages.filter(m => m.role === 'user').length

  // ── SCREEN: SELECT ─────────────────────────────────────────────────────────
  if (screen === 'select') {
    return (
      <div className="flex flex-col h-full bg-gray-50 rounded-2xl overflow-hidden border border-gray-200">
        {/* Header */}
        <div className="bg-white border-b border-gray-200 px-5 py-4">
          <div className="flex items-center gap-2.5">
            <div className="w-8 h-8 bg-gradient-to-br from-[#0033A0] to-purple-600 rounded-full flex items-center justify-center flex-shrink-0">
              <Sparkles className="w-4 h-4 text-white" />
            </div>
            <div>
              <h2 className="font-semibold text-gray-900 text-sm">{toolName}</h2>
              <p className="text-xs text-gray-500">
                {courseName ? `Studying ${courseName}` : 'How do you want to study today?'}
              </p>
            </div>
            {/* Fix 11: always show both course badge AND docs badge when applicable */}
            <div className="ml-auto flex items-center gap-1.5 min-w-0 flex-shrink">
              {courseName && (
                <span className="text-xs bg-[#0033A0]/10 text-[#0033A0] px-2 py-0.5 rounded-full font-medium hidden sm:inline-block truncate max-w-[120px]">
                  {courseName}
                </span>
              )}
              {docs.length > 0 && (
                <span className="text-xs bg-emerald-100 text-emerald-700 px-2 py-0.5 rounded-full font-medium whitespace-nowrap flex-shrink-0">
                  {docs.length} doc{docs.length !== 1 ? 's' : ''}
                </span>
              )}
            </div>
          </div>
        </div>

        {/* Mode grid */}
        <div className="flex-1 overflow-y-auto p-4">
          {welcomeMessage && (
            <p className="text-sm text-gray-500 text-center mb-4 px-2">{welcomeMessage}</p>
          )}

          {/* Fix 2b: No materials banner (standalone launch only) */}
          {!courseId && docs.length === 0 && !noBannerDismissed && (
            <div className="flex items-start gap-2.5 bg-amber-50 border border-amber-200 rounded-xl px-4 py-3 text-sm mb-4">
              <span className="text-amber-500 mt-0.5 flex-shrink-0">⚠</span>
              <div className="flex-1 min-w-0">
                <p className="font-medium text-amber-800">No course materials attached</p>
                <p className="text-amber-700 text-xs mt-0.5">
                  Study Buddy works best with your course notes. Upload a PDF below to get started.
                </p>
              </div>
              <button onClick={() => setNoBannerDismissed(true)} className="text-amber-400 hover:text-amber-600 flex-shrink-0">
                <X className="w-4 h-4" />
              </button>
            </div>
          )}

          <p className="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">
            Choose how you want to study
          </p>

          <div className="grid grid-cols-1 min-[380px]:grid-cols-2 gap-3">
            {MODES.map(m => {
              const Icon = m.icon
              return (
                <button
                  key={m.id}
                  onClick={() => enterMode(m.id)}
                  title={`Best for: ${m.bestFor}`}
                  className={`group relative flex flex-col items-start gap-2 p-4 rounded-xl border-2 bg-white transition-all text-left shadow-sm hover:shadow-md ${m.border}`}
                >
                  {m.badge && (
                    <span className="absolute top-2.5 right-2.5 text-[10px] font-semibold bg-gray-100 text-gray-500 px-1.5 py-0.5 rounded-full">
                      {m.badge}
                    </span>
                  )}
                  {m.id === mode && !m.badge && (
                    <span className="absolute top-2.5 right-2.5 text-[10px] font-semibold bg-[#0033A0]/10 text-[#0033A0] px-1.5 py-0.5 rounded-full">
                      Last used
                    </span>
                  )}
                  <div className={`w-9 h-9 rounded-lg ${m.bg} flex items-center justify-center`}>
                    <Icon className={`w-5 h-5 ${m.color}`} />
                  </div>
                  <div>
                    <p className="font-semibold text-gray-900 text-sm">{m.label}</p>
                    <p className="text-xs text-gray-500 mt-0.5 leading-snug">{m.description}</p>
                    <p className="text-[10px] text-gray-400 mt-1 leading-snug italic line-clamp-2" title={m.bestFor}>
                      Best for: {m.bestFor}
                    </p>
                  </div>
                </button>
              )
            })}
          </div>

          {/* Past Sessions */}
          {(loadingSessions || pastSessions.length > 0) && (
            <div className="mt-4 border border-gray-200 rounded-xl bg-white overflow-hidden">
              <button
                onClick={() => setSessionsOpen(v => !v)}
                className="w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors"
              >
                <div className="flex items-center gap-2">
                  <History className="w-4 h-4 text-gray-400" />
                  <span>Recent Sessions</span>
                  {!loadingSessions && (
                    <span className="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">
                      {pastSessions.length}
                    </span>
                  )}
                </div>
                {sessionsOpen ? <ChevronUp className="w-4 h-4 text-gray-400" /> : <ChevronDown className="w-4 h-4 text-gray-400" />}
              </button>
              {sessionsOpen && (
                <div className="border-t border-gray-100 divide-y divide-gray-100">
                  {loadingSessions ? (
                    <div className="px-4 py-3 flex items-center gap-2 text-sm text-gray-400">
                      <Loader2 className="w-3.5 h-3.5 animate-spin" />
                      Loading sessions...
                    </div>
                  ) : pastSessions.length === 0 ? (
                    <div className="px-4 py-3 text-sm text-gray-400">No past sessions yet.</div>
                  ) : (
                    pastSessions.map(s => {
                      const date = new Date(s.startedAt)
                      const dateStr = date.toLocaleDateString(undefined, { month: 'short', day: 'numeric' })
                      const timeStr = date.toLocaleTimeString(undefined, { hour: 'numeric', minute: '2-digit' })
                      return (
                        <div key={s.id} className="flex items-center justify-between px-4 py-2.5 hover:bg-gray-50">
                          <div>
                            <p className="text-sm text-gray-800 font-medium">{dateStr} at {timeStr}</p>
                            <p className="text-xs text-gray-400">{s.messageCount} message{s.messageCount !== 1 ? 's' : ''}</p>
                          </div>
                          <button
                            onClick={() => resumeSession(s)}
                            disabled={resuming}
                            className="text-xs font-semibold text-[#0033A0] hover:underline disabled:opacity-50 flex items-center gap-1"
                          >
                            {resuming ? <Loader2 className="w-3 h-3 animate-spin" /> : <RotateCcw className="w-3 h-3" />}
                            Resume
                          </button>
                        </div>
                      )
                    })
                  )}
                  <div className="px-4 py-2.5 bg-gray-50">
                    <button
                      onClick={() => enterMode(mode)}
                      className="flex items-center gap-1.5 text-xs font-semibold text-gray-500 hover:text-gray-700"
                    >
                      <Plus className="w-3.5 h-3.5" />
                      Start new session
                    </button>
                  </div>
                </div>
              )}
            </div>
          )}
        </div>

        {/* Docs panel */}
        <div className="bg-white border-t border-gray-200">
          <button
            onClick={() => setDocsOpen(v => !v)}
            className="w-full flex items-center justify-between px-4 py-3 text-sm font-medium text-gray-600 hover:bg-gray-50 transition-colors"
          >
            <div className="flex items-center gap-2">
              <FileText className="w-4 h-4 text-gray-400" />
              <span>Study Materials</span>
              <span className="text-xs bg-gray-100 text-gray-500 px-2 py-0.5 rounded-full">
                {docs.length} doc{docs.length !== 1 ? 's' : ''}
              </span>
            </div>
            {docsOpen ? <ChevronUp className="w-4 h-4 text-gray-400" /> : <ChevronDown className="w-4 h-4 text-gray-400" />}
          </button>
          {docsOpen && <DocsPanel docs={docs} uploading={uploading} uploadError={uploadError} fileInputRef={fileInputRef} onUpload={handleUpload} onRemove={removeDoc} isDragOver={isDragOver} onDragOver={e => { e.preventDefault(); setIsDragOver(true) }} onDragLeave={() => setIsDragOver(false)} onDrop={e => { e.preventDefault(); setIsDragOver(false); const f = e.dataTransfer.files[0]; if (f) handleUpload(f) }} />}
          <input ref={fileInputRef} type="file" accept=".pdf,.txt,.md" className="hidden" onChange={e => { if (e.target.files?.[0]) handleUpload(e.target.files[0]) }} />
        </div>
      </div>
    )
  }

  // ── SCREEN: WRAP-UP ────────────────────────────────────────────────────────
  if (screen === 'wrapup') {
    const Icon = currentModeConfig.icon
    const elapsedMs = Date.now() - sessionStartRef.current
    const elapsedMin = Math.floor(elapsedMs / 60000)
    const elapsedSec = Math.floor((elapsedMs % 60000) / 1000)
    const durationStr = elapsedMin > 0 ? `${elapsedMin}m ${elapsedSec}s` : `${elapsedSec}s`
    return (
      <div className="flex flex-col h-full bg-gray-50 rounded-2xl overflow-hidden border border-gray-200 items-center justify-center p-4 sm:p-8 overflow-y-auto">
        <div className="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mb-4">
          <CheckCircle className="w-8 h-8 text-green-600" />
        </div>
        <h2 className="text-xl font-bold text-gray-900 mb-1">Session Complete</h2>
        {mode === 'quiz' && quizScore.total > 0 ? (
          <div className="text-center mb-6">
            <p className="text-3xl font-bold text-gray-900 mb-1">
              {quizScore.correct}/{quizScore.total}
            </p>
            <p className="text-sm text-gray-500">
              questions correct in{' '}
              <span className={`font-medium ${currentModeConfig.color}`}>{currentModeConfig.label}</span> mode
            </p>
            {quizScore.total >= 5 && (
              <p className="text-xs mt-1 text-gray-400">
                {Math.round((quizScore.correct / quizScore.total) * 100)}% accuracy
              </p>
            )}
          </div>
        ) : (
          <p className="text-sm text-gray-500 mb-6 text-center">
            Great work! You exchanged {messageCount} message{messageCount !== 1 ? 's' : ''} in{' '}
            <span className={`font-medium ${currentModeConfig.color}`}>{currentModeConfig.label}</span> mode.
          </p>
        )}

        <div className={`flex items-center gap-2 px-4 py-2.5 rounded-xl ${currentModeConfig.bg} mb-2`}>
          <Icon className={`w-5 h-5 ${currentModeConfig.color}`} />
          <span className={`text-sm font-medium ${currentModeConfig.color}`}>{currentModeConfig.label} mode</span>
        </div>
        <p className="text-xs text-gray-400 mb-6">Session time: {durationStr}</p>

        {/* FIX-17: Quiz question review — show missed questions with Re-quiz option */}
        {mode === 'quiz' && quizLog.length > 0 && (() => {
          const missed = quizLog.filter(q => !q.correct)
          return (
            <div className="w-full max-w-xs mb-5">
              {missed.length > 0 ? (
                <div className="bg-red-50 rounded-xl border border-red-100 px-4 py-3 text-left">
                  <p className="text-xs font-semibold text-red-700 mb-2">
                    {missed.length} question{missed.length !== 1 ? 's' : ''} to review
                  </p>
                  <div className="space-y-2 mb-3">
                    {missed.map((q, i) => (
                      <div key={i} className="text-xs text-red-800 bg-white rounded-lg border border-red-100 px-3 py-2">
                        <p className="font-medium leading-snug line-clamp-3">{q.question}</p>
                        <p className="text-red-500 mt-1">Your answer: {q.userAnswer}</p>
                      </div>
                    ))}
                  </div>
                  <button
                    onClick={() => {
                      // Seed a new quiz session with only the missed questions pre-prompted
                      const missedTopics = missed.map((q, i) => `${i + 1}. ${q.question}`).join('\n')
                      const seedMsg: Message = {
                        id: Date.now().toString(),
                        role: 'user',
                        content: `Re-quiz me only on these questions I got wrong:\n${missedTopics}`,
                      }
                      setMessages([seedMsg])
                      setWrapupSummary('')
                      setBackgroundSummary('')
                      setSummaryLoading(false)
                      setQuizScore({ correct: 0, total: 0 })
                      setQuizLog([])
                      sessionIdRef.current = null
                      setSessionId(null)
                      setScreen('chat')
                    }}
                    className="w-full flex items-center justify-center gap-1.5 text-xs font-semibold text-red-700 bg-red-100 hover:bg-red-200 rounded-lg px-3 py-1.5 transition-colors"
                  >
                    <RotateCcw className="w-3.5 h-3.5" />
                    Re-quiz on missed questions
                  </button>
                </div>
              ) : (
                <div className="bg-emerald-50 rounded-xl border border-emerald-100 px-4 py-3 text-center">
                  <p className="text-xs font-semibold text-emerald-700">Perfect score! All {quizLog.length} questions correct.</p>
                </div>
              )}
            </div>
          )
        })()}

        {/* Fix 12: AI-generated session summary */}
        {(summaryLoading || wrapupSummary) && (
          <div className="w-full max-w-xs bg-white rounded-xl border border-gray-200 px-4 py-3 text-left mb-5">
            {summaryLoading && !wrapupSummary ? (
              <div className="flex items-center gap-2 text-gray-400 text-xs">
                <Loader2 className="w-3.5 h-3.5 animate-spin" />
                Generating summary...
              </div>
            ) : (
              <ReactMarkdown
                components={{
                  p: ({ children }) => <p className="text-xs text-gray-700 leading-relaxed mb-1 last:mb-0">{children}</p>,
                  strong: ({ children }) => <strong className="font-semibold text-gray-900">{children}</strong>,
                }}
              >
                {wrapupSummary}
              </ReactMarkdown>
            )}
          </div>
        )}

        {wrapupSummary && !summaryLoading && (
          <div className="flex items-center flex-wrap gap-2 mb-4 justify-center">
            <button
              onClick={() => navigator.clipboard.writeText(wrapupSummary)}
              className="flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-900 border border-gray-200 hover:border-gray-400 bg-white rounded-lg px-3 py-1.5 font-medium transition-all"
            >
              <Copy className="w-3.5 h-3.5" />
              Copy
            </button>
            <button
              onClick={() => {
                const date = new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })
                const modeLabel = currentModeConfig.label
                const header = `Study Session Summary — ${modeLabel} mode\n${date}\n\n`
                const blob = new Blob([header + wrapupSummary], { type: 'text/plain' })
                const url = URL.createObjectURL(blob)
                const a = document.createElement('a')
                a.href = url
                a.download = `study-summary-${date.replace(/,?\s+/g, '-').toLowerCase()}.txt`
                a.click()
                URL.revokeObjectURL(url)
              }}
              className="flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-900 border border-gray-200 hover:border-gray-400 bg-white rounded-lg px-3 py-1.5 font-medium transition-all"
            >
              <Download className="w-3.5 h-3.5" />
              Download
            </button>
            <a
              href={`mailto:${userEmail}?subject=${encodeURIComponent('My Study Session Summary')}&body=${encodeURIComponent(`Hi,\n\nHere's my Study Buddy session summary:\n\n${wrapupSummary}`)}`}
              className="flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-900 border border-gray-200 hover:border-gray-400 bg-white rounded-lg px-3 py-1.5 font-medium transition-all"
            >
              <Mail className="w-3.5 h-3.5" />
              Email me
            </a>
          </div>
        )}

        {/* Session saved confirmation */}
        {messageCount >= 3 && (
          <p className="text-xs text-gray-400 mb-4 flex items-center gap-1.5">
            <CheckCircle className="w-3.5 h-3.5 text-green-500 flex-shrink-0" />
            Session saved to your progress.
          </p>
        )}

        <p className="text-xs font-bold text-gray-400 uppercase tracking-widest mb-3">What&apos;s next?</p>
        <div className="flex flex-col gap-3 w-full max-w-xs">
          <button
            onClick={() => {
              setMessages([])
              setWrapupSummary('')
              setBackgroundSummary('')
              setSummaryLoading(false)
              setQuizScore({ correct: 0, total: 0 })
              setQuizLog([])
              // New session will be created on first send
              sessionIdRef.current = null
              setSessionId(null)
              setScreen('chat')
            }}
            className="flex items-center justify-center gap-2 px-4 py-2.5 bg-[#0033A0] text-white rounded-xl font-medium text-sm hover:bg-[#002580] transition-colors"
          >
            <RotateCcw className="w-4 h-4" />
            Study Again
          </button>
          <button
            onClick={() => {
              setMessages([])
              setWrapupSummary('')
              setBackgroundSummary('')
              setSummaryLoading(false)
              setQuizScore({ correct: 0, total: 0 })
              setQuizLog([])
              setScreen('select')
            }}
            className="flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-gray-200 text-gray-700 rounded-xl font-medium text-sm hover:bg-gray-50 transition-colors"
          >
            Switch Mode
          </button>
          {onDone ? (
            <button
              onClick={onDone}
              className="flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-gray-200 text-gray-500 rounded-xl font-medium text-sm hover:bg-gray-50 transition-colors"
            >
              Back to Course
            </button>
          ) : (
            <a
              href="/tools"
              className="flex items-center justify-center gap-2 px-4 py-2.5 bg-white border border-gray-200 text-gray-500 rounded-xl font-medium text-sm hover:bg-gray-50 transition-colors"
            >
              Browse More Tools
            </a>
          )}
        </div>
      </div>
    )
  }

  // ── SCREEN: CHAT ───────────────────────────────────────────────────────────

  // Fix 5: Updated per-mode welcome messages
  const defaultWelcome =
    mode === 'quiz'
      ? `Ready to quiz you on ${courseName ?? 'your materials'}. Tap the button below when you're ready — I'll ask one question at a time and explain each answer.`
      : mode === 'flashcards'
      ? `Let's drill the key terms${courseName ? ` from ${courseName}` : ''}. Tap below to start — I'll show the question first, then reveal the answer when you respond.`
      : mode === 'tutor'
      ? `Ask me anything about your course material.`
      : mode === 'socratic'
      ? `Tell me what topic you're working on and we'll reason through it together — I'll only ask questions.`
      : mode === 'teach-back'
      ? `You're the teacher. Pick a topic and start explaining it to me — I'll ask questions until I really understand.`
      : mode === 'debate'
      ? `State your position on any topic. I'll argue the other side as hard as I can.`
      : mode === 'essay'
      ? `Paste your draft or describe your essay challenge. I'll give you structured feedback across thesis, argument, evidence, and prose.`
      : `Ready. What do you want to work on?`

  return (
    <div className="flex flex-col h-full bg-gray-50 rounded-2xl overflow-hidden border border-gray-200">
      {/* Chat header */}
      <div className="bg-white border-b border-gray-200 px-3 py-2.5 flex items-center gap-2">
        {/* Fix 3: back arrow guards against losing chat */}
        <button
          onClick={() => {
            if (messages.length > 2) {
              setPendingModeSwitch('__back__')
            } else {
              setMessages([])
              setScreen('select')
            }
          }}
          className="w-8 h-8 rounded-lg flex items-center justify-center text-gray-400 hover:text-gray-700 hover:bg-gray-100 transition-colors flex-shrink-0"
        >
          <ArrowLeft className="w-4 h-4" />
        </button>

        {/* Mode pills */}
        <div className="flex gap-1.5 flex-1 overflow-x-auto scrollbar-none">
          {MODES.map(m => {
            const Icon = m.icon
            return (
              <button
                key={m.id}
                // Fix 3: guard mode switches against losing chat
                onClick={() => {
                  if (m.id === mode) return
                  if (messages.length > 2) {
                    setPendingModeSwitch(m.id)
                  } else {
                    setMode(m.id)
                    setMessages([])
                  }
                }}
                className={`flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium whitespace-nowrap transition-all flex-shrink-0 ${
                  m.id === mode
                    ? `${m.activePill} text-white shadow-sm`
                    : 'bg-gray-100 text-gray-500 hover:bg-gray-200'
                }`}
              >
                <Icon className="w-3.5 h-3.5" />
                {m.label}
              </button>
            )
          })}
        </div>

        {/* Wrap Up button */}
        <button
          onClick={() => {
            if (messageCount === 0) return
            if (backgroundSummary) {
              setWrapupSummary(backgroundSummary)
            } else {
              void generateSummary(messages, masteryMap)
            }
            setScreen('wrapup')
          }}
          disabled={messageCount === 0}
          title="End your session and get an AI summary"
          className="flex items-center gap-1.5 text-xs text-gray-500 hover:text-gray-900 border border-gray-200 hover:border-gray-400 bg-white rounded-lg px-2.5 py-1.5 font-medium whitespace-nowrap disabled:opacity-25 transition-all flex-shrink-0"
        >
          <CheckCircle className="w-3.5 h-3.5" />
          Wrap Up
        </button>
      </div>

      {/* Fix 3: Mode switch confirmation banner */}
      {pendingModeSwitch && (
        <div className="flex items-center justify-between gap-3 bg-gray-900 text-white px-4 py-2.5 text-sm">
          <span className="font-medium">Switching modes will clear this chat.</span>
          <div className="flex items-center gap-2 flex-shrink-0">
            <button
              onClick={() => setPendingModeSwitch(null)}
              className="text-gray-300 hover:text-white px-3 py-1 rounded-lg text-xs font-medium"
            >
              Keep chat
            </button>
            <button
              onClick={() => {
                if (pendingModeSwitch === '__back__') {
                  setMessages([])
                  setScreen('select')
                } else {
                  setMode(pendingModeSwitch as Mode)
                  setMessages([])
                }
                setPendingModeSwitch(null)
              }}
              className="bg-white text-gray-900 px-3 py-1 rounded-lg text-xs font-semibold hover:bg-gray-100"
            >
              Switch anyway
            </button>
          </div>
        </div>
      )}


      {/* Mode banner (for challenge modes) */}
      {currentModeConfig.banner && (
        <div className={`flex items-start gap-2.5 px-4 py-2.5 border-b text-xs ${currentModeConfig.banner.color}`}>
          {(() => { const BannerIcon = currentModeConfig.banner!.icon; return <BannerIcon className="w-3.5 h-3.5 flex-shrink-0 mt-0.5" /> })()}
          <span>{currentModeConfig.banner.text}</span>
        </div>
      )}

      {/* Teach Back phase progress bar (Phase 1: < 5 user messages) */}
      {mode === 'teach-back' && messages.length > 0 && (() => {
        const tbUserCount = messages.filter(m => m.role === 'user').length
        const inPhase2 = messages.some(m => m.role === 'assistant' && m.content.includes('[Phase 2: Feedback]'))
        if (inPhase2) {
          return (
            <div className="px-4 py-2 bg-purple-100 border-b border-purple-200 flex items-center gap-2">
              <GraduationCap className="w-3.5 h-3.5 text-purple-600 flex-shrink-0" />
              <p className="text-xs text-purple-700 font-semibold">Phase 2: Feedback — honest assessment of your explanation</p>
            </div>
          )
        }
        if (tbUserCount < 5) {
          return (
            <div className="px-4 py-1.5 bg-purple-50 border-b border-purple-100">
              <div className="flex items-center gap-2 mb-1">
                <p className="text-[10px] text-purple-500 font-semibold uppercase tracking-wide">Phase 1: Explain it</p>
                <div className="flex gap-0.5 ml-auto">
                  {[1, 2, 3, 4, 5].map(n => (
                    <div
                      key={n}
                      className={`w-4 h-1.5 rounded-full transition-colors ${n <= tbUserCount ? 'bg-purple-500' : 'bg-purple-200'}`}
                    />
                  ))}
                </div>
              </div>
              <p className="text-[10px] text-purple-600">Keep going — feedback unlocks after {5 - tbUserCount} more exchange{5 - tbUserCount !== 1 ? 's' : ''}</p>
            </div>
          )
        }
        return (
          <div className="px-4 py-1.5 bg-purple-50 border-b border-purple-100 flex items-center gap-2">
            <div className="flex gap-0.5">
              {[1, 2, 3, 4, 5].map(n => (
                <div key={n} className="w-4 h-1.5 rounded-full bg-purple-500" />
              ))}
            </div>
            <p className="text-[10px] text-purple-600 font-medium">Ready for feedback — say &quot;How did I do?&quot; when you&apos;re done explaining</p>
          </div>
        )
      })()}

      {/* Learning Objectives Mastery — only shown when courseId is set and we have signals */}
      {courseId && Object.keys(masteryMap).length > 0 && (
        <div className="border-b border-gray-100">
          <button
            onClick={() => setMasteryOpen(v => !v)}
            className="w-full flex items-center justify-between px-4 py-2 text-xs font-medium text-gray-500 hover:bg-gray-50 transition-colors"
          >
            <div className="flex items-center gap-1.5">
              <GraduationCap className="w-3.5 h-3.5 text-gray-400" />
              <span>Learning Objectives</span>
              <span className="flex items-center gap-1 ml-1">
                {Object.values(masteryMap).filter(v => v === 'green').length > 0 && (
                  <span className="flex items-center gap-0.5 text-emerald-600">
                    <span className="w-2 h-2 rounded-full bg-emerald-500 inline-block" />
                    {Object.values(masteryMap).filter(v => v === 'green').length} mastered
                  </span>
                )}
                {Object.values(masteryMap).filter(v => v === 'yellow').length > 0 && (
                  <span className="flex items-center gap-0.5 text-amber-600 ml-2">
                    <span className="w-2 h-2 rounded-full bg-amber-400 inline-block" />
                    {Object.values(masteryMap).filter(v => v === 'yellow').length} in progress
                  </span>
                )}
              </span>
            </div>
            {masteryOpen ? <ChevronUp className="w-3.5 h-3.5 text-gray-400" /> : <ChevronDown className="w-3.5 h-3.5 text-gray-400" />}
          </button>
          {masteryOpen && (
            <div className="px-4 pb-3 space-y-1">
              {Object.entries(masteryMap).map(([id, quality]) => (
                <div key={id} className="flex items-center gap-2 text-xs text-gray-600">
                  <span className={`w-2 h-2 rounded-full flex-shrink-0 ${quality === 'green' ? 'bg-emerald-500' : 'bg-amber-400'}`} />
                  <span className="font-mono text-[10px] text-gray-400">{id}</span>
                  <span className={quality === 'green' ? 'text-emerald-700 font-medium' : 'text-amber-700'}>
                    {quality === 'green' ? 'Mastered' : 'In progress'}
                  </span>
                </div>
              ))}
              <p className="text-[10px] text-gray-400 pt-1">Tracked automatically as you study</p>
            </div>
          )}
        </div>
      )}

      {/* Difficulty Bias Toggle */}
      <div className="border-b border-gray-100 px-3 py-1.5 flex items-center justify-between gap-2">
        <span className="text-xs text-gray-400 font-medium flex-shrink-0">Difficulty</span>
        <div className="flex items-center gap-1 flex-wrap justify-end">
          <button
            onClick={() => setDifficultyBias(v => v === 'easier' ? null : 'easier')}
            className={`px-2 py-0.5 rounded-full text-xs font-medium transition-all whitespace-nowrap ${
              difficultyBias === 'easier'
                ? 'bg-sky-100 text-sky-700 ring-1 ring-sky-300'
                : 'text-gray-400 hover:text-sky-600 hover:bg-sky-50'
            }`}
          >
            ↓ Easier
          </button>
          <button
            onClick={() => setDifficultyBias(null)}
            className={`px-2 py-0.5 rounded-full text-xs font-medium transition-all ${
