import { NextRequest, NextResponse } from 'next/server'
import { prisma } from '../../../lib/prisma'
import { redis } from '../../../lib/redis'
import { requireAdminUser, isAuthFailure } from '../../../lib/server-auth'

const CACHE_TTL_SECONDS = 300 // 5 minutes
const CACHE_KEY = 'admin:stats'

export async function GET(req: NextRequest) {
  try {
    const auth = await requireAdminUser(req)
    if (isAuthFailure(auth)) return auth.response

    // Serve from cache when available
    if (redis) {
      const cached = await redis.get(CACHE_KEY).catch(() => null)
      if (cached) {
        const data = typeof cached === 'string' ? JSON.parse(cached) : cached
        return NextResponse.json({ ...data, cached: true })
      }
    }

    const [totalTools, totalSessions, totalUsers, totalUpvotes] = await Promise.all([
      prisma.tool.count({ where: { published: true, approvalStatus: { not: 'SUSPENDED' } } }),
      prisma.toolSession.count(),
      prisma.user.count(),
      prisma.upvote.count(),
    ])

    const data = { totalTools, totalSessions, totalUsers, totalUpvotes }

    if (redis) {
      redis.set(CACHE_KEY, JSON.stringify(data), { ex: CACHE_TTL_SECONDS }).catch(() => {})
    }

    return NextResponse.json(data)
  } catch (error) {
    console.error('GET /api/admin/stats error:', error)
    return NextResponse.json({ error: 'Failed to fetch stats' }, { status: 500 })
  }
}
