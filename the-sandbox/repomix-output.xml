        { q: "What is Dynamic Epistemic Fallback?", a: "A defense against adversarial prompts — when the AI detects logical inconsistency, an unauthorized request, or prompt injection, it refuses compliance, falls back to baseline knowledge, flags the interaction, and locks the record for human review." },
        { q: "How does algorithmic bias arise in student success models, and how is it mitigated?", a: "Models trained on historical data can encode past systemic inequities, falsely predicting lower success for marginalized groups. Mitigation requires continuous Algorithmic Fairness Testing to identify and neutralize proxy variables for race, gender, or socioeconomic status." },
        { q: "What is the overarching design philosophy of the autonomous AI registrar regarding human roles?", a: "Not to eliminate humans, but to liberate staff from high-volume rote processing — freeing them to focus on complex advising, policy strategy, and empathetic student interventions, while the AI handles deterministic routine tasks." },
      ],
      "Implementation Roadmap": [
        { q: "What are the four phases of the AI registrar implementation roadmap?", a: "Phase 1: Assessment & Data Preparation. Phase 2: Shadow Mode / Parallel Testing. Phase 3: Supervised Execution (Co-Pilot). Phase 4: Autonomous Scaling & Continuous Optimization." },
        { q: "What accuracy benchmark must the AI hit in Shadow Mode before advancing?", a: "95% or higher consistency with human registrar outputs across graduation audits, transfer credit evaluations, and scheduling tasks." },
        { q: "What is 'Shadow Mode' (Parallel Run Testing)?", a: "The AI ingests real-time SIS data but operates in a sandbox — processing the same tasks as human staff simultaneously. Outputs are compared to human results without writing to the production system or affecting students." },
        { q: "How does Phase 3 (Co-Pilot Mode) differ from full autonomy?", a: "Every AI action is queued — a human must explicitly approve before emails are sent or the database is updated. This trains the algorithm through corrections and acculturates staff to workflow validation roles." },
        { q: "What ongoing activities are required post-deployment in Phase 4?", a: "Continuous algorithmic auditing for model drift, performance latency monitoring, API sync stability checks, and updating Policy-as-Code engines as federal regulations evolve." },
      ],
    };

    // Flatten all cards with category tag
    const ALL_CARDS = Object.entries(CATEGORIES).flatMap(([cat, cards]) =>
      cards.map(c => ({ ...c, category: cat }))
    );

    function shuffle(arr) {
      const a = [...arr];
      for (let i = a.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [a[i], a[j]] = [a[j], a[i]];
      }
      return a;
    }

    const CATEGORY_COLORS = {
      "Core Architecture":     { bg: "#0033A0", light: "#e8eef8" },
      "Document Processing":   { bg: "#1d6b44", light: "#e8f5ee" },
      "Course Scheduling":     { bg: "#7b2d8b", light: "#f5ebf8" },
      "Systems Integration":   { bg: "#b45309", light: "#fef3e2" },
      "Compliance & Privacy":  { bg: "#c41e3a", light: "#fde8ec" },
      "Governance & Ethics":   { bg: "#1e5f8b", light: "#e8f2f8" },
      "Implementation Roadmap":{ bg: "#2d6a2d", light: "#eaf5ea" },
    };

    function FlashCard({ card, flipped, onFlip }) {
      const color = CATEGORY_COLORS[card.category] || { bg: "#0033A0", light: "#e8eef8" };
      return (
        <div className="card-container w-full cursor-pointer select-none" style={{ height: "300px" }} onClick={onFlip}>
          <div className={`card-inner ${flipped ? "flipped" : ""}`}>
            {/* Front */}
            <div className="card-face flex flex-col items-center justify-center bg-white border-2 shadow-lg p-8"
                 style={{ borderColor: color.bg + "33" }}>
              <span className="text-xs font-semibold uppercase tracking-widest mb-1" style={{ color: color.bg }}>
                {card.category}
              </span>
              <div className="w-10 h-0.5 mb-4 rounded" style={{ backgroundColor: color.bg + "55" }} />
              <p className="text-lg font-semibold text-gray-800 text-center leading-relaxed">{card.q}</p>
              <span className="mt-6 text-xs text-gray-400">Click to reveal answer</span>
            </div>
            {/* Back */}
            <div className="card-face card-back flex flex-col items-center justify-center shadow-lg p-8"
                 style={{ backgroundColor: color.bg }}>
              <span className="text-xs font-semibold uppercase tracking-widest mb-1 opacity-60 text-white">Answer</span>
              <div className="w-10 h-0.5 mb-4 rounded bg-white opacity-30" />
              <p className="text-base font-medium text-white text-center leading-relaxed">{card.a}</p>
            </div>
          </div>
        </div>
      );
    }

    function CategoryFilter({ selected, onChange }) {
      const allCats = ["All", ...Object.keys(CATEGORIES)];
      return (
        <div className="flex flex-wrap gap-2 justify-center mb-6">
          {allCats.map(cat => {
            const color = cat === "All" ? { bg: "#374151" } : (CATEGORY_COLORS[cat] || { bg: "#0033A0" });
            const isActive = selected === cat;
            return (
              <button
                key={cat}
                onClick={() => onChange(cat)}
                className="px-3 py-1.5 rounded-full text-xs font-semibold border transition"
                style={{
                  backgroundColor: isActive ? color.bg : "white",
                  color: isActive ? "white" : color.bg,
                  borderColor: color.bg,
                }}
              >
                {cat} {cat !== "All" && `(${CATEGORIES[cat].length})`}
              </button>
            );
          })}
        </div>
      );
    }

    function EditModal({ cards, onSave, onClose }) {
      const [text, setText] = useState(
        cards.map(c => `${c.category}|${c.q}|${c.a}`).join("\n")
      );
      const [error, setError] = useState("");

      function handleSave() {
        const lines = text.trim().split("\n").filter(l => l.trim());
        const parsed = [];
        for (let line of lines) {
          const parts = line.split("|");
          if (parts.length < 3) {
            setError(`Bad line: "${line.slice(0,50)}..." — use Category|Question|Answer format`);
            return;
          }
          parsed.push({ category: parts[0].trim(), q: parts[1].trim(), a: parts.slice(2).join("|").trim() });
        }
        if (parsed.length === 0) { setError("Add at least one card."); return; }
        onSave(parsed);
      }

      return (
        <div className="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center z-40 p-4">
          <div className="bg-white rounded-2xl shadow-2xl w-full max-w-2xl flex flex-col" style={{ maxHeight: "90vh" }}>
            <div className="flex items-center justify-between px-6 py-4 border-b">
              <h2 className="text-lg font-bold text-gray-800">Edit Flashcards</h2>
              <button onClick={onClose} className="text-gray-400 hover:text-gray-600 text-2xl leading-none">&times;</button>
            </div>
            <div className="px-6 py-3 bg-blue-50 text-sm text-blue-700">
              One card per line: <code className="font-mono bg-blue-100 px-1 rounded">Category|Question|Answer</code>
            </div>
            <textarea
              className="flex-1 font-mono text-xs p-4 resize-none outline-none border-none overflow-y-auto"
              style={{ minHeight: "300px" }}
              value={text}
              onChange={e => { setText(e.target.value); setError(""); }}
            />
            {error && <p className="px-6 py-2 text-red-600 text-sm">{error}</p>}
            <div className="flex justify-end gap-3 px-6 py-4 border-t">
              <button onClick={onClose} className="px-4 py-2 rounded-lg border border-gray-300 text-gray-600 hover:bg-gray-50 font-medium">Cancel</button>
              <button onClick={handleSave} className="px-6 py-2 rounded-lg text-white font-semibold" style={{ backgroundColor: "#0033A0" }}>Save Cards</button>
            </div>
          </div>
        </div>
      );
    }

    function App() {
      const [allCards, setAllCards] = useState(ALL_CARDS);
      const [categoryFilter, setCategoryFilter] = useState("All");
      const [deck, setDeck] = useState([]);
      const [index, setIndex] = useState(0);
      const [flipped, setFlipped] = useState(false);
      const [known, setKnown] = useState([]);
      const [unsure, setUnsure] = useState([]);
      const [showEdit, setShowEdit] = useState(false);
      const [finished, setFinished] = useState(false);

      function buildDeck(cards, filter) {
        const filtered = filter === "All" ? cards : cards.filter(c => c.category === filter);
        return shuffle(filtered);
      }

      function startFresh(cards, filter) {
        const d = buildDeck(cards, filter);
        setDeck(d);
        setIndex(0);
        setFlipped(false);
        setKnown([]);
        setUnsure([]);
        setFinished(false);
      }

      useEffect(() => { startFresh(allCards, categoryFilter); }, []);

      function handleCategoryChange(cat) {
        setCategoryFilter(cat);
        startFresh(allCards, cat);
      }

      const current = deck[index];

      function handleFlip() { if (!finished && current) setFlipped(f => !f); }

      function handleMark(isKnown) {
        if (!flipped || !current) return;
        if (isKnown) setKnown(k => [...k, current]);
        else setUnsure(u => [...u, current]);
        if (index + 1 >= deck.length) {
          setFinished(true);
        } else {
          setIndex(i => i + 1);
          setFlipped(false);
        }
      }

      function handleSaveCards(newCards) {
        setAllCards(newCards);
        setShowEdit(false);
        startFresh(newCards, categoryFilter);
      }

      function reviewUnsure() {
        if (unsure.length === 0) return;
        setDeck(shuffle(unsure));
        setIndex(0);
        setFlipped(false);
        setKnown([]);
        setUnsure([]);
        setFinished(false);
      }

      const progress = deck.length > 0 ? ((known.length + unsure.length) / deck.length) * 100 : 0;
      const score = deck.length > 0 ? Math.round((known.length / deck.length) * 100) : 0;

      return (
        <div className="min-h-screen bg-gray-50 flex flex-col">
          {/* Header */}
          <header className="text-white py-5 px-6 shadow-md" style={{ backgroundColor: "#0033A0" }}>
            <div className="max-w-2xl mx-auto flex items-center justify-between">
              <div>
                <h1 className="text-xl font-bold tracking-tight">AI Registrar System</h1>
                <p className="text-blue-200 text-sm mt-0.5">
                  {allCards.length} cards across {Object.keys(CATEGORIES).length} topics
                </p>
              </div>
              <button
                onClick={() => setShowEdit(true)}
                className="bg-white text-blue-900 font-semibold text-sm px-4 py-2 rounded-lg hover:bg-blue-50 transition"
              >
                ✏️ Edit Cards
              </button>
            </div>
          </header>

          <main className="flex-1 flex flex-col items-center px-4 py-6 max-w-2xl mx-auto w-full">
            <CategoryFilter selected={categoryFilter} onChange={handleCategoryChange} />

            {deck.length === 0 ? (
              <div className="text-center text-gray-500 mt-16">No cards in this category.</div>
            ) : !finished ? (
              <>
                {/* Progress */}
                <div className="w-full mb-5">
                  <div className="flex justify-between text-xs text-gray-500 mb-1">
                    <span>Card {index + 1} of {deck.length}</span>
                    <span className="text-green-600 font-medium">{known.length} known</span>
                  </div>
                  <div className="w-full bg-gray-200 rounded-full h-2">
                    <div className="h-2 rounded-full transition-all duration-500"
                         style={{ width: `${progress}%`, backgroundColor: "#0033A0" }} />
                  </div>
                </div>

                {current && <FlashCard card={current} flipped={flipped} onFlip={handleFlip} />}

                {!flipped ? (
                  <button
                    onClick={handleFlip}
                    className="mt-6 px-8 py-3 rounded-xl text-white font-semibold shadow hover:opacity-90 transition"
                    style={{ backgroundColor: "#0033A0" }}
                  >
                    Flip Card
                  </button>
                ) : (
                  <div className="mt-6 flex gap-4 w-full justify-center">
                    <button
                      onClick={() => handleMark(false)}
                      className="flex-1 max-w-xs py-3 rounded-xl bg-red-100 text-red-700 font-semibold hover:bg-red-200 transition border border-red-200"
                    >
                      😕 Still Learning
                    </button>
                    <button
                      onClick={() => handleMark(true)}
                      className="flex-1 max-w-xs py-3 rounded-xl bg-green-100 text-green-700 font-semibold hover:bg-green-200 transition border border-green-200"
                    >
                      ✅ Got It!
                    </button>
                  </div>
                )}
                <p className="mt-4 text-xs text-gray-400">Click the card or button to flip</p>
              </>
            ) : (
              /* Results */
              <div className="w-full text-center">
                <div className="bg-white rounded-2xl shadow-lg p-8 mb-6">
                  <div className="text-5xl mb-4">{score === 100 ? "🎉" : score >= 70 ? "📊" : "📚"}</div>
                  <h2 className="text-2xl font-bold text-gray-800 mb-2">Round Complete!</h2>
                  <p className="text-gray-500 mb-6">
                    {categoryFilter === "All" ? "All topics" : categoryFilter}
                  </p>
                  <div className="flex justify-center gap-8 mb-6">
                    <div className="text-center">
                      <p className="text-4xl font-bold text-green-500">{known.length}</p>
                      <p className="text-sm text-gray-500 mt-1">Got It</p>
                    </div>
                    <div className="text-center">
                      <p className="text-4xl font-bold text-red-400">{unsure.length}</p>
                      <p className="text-sm text-gray-500 mt-1">Still Learning</p>
                    </div>
                    <div className="text-center">
                      <p className="text-4xl font-bold" style={{ color: "#0033A0" }}>{score}%</p>
                      <p className="text-sm text-gray-500 mt-1">Score</p>
                    </div>
                  </div>
                  {score === 100 && (
                    <div className="bg-green-50 border border-green-200 text-green-700 rounded-xl py-3 px-4 text-sm font-medium mb-4">
                      🌟 Perfect round — you know all the cards!
                    </div>
                  )}
                </div>

                <div className="flex flex-col sm:flex-row gap-3 justify-center">
                  {unsure.length > 0 && (
                    <button
                      onClick={reviewUnsure}
                      className="px-6 py-3 rounded-xl bg-amber-100 text-amber-800 font-semibold hover:bg-amber-200 transition border border-amber-200"
                    >
                      🔁 Review {unsure.length} Missed Card{unsure.length !== 1 ? "s" : ""}
                    </button>
                  )}
                  <button
                    onClick={() => startFresh(allCards, categoryFilter)}
                    className="px-6 py-3 rounded-xl text-white font-semibold hover:opacity-90 transition"
                    style={{ backgroundColor: "#0033A0" }}
                  >
                    🔀 Shuffle & Restart
                  </button>
                </div>

                {/* Category breakdown */}
                <div className="mt-6 bg-white rounded-2xl shadow p-6 text-left">
                  <h3 className="font-bold text-gray-700 mb-3 text-sm uppercase tracking-wide">Category Breakdown</h3>
                  {Object.entries(CATEGORIES).map(([cat, catCards]) => {
                    const catKnown = known.filter(c => c.category === cat).length;
                    const catTotal = deck.filter(c => c.category === cat).length;
                    if (catTotal === 0) return null;
                    const color = CATEGORY_COLORS[cat] || { bg: "#0033A0" };
                    const pct = Math.round((catKnown / catTotal) * 100);
                    return (
                      <div key={cat} className="mb-3">
                        <div className="flex justify-between text-xs mb-1">
                          <span className="font-medium text-gray-700">{cat}</span>
                          <span style={{ color: color.bg }}>{catKnown}/{catTotal} ({pct}%)</span>
                        </div>
                        <div className="w-full bg-gray-100 rounded-full h-1.5">
                          <div className="h-1.5 rounded-full" style={{ width: `${pct}%`, backgroundColor: color.bg }} />
                        </div>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </main>

          {showEdit && (
            <EditModal
              cards={allCards}
              onSave={handleSaveCards}
              onClose={() => setShowEdit(false)}
            />
          )}
        </div>
      );
    }

    ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
