<file path="app/components/ClientProviders.tsx">
'use client'

import { useEffect, useState } from 'react'
import { usePathname } from 'next/navigation'
import { AuthProvider, useAuth } from '../lib/auth-context'
import { PresenceProvider } from '../lib/presence-context'
import { AudioPlayerProvider } from '../hooks/useAudioPlayer'
import Header from './Header'
import ConciergePanel from './ConciergePanel'
import PresenceWidget from './PresenceWidget'
import CallOverlay from './CallOverlay'
import AudioPlayerBar from './AudioPlayerBar'
import PlatformAnnouncementBanner from './PlatformAnnouncementBanner'
import SuspendedAccountScreen from './SuspendedAccountScreen'
import ViewingAsBanner from './ViewingAsBanner'
import OnboardingModal from './OnboardingModal'

const ONBOARDING_KEY = 'sandbox-onboarding-done'

function AppShell({ children }: { children: React.ReactNode }) {
  const pathname = usePathname()
  const { currentUser, accountSuspended, suspensionReason, isGuest } = useAuth()
  const [showOnboarding, setShowOnboarding] = useState(false)
  const isPlaygroundRoute = pathname.startsWith('/playground')
  const isSignupRoute = pathname.startsWith('/signup')
  const isOnboardRoute = pathname.startsWith('/onboard')
  // Show the public landing page shell when the user has no session and is at /
  const isGuestHomePage = isGuest && pathname === '/'

  useEffect(() => {
    if (isGuest || isOnboardRoute || isSignupRoute) return
    try {
      const key = `${ONBOARDING_KEY}-${currentUser.email}`
      if (!localStorage.getItem(key)) {
        setShowOnboarding(true)
      }
    } catch {}
  }, [currentUser.email, isGuest, isOnboardRoute, isSignupRoute])

  function dismissOnboarding() {
    try { localStorage.setItem(`${ONBOARDING_KEY}-${currentUser.email}`, '1') } catch {}
    setShowOnboarding(false)
  }

  if (accountSuspended && !isSignupRoute) {
    return (
      <>
        <AudioPlayerBar />
        <SuspendedAccountScreen reason={suspensionReason} />
      </>
    )
  }

  if (isSignupRoute || isGuestHomePage) {
    return <>{children}</>
  }

  return (
    <>
      <PlatformAnnouncementBanner />
      {isPlaygroundRoute ? null : <Header />}
      {isPlaygroundRoute ? null : <ViewingAsBanner />}
      <main className={isPlaygroundRoute ? 'pb-20' : 'pb-20 lg:pr-80'}>{children}</main>
      {isPlaygroundRoute ? null : <ConciergePanel />}
      {isPlaygroundRoute ? null : <PresenceWidget />}
      <AudioPlayerBar />
      <CallOverlay />
      {showOnboarding && (
        <OnboardingModal
          userName={currentUser.name}
          role={currentUser.role}
          onDismiss={dismissOnboarding}
        />
      )}
    </>
  )
}

export default function ClientProviders({ children }: { children: React.ReactNode }) {
  return (
    <AuthProvider>
      <AudioPlayerProvider>
        <PresenceProvider>
          <AppShell>{children}</AppShell>
        </PresenceProvider>
      </AudioPlayerProvider>
    </AuthProvider>
  )
}
