          {/* Where to Focus — students only, live objective progress */}
          {isStudent && (() => {
            const struggling = objectiveProgress
              .filter(p => p.mastery === 'struggling' || (p.attempts > 0 && p.correct < p.attempts * 0.6))
              .slice(0, 4)
            return (
              <div>
                <div className="flex items-center justify-between mb-3">
                  <h2 className="text-xs font-bold text-gray-400 uppercase tracking-widest">Where to Focus</h2>
                  <Link href="/analytics/student" className="text-xs text-[#0033A0] font-semibold hover:underline flex items-center gap-1">
                    My progress <ArrowRight className="w-3 h-3" />
                  </Link>
                </div>
                {struggling.length === 0 ? (
                  <div className="bg-white rounded-xl border border-green-200 px-4 py-3 flex items-center gap-3">
                    <div className="w-6 h-6 bg-green-50 border border-green-200 rounded-full flex items-center justify-center flex-shrink-0 text-green-600 text-xs font-bold">
                      ✓
                    </div>
                    <p className="text-sm text-green-700 font-medium">You&apos;re on track across all courses</p>
                  </div>
                ) : (
                  <div className="space-y-2">
                    {struggling.map((p, i) => {
                      const title = p.objective?.title ?? 'Learning objective'
                      const courseCode = p.objective?.course?.courseCode ?? ''
                      return (
                        <div key={i} className="bg-white rounded-xl border border-amber-100 px-4 py-3 flex items-center gap-3">
                          <div className="w-7 h-7 bg-amber-50 border border-amber-200 rounded-full flex items-center justify-center flex-shrink-0">
                            <Target className="w-3.5 h-3.5 text-amber-600" />
                          </div>
                          <div className="flex-1 min-w-0">
                            <div className="text-sm font-semibold text-gray-900 truncate">
                              {courseCode && <span className="text-[#0033A0] font-bold mr-1">{courseCode}</span>}
                              {title}
                            </div>
                            <div className="text-xs text-gray-500">{p.attempts} attempt{p.attempts !== 1 ? 's' : ''}</div>
                          </div>
                          <Link
                            href={`/tools?search=${encodeURIComponent(title)}`}
                            className="text-[10px] font-semibold text-[#0033A0] flex-shrink-0 hover:underline flex items-center gap-1"
                          >
                            Find a tool <ArrowRight className="w-2.5 h-2.5" />
                          </Link>
                        </div>
                      )
                    })}
                  </div>
                )}
              </div>
            )
          })()}

          {/* Suggested For You — students only, moved to position 5 */}
          {isStudent && suggestedTools.length > 0 && (
            <div>
              <div className="mb-3 flex items-center justify-between">
                <div>
                  <h2 className="text-sm font-extrabold text-gray-900">Suggested For You</h2>
                  {suggestedLabel && <p className="text-xs text-gray-400 mt-0.5">{suggestedLabel}</p>}
                </div>
                <Link href="/tools" className="text-xs font-semibold text-[#0033A0] hover:underline flex items-center gap-1">
                  Browse all <ArrowRight className="w-3 h-3" />
                </Link>
              </div>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-3">
                {suggestedTools.map(tool => (
                  <Link
                    key={tool.id}
                    href={`/tools/${tool.id}`}
                    className="group flex flex-col gap-2 rounded-xl border border-gray-200 bg-white p-4 hover:border-[#0033A0]/40 hover:shadow-sm transition-all"
                  >
                    <div className="flex items-center gap-2">
                      <span className={`h-2 w-2 rounded-full flex-shrink-0 ${categoryThumbnailBg[tool.category] ?? 'bg-gray-400'}`} />
                      <span className="text-[10px] font-semibold text-gray-400 uppercase tracking-wide truncate">{tool.category}</span>
                    </div>
                    <p className="text-sm font-semibold text-gray-900 group-hover:text-[#0033A0] transition-colors leading-snug line-clamp-2">{tool.name}</p>
                    {tool.shortDescription && (
                      <p className="text-xs text-gray-500 leading-snug line-clamp-2">{tool.shortDescription}</p>
                    )}
                    <p className="text-[10px] text-gray-400 mt-auto">{tool.creator.name}</p>
                  </Link>
                ))}
              </div>
            </div>
          )}

          {/* Profile card — educators/admins only (students get inline identity in greeting) */}
          {(isEducator || isAdmin) && (
            <div className="bg-white rounded-2xl border border-gray-200 p-6">
              <div className="flex items-start gap-4">
                <div className="w-16 h-16 rounded-full bg-[#0033A0] flex items-center justify-center text-white font-bold text-xl flex-shrink-0">
                  {currentUser.name.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase()}
                </div>
                <div className="flex-1 min-w-0">
                  <h1 className="text-xl font-extrabold text-gray-900">{currentUser.name}</h1>
                  <div className="flex flex-wrap items-center gap-2 mt-1">
                    <span className={`text-xs font-bold px-2 py-0.5 rounded-full ${
                      isEducator ? 'bg-blue-100 text-blue-700' : 'bg-red-100 text-red-700'
                    }`}>{currentUser.role}</span>
                    {educatorProfile && (
                      <span className="text-xs text-gray-500 font-medium">{educatorProfile.title}</span>
                    )}
                  </div>
                  <div className="text-sm text-gray-500 mt-1">{currentUser.department} · {currentUser.college}</div>
                </div>
              </div>
            </div>
          )}

          {showEducatorSetup && (
            <div className="mb-2 rounded-2xl border border-[#0033A0]/20 bg-blue-50 px-5 py-4 flex items-start justify-between gap-4">
              <div className="flex items-start gap-3">
                <div className="w-8 h-8 rounded-xl bg-[#0033A0] flex items-center justify-center flex-shrink-0 mt-0.5">
                  <Sparkles className="w-4 h-4 text-white" />
                </div>
                <div>
                  <p className="text-sm font-bold text-[#0033A0]">Welcome to The Sandbox</p>
                  <p className="text-sm text-blue-700 mt-0.5">
                    Start by creating your course, then build your first AI tool in under 10 minutes.
                  </p>
                  <div className="flex items-center gap-3 mt-3">
                    <Link
                      href="/courses"
                      className="text-xs font-bold text-white bg-[#0033A0] hover:bg-blue-800 px-3 py-1.5 rounded-lg transition-colors"
                    >
                      Set up your course →
                    </Link>
                    <Link
                      href="/studio"
                      className="text-xs font-semibold text-[#0033A0] hover:underline"
                    >
                      Or go straight to Build
                    </Link>
                  </div>
                </div>
              </div>
              <button
                onClick={dismissEducatorSetup}
                className="text-blue-400 hover:text-blue-600 flex-shrink-0"
                aria-label="Dismiss"
              >
                <X className="w-4 h-4" />
              </button>
            </div>
          )}

          {/* Pending grading alert */}
          {pendingGradeCount.length > 0 && (
            <div className="rounded-2xl border border-orange-200 bg-orange-50 p-4">
              <div className="flex items-start gap-3">
                <AlertCircle className="mt-0.5 h-5 w-5 shrink-0 text-orange-500" />
                <div className="flex-1 min-w-0">
                  <p className="text-sm font-bold text-orange-900">
                    {pendingGradeCount.reduce((s, c) => s + c.count, 0)} submission{pendingGradeCount.reduce((s, c) => s + c.count, 0) !== 1 ? 's' : ''} waiting to be graded
                  </p>
                  <div className="mt-1.5 flex flex-wrap gap-2">
                    {pendingGradeCount.map((c) => (
                      <Link
                        key={c.courseId}
                        href={`/courses?course=${c.courseId}&tab=gradebook`}
                        className="inline-flex items-center gap-1.5 rounded-lg bg-orange-100 px-2.5 py-1 text-xs font-semibold text-orange-800 hover:bg-orange-200 transition-colors"
                      >
                        {c.courseCode} — {c.count} to grade
                        <ArrowRight className="h-3 w-3" />
                      </Link>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          )}

          {educatorProfile && (
            <div>
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-xs font-bold text-gray-400 uppercase tracking-widest">Course Health</h2>
                <Link href="/analytics/faculty" className="text-xs font-semibold text-[#0033A0] hover:underline flex items-center gap-1">
                  Full analytics <ArrowRight className="w-3 h-3" />
                </Link>
              </div>

              {educatorProfile.courseHealth.length > 0 ? (
                <div className="space-y-3">
                  {educatorProfile.courseHealth.map((course, i) => (
                    <div key={i} className="bg-white rounded-2xl border border-gray-200 p-4">
                      <div className="flex items-start justify-between gap-2 mb-3">
                        <div>
                          <span className="text-[10px] font-bold uppercase tracking-wider text-[#0033A0]">{course.code}</span>
                          <p className="text-sm font-bold text-gray-900 mt-0.5">{course.title}</p>
                        </div>
                        <div className="text-right flex-shrink-0">
                          <div className="text-xl font-extrabold text-gray-900">{course.avgScore}%</div>
                          <div className="text-[10px] text-gray-400">avg score</div>
                        </div>
                      </div>
                      <div className="grid grid-cols-3 gap-2">
                        <div className="rounded-xl bg-gray-50 p-2.5 text-center">
                          <div className="text-base font-extrabold text-gray-900">{course.enrolled}</div>
                          <div className="text-[10px] text-gray-400 mt-0.5">enrolled</div>
                        </div>
                        <div className="rounded-xl bg-gray-50 p-2.5 text-center">
                          <div className={`text-base font-extrabold ${course.engagementPct >= 80 ? 'text-green-700' : course.engagementPct >= 60 ? 'text-amber-700' : 'text-red-700'}`}>
                            {course.engagementPct}%
                          </div>
                          <div className="text-[10px] text-gray-400 mt-0.5">engaged</div>
                        </div>
                        <div className="rounded-xl bg-gray-50 p-2.5 text-center">
                          <div className={`text-base font-extrabold ${course.atRiskCount === 0 ? 'text-green-700' : 'text-red-700'}`}>
                            {course.atRiskCount}
                          </div>
                          <div className="text-[10px] text-gray-400 mt-0.5">at risk</div>
                        </div>
                      </div>
                      {course.atRiskCount > 0 && (
                        <div className="mt-2.5 flex items-center gap-1.5 text-xs text-red-600">
                          <AlertCircle className="w-3.5 h-3.5 flex-shrink-0" />
                          <span className="font-medium">{course.atRiskCount} student{course.atRiskCount !== 1 ? 's' : ''} may need support</span>
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              ) : (
                <div className="grid grid-cols-2 sm:grid-cols-4 gap-3">
                  <div className="bg-white rounded-xl border border-gray-200 p-4">
                    <div className="flex items-center gap-2 mb-1">
                      <Compass className="w-4 h-4 text-blue-500" />
                      <span className="text-xs text-gray-500 font-medium">Tools Published</span>
                    </div>
                    <div className="text-2xl font-extrabold text-gray-900">{educatorProfile.toolsPublished}</div>
                  </div>
                  <div className="bg-white rounded-xl border border-gray-200 p-4">
                    <div className="flex items-center gap-2 mb-1">
                      <Users className="w-4 h-4 text-green-500" />
                      <span className="text-xs text-gray-500 font-medium">Active Students</span>
                    </div>
                    <div className="text-2xl font-extrabold text-gray-900">{educatorProfile.activeStudents}</div>
                  </div>
                  <div className="bg-white rounded-xl border border-gray-200 p-4">
                    <div className="flex items-center gap-2 mb-1">
                      <TrendingUp className="w-4 h-4 text-green-500" />
                      <span className="text-xs text-gray-500 font-medium">Avg Score</span>
                    </div>
                    <div className="text-2xl font-extrabold text-gray-900">{educatorProfile.avgScore ?? '—'}%</div>
                  </div>
                  <div className="bg-white rounded-xl border border-gray-200 p-4">
                    <div className="flex items-center gap-2 mb-1">
                      <BookOpen className="w-4 h-4 text-indigo-500" />
                      <span className="text-xs text-gray-500 font-medium">Sessions</span>
                    </div>
                    <div className="text-2xl font-extrabold text-gray-900">{educatorProfile.totalSessions}</div>
                  </div>
                </div>
              )}
            </div>
          )}

          {isStudent && (
            <NotebookWidget userEmail={currentUser.email} />
          )}

          {educatorProfile && educatorProfile.atRisk.length > 0 && (
            <div>
              <div className="flex items-center justify-between mb-3">
                <h2 className="text-xs font-bold text-gray-400 uppercase tracking-widest flex items-center gap-2">
                  Needs Attention
                  <span className="text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 rounded-full px-2 py-0.5 normal-case tracking-normal">
                    {educatorProfile.atRisk.length}
                  </span>
                </h2>
                <Link href="/analytics/faculty" className="text-xs text-[#0033A0] font-semibold hover:underline flex items-center gap-1">
                  Full analytics <ArrowRight className="w-3 h-3" />
                </Link>
              </div>
              <div className="space-y-2">
                {educatorProfile.atRisk.map((student, i) => (
                  <div key={i} className="bg-white rounded-xl border border-red-100 px-4 py-3 flex items-center gap-3">
                    <div className="w-7 h-7 bg-red-50 border border-red-200 rounded-full flex items-center justify-center flex-shrink-0">
                      <AlertCircle className="w-3.5 h-3.5 text-red-500" />
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="text-sm font-semibold text-gray-900">{student.name}</div>
                      <div className="text-xs text-gray-500 truncate">{student.detail} · Last seen {student.lastSeen}</div>
                    </div>
                    <span className={`text-[10px] font-bold px-2 py-0.5 rounded-full flex-shrink-0 border ${
                      student.issue === 'low_score'   ? 'bg-red-50 text-red-700 border-red-200' :
                      student.issue === 'no_activity' ? 'bg-amber-50 text-amber-700 border-amber-200' :
                                                        'bg-orange-50 text-orange-700 border-orange-200'
                    }`}>
                      {student.issue === 'low_score' ? 'Low score' : student.issue === 'no_activity' ? 'Inactive' : 'Struggling'}
                    </span>
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>

        {/* â"€â"€ RIGHT COLUMN â"€â"€ */}
        <div className="space-y-5">

          {/* Action Items — students only, promoted to top of right column */}
          {isStudent && <ActionItems />}

          {/* Continue Building nudge */}
          {recentDraft && (
            <Link href={`/publish?edit=${recentDraft.id}`}>
              <div className="rounded-xl border border-[#0033A0]/20 bg-blue-50 p-4 flex items-center gap-3 hover:bg-blue-100 transition-colors">
                <Wand2 className="w-5 h-5 text-[#0033A0] flex-shrink-0" />
                <div className="min-w-0">
                  <p className="text-sm font-semibold text-[#0033A0] truncate">
                    Resume: {recentDraft.name || 'Untitled build'}
                  </p>
                  <p className="text-xs text-gray-500">Continue where you left off</p>
                </div>
                <ArrowRight className="w-4 h-4 text-[#0033A0] ml-auto flex-shrink-0" />
              </div>
            </Link>
          )}

          {/* Coming Up — students: deadline calendar */}
          {studentProfile && studentProfile.upcomingDue.length > 0 && (
            <div className="bg-white rounded-2xl border border-gray-200 overflow-hidden">
              <div className="px-4 py-3 border-b border-gray-100 flex items-center gap-2">
                <Calendar className="w-4 h-4 text-[#0033A0]" />
                <span className="font-bold text-gray-900 text-sm">Coming Up</span>
                {studentProfile.upcomingDue.some(i => i.urgent) && (
                  <span className="ml-auto flex items-center gap-1 text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 rounded-full px-2 py-0.5">
                    <AlertCircle className="w-3 h-3" />
                    {studentProfile.upcomingDue.filter(i => i.urgent).length} urgent
                  </span>
                )}
              </div>
              <div className="divide-y divide-gray-50">
                {studentProfile.upcomingDue.map((item, i) => (
                  <Link
                    key={i}
                    href={`/courses?course=${encodeURIComponent(item.course)}`}
                    className={`px-4 py-2.5 flex items-start gap-3 hover:bg-blue-50/50 transition-colors group ${item.urgent ? 'bg-red-50/40 hover:bg-red-50/60' : ''}`}
                  >
                    <div className={`text-xs font-extrabold mt-0.5 flex-shrink-0 w-10 text-center ${item.urgent ? 'text-red-600' : 'text-[#0033A0]'}`}>
                      {item.date}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="text-xs font-semibold text-gray-900 leading-tight group-hover:text-[#0033A0]">{item.title}</div>
                      <div className="flex items-center gap-1.5 mt-1">
                        <span className="text-[10px] text-gray-400">{item.course}</span>
                        <span className={`text-[10px] font-semibold px-1.5 py-0.5 rounded-full ${typeBadgeStyle(item.type)}`}>{item.type}</span>
                      </div>
                    </div>
                    {item.urgent && <AlertCircle className="w-3.5 h-3.5 text-red-500 flex-shrink-0 mt-0.5" />}
                  </Link>
                ))}
              </div>
              <div className="px-4 py-2.5 border-t border-gray-100 bg-gray-50">
                <Link href="/courses" className="flex items-center gap-1.5 text-xs font-semibold text-[#0033A0] hover:underline">
                  <BookOpen className="w-3.5 h-3.5" /> Course materials <ArrowRight className="w-3 h-3" />
                </Link>
              </div>
            </div>
          )}

          {/* Due-date-aware tool suggestion — students */}
          {studentProfile && (() => {
            const essayDue = studentProfile.upcomingDue.find(d =>
              ['Essay', 'Paper', 'Brief', 'Memo'].includes(d.type) && d.urgent
            )
            const examDue = studentProfile.upcomingDue.find(d =>
              d.type === 'Exam' && d.urgent
            )
            if (!essayDue && !examDue) return null
            const item = essayDue ?? examDue!
            const isEssay = !!essayDue
            return (
              <div className="bg-[#0033A0]/5 border border-[#0033A0]/20 rounded-2xl px-4 py-3 flex items-start gap-3">
                <Sparkles className="w-4 h-4 text-[#0033A0] flex-shrink-0 mt-0.5" />
                <div className="flex-1 min-w-0">
                  <p className="text-xs font-bold text-[#0033A0]">
                    {item.title} due {item.date}
                  </p>
                  <p className="text-xs text-gray-600 mt-0.5">
                    {isEssay
                      ? 'Try Essay Coach or the Assignment Stress Test to sharpen your draft before submitting.'
                      : 'Quiz Me or Flashcards can help you lock in what you know before the exam.'}
                  </p>
                  <Link
                    href={isEssay ? '/tools?q=essay' : '/tools?q=quiz'}
                    className="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-[#0033A0] hover:underline"
                  >
                    Find a tool <ArrowRight className="w-3 h-3" />
                  </Link>
                </div>
              </div>
            )
          })()}

          {/* Quick links — reduced visual weight for students */}
          <div className="bg-white rounded-2xl border border-gray-100 p-4">
            <div className={`mb-3 ${isEducator || isAdmin ? 'text-xs font-bold text-gray-400 uppercase tracking-widest' : 'text-xs text-gray-400 font-medium'}`}>
              {isEducator || isAdmin ? 'Where would you like to start?' : 'Quick Access'}
            </div>
            <div className="space-y-1">
              {(isEducator || isAdmin ? [
                { href: '/courses',           icon: BookOpen,  label: 'My Courses',  description: 'View and manage your courses'        },
                { href: '/studio',            icon: Brain,     label: 'Build',       description: 'Build and publish AI tools'          },
                { href: '/analytics/faculty', icon: BarChart3, label: 'Analytics',   description: 'Student engagement and scores'       },
                { href: '/hub',               icon: Compass,   label: 'Services',    description: 'Advising, financial aid, registrar'  },
              ] : [
                { href: '/courses',           icon: BookOpen,  label: 'Courses',     description: 'Your enrolled courses and materials' },
                { href: '/tools',             icon: Compass,   label: 'Tools',       description: 'Browse all AI learning tools'        },
                { href: '/hub',               icon: Compass,   label: 'Services',    description: 'Advising, financial aid, registrar'  },
                { href: '/campus',            icon: Gamepad2,  label: 'Community',   description: 'Games, leagues, and social features' },
                { href: '/studio',            icon: Brain,     label: 'Build',       description: 'Create your own AI tools'            },
                ...(isStudent ? [{ href: '/analytics/student', icon: BarChart3, label: 'My Progress', description: 'Sessions, scores and streaks' }] : []),
              ]).map(link => {
                const Icon = link.icon
                return (
                  <Link
                    key={link.href}
                    href={link.href}
                    className="flex items-center gap-2.5 px-3 py-2 rounded-lg hover:bg-blue-50 hover:text-[#0033A0] transition-colors group"
                  >
                    <Icon className="w-4 h-4 text-gray-400 group-hover:text-[#0033A0] flex-shrink-0" />
                    <div className="flex flex-col min-w-0">
                      <span className="text-sm text-gray-700 group-hover:text-[#0033A0] font-medium leading-tight">{link.label}</span>
                      <span className="text-[10px] text-gray-400 leading-tight">{link.description}</span>
                    </div>
                    <ArrowRight className="w-3 h-3 ml-auto text-gray-300 group-hover:text-[#0033A0] flex-shrink-0" />
                  </Link>
                )
              })}
            </div>
          </div>

          {/* Academic Calendar — educators/admins */}
          {(isEducator || isAdmin) && (
            <div className="bg-white rounded-2xl border border-gray-200 overflow-hidden">
              <div className="px-4 py-3 border-b border-gray-100 flex items-center gap-2">
                <Calendar className="w-4 h-4 text-[#0033A0]" />
                <span className="font-bold text-gray-900 text-sm">Academic Calendar</span>
                {FACULTY_CALENDAR.some(i => i.urgent) && (
                  <span className="ml-auto flex items-center gap-1 text-[10px] font-bold text-red-600 bg-red-50 border border-red-200 rounded-full px-2 py-0.5">
                    <AlertCircle className="w-3 h-3" />
                    {FACULTY_CALENDAR.filter(i => i.urgent).length} due soon
                  </span>
                )}
              </div>
              <div className="divide-y divide-gray-50">
                {FACULTY_CALENDAR.map((item, i) => (
                  <div
                    key={i}
                    className={`px-4 py-2.5 flex items-start gap-3 ${item.urgent ? 'bg-red-50/40' : ''}`}
                  >
                    <div className={`text-xs font-extrabold mt-0.5 flex-shrink-0 w-10 text-center ${item.urgent ? 'text-red-600' : 'text-[#0033A0]'}`}>
                      {item.date}
                    </div>
                    <div className="flex-1 min-w-0">
                      <div className="text-xs font-semibold text-gray-900 leading-tight">{item.title}</div>
                      <div className="mt-1">
                        <span className={`text-[10px] font-semibold px-1.5 py-0.5 rounded-full ${
                          item.type === 'grades'   ? 'bg-purple-100 text-purple-700' :
                          item.type === 'deadline' ? 'bg-amber-100 text-amber-700' :
                          item.type === 'event'    ? 'bg-blue-100 text-blue-700' :
                                                     'bg-red-100 text-red-700'
                        }`}>
                          {item.type === 'grades' ? 'Grades due' : item.type === 'deadline' ? 'Deadline' : item.type === 'event' ? 'Event' : 'Exam'}
                        </span>
                      </div>
                    </div>
                    {item.urgent && <AlertCircle className="w-3.5 h-3.5 text-red-500 flex-shrink-0 mt-0.5" />}
                  </div>
                ))}
              </div>
            </div>
          )}

        </div>
      </div>
    </div>
  )
}
