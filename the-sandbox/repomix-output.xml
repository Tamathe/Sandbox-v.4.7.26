  const realTrend = analyticsData?.engagementTrend ?? WEEKLY_ENGAGEMENT

  return (
    <div className="min-h-screen bg-gray-50">
      {/* Header */}
      <div className="bg-gradient-to-r from-[#0033A0] to-[#1a4db5] text-white">
