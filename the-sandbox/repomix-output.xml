                    if (e.key === 'Escape') { setAutocomplete([]); setCustomInput('') }
                  }}
                />
                {autocomplete.length > 0 && (
                  <ul className="absolute z-10 mt-1 w-full bg-white border border-gray-200 rounded-lg shadow-lg overflow-hidden">
