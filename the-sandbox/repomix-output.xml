                {isCreator && tool.toolType === 'CHATBOT' && (
                  <button
                    onClick={() => setShowAudioModal(true)}
                    className="flex items-center gap-2 px-4 py-2 rounded-lg border border-gray-200 hover:bg-gray-50 text-sm font-medium text-gray-700"
