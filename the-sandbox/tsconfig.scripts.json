{
  "compilerOptions": {
    "target": "ES2017",
    "module": "CommonJS",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "outDir": "dist-scripts"
  },
  "include": ["scripts/**/*.ts", "app/generated/prisma/**/*.ts"]
}
