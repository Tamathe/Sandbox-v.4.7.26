generator client {
  provider        = "prisma-client-js"
  output          = "../app/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  role            UserRole       @default(EDUCATOR)
  department      String?
  college         String?
  avatarUrl       String?
  bio             String?
  personalContext String?
  totalXP         Int            @default(0)
  createdAt       DateTime       @default(now())
  tools           Tool[]
  upvotes         Upvote[]
  favorites       Favorite[]
  ratings         ToolRating[]
  comments        Comment[]
  bountiesPosted  Bounty[]       @relation("BountiesPosted")
  bountiesClaimed Bounty[]       @relation("BountiesClaimed")
  courses         Course[]
  xpEvents        XPEvent[]
  userBadges      UserBadge[]
  userQuests      UserQuest[]
  userPlatformQuests UserPlatformQuest[]
  buildSessions   BuildSession[]
  toolSessions    ToolSession[]
  sandTransactions SandTransaction[]
  bountyReviews   BountyReview[]
  libraryEntries  LibraryEntry[]
  leaderboardEntries LeaderboardEntry[]
  challengesIssued   Challenge[]   @relation("ChallengesIssued")
  challengesReceived Challenge[]   @relation("ChallengesReceived")
  collabRequests  CollabRequest[] @relation("CollabRequests")
  collabReviews   CollabReview[]  @relation("CollabReviews")
  conversations   ConversationParticipant[]
  sentMessages    Message[]
  lastSeenAt      DateTime       @default(now())
  lastPath        String?        // Tracks current route (e.g., /courses/...) to derive Learn/Live/Build status
  portfolioItems  PortfolioItem[]
  memories        UserMemory[]
  discussionThreads DiscussionThread[]
  discussionPosts DiscussionPost[]
  permittedContacts UserContact[] @relation("UserPermittedContacts") // People I allow to contact me
  contacting        UserContact[] @relation("UserContacts")          // People who allow me to contact them
  bracketPoolsCreated BracketPool[]     @relation("BracketPoolsCreated")
  bracketEntries      BracketEntry[]    @relation("BracketEntries")
  bracketEmailSubs    BracketEmailSub[] @relation("BracketEmailSubs")
  bookProfile         BookProfile?
  bookDigestSub       BookDigestSub?
  // Course platform
  enrollments         Enrollment[]
  submissions         Submission[]
  gradedSubmissions   Submission[]      @relation("SubmissionGrader")
}

model UserMemory {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  MemoryCategory
  content   String         @db.Text
  source    String         @default("notebook")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId, category])
}

enum MemoryCategory {
  IDENTITY
  GOALS
  STRENGTHS
  CHALLENGES
  PROJECTS
  WRITING_STYLE
  PERSONAL
}

enum UserRole {
  EDUCATOR
  STUDENT
  ADMIN
}

model Tool {
  id                 String                   @id @default(cuid())
  name               String
  shortDescription   String
  fullDescription    String
  category           String
  difficultyLevel    String                   @default("Introductory")
  estimatedMinutes   Int?
  thumbnailUrl       String?
  toolType           ToolType
  externalUrl        String?
  systemPrompt       String?
  personaName        String?                  @default("Sandy")
  personaAvatar      String?
  welcomeMessage     String?
  starterQuestions   String[]
  referenceDocUrls   String[]
  learningObjectives String[]
  intendedAudience   String?
  published          Boolean                  @default(false)
  featured           Boolean                  @default(false)
  approvalStatus     ApprovalStatus           @default(COMMUNITY)
  isOfficialService  Boolean                  @default(false)
  serviceProtocol    String?
  escalationEmail    String?
  webhookSecret      String?                  @default(cuid())
  creatorId          String
  creator            User                     @relation(fields: [creatorId], references: [id])
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  upvotes            Upvote[]
  favorites          Favorite[]
  ratings            ToolRating[]
  comments           Comment[]
  customMetrics      CustomMetricDefinition[]
  metricEvents       MetricEvent[]
  sessions           ToolSession[]
  gamificationConfig GamificationConfig?
  quests             Quest[]
  documents          ToolDocument[]
  sandTransactions   SandTransaction[]
  courseLinks        CourseToolLink[]
  libraryEntries     LibraryEntry[]
  leaderboardEntries LeaderboardEntry[]
  challenges         Challenge[]
  collabRequests     CollabRequest[]

  @@index([creatorId])
  @@index([published, createdAt])
  @@index([category])
  @@index([toolType])
  @@index([approvalStatus])
  @@index([isOfficialService])
}

enum ToolType {
  EXTERNAL
  CHATBOT
  SIMULATION
  QUIZ
  AI_INTERVIEW
  DEBATE
  STUDY_BUDDY
}

enum ApprovalStatus {
  COMMUNITY
  PENDING
  APPROVED
  REJECTED
}

model Upvote {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  user      User     @relation(fields: [userId], references: [id])
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, toolId])
}

model Comment {
  id        String    @id @default(cuid())
  content   String
  pinned    Boolean   @default(false)
  userId    String
  toolId    String
  parentId  String?
  user      User      @relation(fields: [userId], references: [id])
  tool      Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Comment[] @relation("CommentReplies")
  createdAt DateTime  @default(now())
}

model ToolRating {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  rating    Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([toolId])
}

model CustomMetricDefinition {
  id          String     @id @default(cuid())
  toolId      String
  tool        Tool       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  name        String
  type        MetricType
  description String?
}

enum MetricType {
  COUNTER
  DURATION
  RATING
  BOOLEAN
  TEXT
}

model MetricEvent {
  id          String   @id @default(cuid())
  toolId      String
  tool        Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sessionId   String?
  metricName  String
  metricValue String
  createdAt   DateTime @default(now())

  @@index([toolId])
}

model ToolSession {
  id           String    @id @default(cuid())
  toolId       String
  tool         Tool      @relation(fields: [toolId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  courseId     String?
  course       Course?   @relation(fields: [courseId], references: [id])
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  messageCount Int       @default(0)
  notes        String?   @db.Text
  status       String    @default("active")
  chatMessages ChatMessage[]

  @@index([toolId, startedAt])
  @@index([courseId])
}

model ChatMessage {
  id        String      @id @default(cuid())
  sessionId String
  session   ToolSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String
  content   String      @db.Text
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

model Bounty {
  id              String       @id @default(cuid())
  title           String
  description     String
  category        String
  difficulty      String?
  estimatedHours  Int?
  rewardSand      Int          @default(250)
  status          BountyStatus @default(OPEN)
  postedById      String
  postedBy        User         @relation("BountiesPosted", fields: [postedById], references: [id])
  claimedById     String?
  claimedBy       User?        @relation("BountiesClaimed", fields: [claimedById], references: [id])
  claimedAt       DateTime?
  fulfilledToolId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  reviews         BountyReview[]
  sandTransactions SandTransaction[]
}

enum BountyStatus {
  OPEN
  CLAIMED
  FULFILLED
  CLOSED
}

model SandTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Int
  reason      String
  description String?
  bountyId    String?
  bounty      Bounty?  @relation(fields: [bountyId], references: [id], onDelete: SetNull)
  toolId      String?
  tool        Tool?    @relation(fields: [toolId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([bountyId])
  @@index([toolId])
}

model BountyReview {
  id         String   @id @default(cuid())
  bountyId   String
  bounty     Bounty   @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  reviewerId String
  reviewer   User     @relation(fields: [reviewerId], references: [id])
  promptUsed String?
  content    String
  createdAt  DateTime @default(now())

  @@index([bountyId, createdAt])
  @@index([reviewerId, createdAt])
}

// ── Builder ───────────────────────────────────────────────────────────────────

model BuildSession {
  id        String         @id @default(cuid())
  creatorId String
  creator   User           @relation(fields: [creatorId], references: [id])
  title     String?
  toolSpec  Json?
  status    String         @default("ACTIVE")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  documents ToolDocument[]
}

model ToolDocument {
  id        String        @id @default(cuid())
  toolId    String?
  tool      Tool?         @relation(fields: [toolId], references: [id], onDelete: Cascade)
  sessionId String?
  session   BuildSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  filename  String
  content   String
  fileType  String        @default("application/pdf")
  wordCount Int           @default(0)
  createdAt DateTime      @default(now())

  @@index([toolId])
  @@index([sessionId])
}

// ── Courses ──────────────────────────────────────────────────────────────────

model Course {
  id             String           @id @default(cuid())
  courseCode     String           @unique
  title          String
  description    String?
  instructorId   String
  instructor     User             @relation(fields: [instructorId], references: [id])
  isPublic       Boolean          @default(true)
  // Course-platform extensions (architecture doc §3)
  slug           String?          @unique
  status         CourseStatus     @default(DRAFT)
  visibility     CourseVisibility @default(PRIVATE)
  category       String?
  difficulty     String?
  estimatedHours Int?
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  discussionThreads DiscussionThread[]
  materials    CourseMaterial[]
  linkedTools  CourseToolLink[]
  toolSessions ToolSession[]
  modules      CourseModule[]
  enrollments  Enrollment[]
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CourseVisibility {
  PRIVATE
  UNLISTED
  PUBLIC
}

model CourseMaterial {
  id           String   @id @default(cuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id])
  title        String
  content      String
  materialType String   @default("lecture")
  moduleNumber Int?
  isVisible    Boolean  @default(true)
  createdAt    DateTime @default(now())
}

model CourseToolLink {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  toolId    String
  tool      Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  syllabusContext String?
  weekLabel String?
  createdAt DateTime @default(now())

  @@unique([courseId, toolId])
  @@index([courseId])
  @@index([toolId])
}

model PlatformQuest {
  id           String             @id @default(cuid())
  title        String
  description  String
  cadence      QuestCadence
  xpReward     Int
  sandReward   Int
  condition    PlatformQuestType
  targetValue  Int                @default(1)
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  userProgress UserPlatformQuest[]
}

enum QuestCadence {
  DAILY
  WEEKLY
}

enum PlatformQuestType {
  COMPLETE_ANY_SESSION
  COMPLETE_SESSIONS_N
  SCORE_ABOVE_THRESHOLD
  LEAVE_COMMENT
  LAUNCH_MARKETPLACE_TOOL
  COMPLETE_COURSE_TOOL
  HIGH_SCORE_N_TOOLS
}

model UserPlatformQuest {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  questId       String
  quest         PlatformQuest @relation(fields: [questId], references: [id])
  periodStart   DateTime
  progress      Int           @default(0)
  completedAt   DateTime?
  rewardClaimed Boolean       @default(false)
  createdAt     DateTime      @default(now())

  @@unique([userId, questId, periodStart])
  @@index([userId, periodStart])
}

model LeaderboardEntry {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  toolId     String
  tool       Tool        @relation(fields: [toolId], references: [id], onDelete: Cascade)
  courseId   String?
  score      Float
  metricKey  String
  sessionId  String?
  achievedAt DateTime    @default(now())

  @@index([toolId, courseId])
  @@index([userId])
}

model Challenge {
  id              String          @id @default(cuid())
  challengerId    String
  challenger      User            @relation("ChallengesIssued", fields: [challengerId], references: [id])
  challengedId    String
  challenged      User            @relation("ChallengesReceived", fields: [challengedId], references: [id])
  toolId          String
  tool            Tool            @relation(fields: [toolId], references: [id], onDelete: Cascade)
  challengerScore Float
  status          ChallengeStatus @default(PENDING)
  challengedScore Float?
  createdAt       DateTime        @default(now())
  expiresAt       DateTime
  completedAt     DateTime?

  @@index([challengedId, status])
  @@index([challengerId, status])
  @@index([toolId])
}

enum ChallengeStatus {
  PENDING
  ACCEPTED
  COMPLETED
  EXPIRED
}

model LibraryEntry {
  id      String   @id @default(cuid())
  userId  String
  toolId  String
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool    Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([userId, toolId])
  @@index([userId])
}

model DiscussionThread {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPinned  Boolean  @default(false)
  isLocked  Boolean  @default(false)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  posts     DiscussionPost[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId, createdAt])
}

model DiscussionPost {
  id        String   @id @default(cuid())
  content   String
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  threadId  String
  thread    DiscussionThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  parentId  String?
  parent    DiscussionPost?  @relation("PostReplies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   DiscussionPost[] @relation("PostReplies")
  createdAt DateTime @default(now())

  @@index([threadId, createdAt])
}

model CollabRequest {
  id          String        @id @default(cuid())
  toolId      String
  tool        Tool          @relation(fields: [toolId], references: [id], onDelete: Cascade)
  requesterId String
  requester   User          @relation("CollabRequests", fields: [requesterId], references: [id])
  message     String
  status      CollabStatus  @default(OPEN)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  reviews     CollabReview[]

  @@index([status, createdAt])
  @@index([requesterId])
}

// ── Portfolio ────────────────────────────────────────────────────────────────

model PortfolioItem {
  id           String        @id @default(cuid())
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         PortfolioType
  title        String
  organization String?       // Company, University, or Course Name
  startDate    DateTime?
  endDate      DateTime?
  description  String?       @db.Text
  skills       String[]
  url          String?
  isVerified   Boolean       @default(false) // True if generated from Sandbox activity
  metadata     Json?         // Store raw tool stats or AI summary
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@index([type])
}

enum PortfolioType {
  EDUCATION
  EXPERIENCE
  PROJECT
  PUBLICATION
  CERTIFICATION
  SKILL
  AWARD
}

model CollabReview {
  id              String        @id @default(cuid())
  requestId       String
  request         CollabRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  reviewerId      String
  reviewer        User          @relation("CollabReviews", fields: [reviewerId], references: [id])
  transcript      String?
  summary         String?
  rating          Int?
  aiGuidedAnswers Json?
  createdAt       DateTime      @default(now())
}

enum CollabStatus {
  OPEN
  CLOSED
}

// ── Messaging system ──────────────────────────────────────────────────────────

model Conversation {
  id            String                    @id @default(cuid())
  title         String?                   // Optional title for group chats
  isGroup       Boolean                   @default(false)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime                  @default(now()) // Critical for sorting inbox
  participants  ConversationParticipant[]
  messages      Message[]
}

model ConversationParticipant {
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String       @default("MEMBER") // ADMIN, MEMBER
  
  // "Blue Dot" logic: If conversation.lastMessageAt > this.lastReadAt, show unread dot
  lastReadAt     DateTime?    
  joinedAt       DateTime     @default(now())

  @@id([userId, conversationId])
  @@index([userId])
  @@index([conversationId])
}

model Message {
  id             String       @id @default(cuid())
  content        String       @db.Text
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model UserContact {
  id        String   @id @default(cuid())
  userId    String   // The user granting permission (The "User" in "Contact Me" list)
  user      User     @relation("UserPermittedContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactId String   // The user being added (The "Member" who can see the status)
  contact   User     @relation("UserContacts", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, contactId])
  @@index([userId])
  @@index([contactId])
}

// ── Gamification ─────────────────────────────────────────────────────────────

model XPEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  toolId    String?
  metadata  String?
  createdAt DateTime @default(now())
}

model Badge {
  id          String      @id @default(cuid())
  slug        String      @unique
  name        String
  description String
  icon        String
  xpReward    Int         @default(0)
  createdAt   DateTime    @default(now())
  userBadges  UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  badgeId  String
  badge    Badge    @relation(fields: [badgeId], references: [id])
  earnedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model Quest {
  id          String      @id @default(cuid())
  title       String
  description String
  xpReward    Int
  toolId      String?
  tool        Tool?       @relation(fields: [toolId], references: [id], onDelete: Cascade)
  condition   String
  createdAt   DateTime    @default(now())
  userQuests  UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id])
  progress    Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([userId, questId])
}

model GamificationConfig {
  id            String   @id @default(cuid())
  toolId        String   @unique
  tool          Tool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  xpPerMessage  Int      @default(2)
  xpPerSession  Int      @default(10)
  xpHighGrade   Int      @default(25)
  questsEnabled Boolean  @default(false)
  questsJson    String?
  badgesJson    String?
  totalSteps    Int?
  stepLabel     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ─── NCAA Bracket Challenge ───────────────────────────────────────────────────

model BracketPool {
  id          String            @id @default(cuid())
  name        String
  joinCode    String            @unique
  creatorId   String
  creator     User              @relation("BracketPoolsCreated", fields: [creatorId], references: [id])
  year        Int               @default(2026)
  locked      Boolean           @default(false)
  lockedAt    DateTime?
  scoringType String            @default("standard")
  entries     BracketEntry[]
  games       BracketGame[]
  emailSubs   BracketEmailSub[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model BracketEntry {
  id        String      @id @default(cuid())
  poolId    String
  pool      BracketPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("BracketEntries", fields: [userId], references: [id])
  picks     Json        @default("{}")
  score     Int         @default(0)
  rank      Int?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([poolId, userId])
}

model BracketGame {
  id         String      @id @default(cuid())
  poolId     String
  pool       BracketPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  gameNumber Int
  round      Int
  team1      String?
  team2      String?
  winner     String?
  played     Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@unique([poolId, gameNumber])
}

model BracketEmailSub {
  id        String      @id @default(cuid())
  poolId    String
  pool      BracketPool @relation(fields: [poolId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation("BracketEmailSubs", fields: [userId], references: [id])
  email     String
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())

  @@unique([poolId, userId])
}

// ─── Book Recommender ─────────────────────────────────────────────────────────

model BookProfile {
  id              String               @id @default(cuid())
  userId          String               @unique
  user            User                 @relation(fields: [userId], references: [id])
  books           BookEntry[]
  recommendations BookRecommendation[]
  digestSub       BookDigestSub?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

model BookEntry {
  id          String      @id @default(cuid())
  profileId   String
  profile     BookProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title       String
  author      String
  likedReason String?
  disliked    Boolean     @default(false)
  createdAt   DateTime    @default(now())
}

model BookRecommendation {
  id        String      @id @default(cuid())
  profileId String
  profile   BookProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  author    String
  year      String?
  reason    String      @db.Text
  status    String      @default("WANT")
  createdAt DateTime    @default(now())
}

model BookDigestSub {
  id         String      @id @default(cuid())
  profileId  String      @unique
  profile    BookProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  userId     String      @unique
  user       User        @relation(fields: [userId], references: [id])
  email      String
  active     Boolean     @default(true)
  lastSentAt DateTime?
  createdAt  DateTime    @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Course Platform (per docs/COURSE_PLATFORM_ARCHITECTURE.md)
// CourseModule / Lesson / Enrollment / LessonProgress / Assessment / Submission
// ─────────────────────────────────────────────────────────────────────────────

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order     Int
  title     String
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lessons   Lesson[]

  @@index([courseId, order])
}

enum LessonType {
  READING
  TOOL
  CHATBOT
  VIDEO
  ASSESSMENT
}

model Lesson {
  id          String       @id @default(cuid())
  moduleId    String
  module      CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  order       Int
  title       String
  type        LessonType
  // Polymorphic content payload — shape depends on `type`:
  //   READING    → { markdown }
  //   TOOL       → { toolId }
  //   CHATBOT    → { systemPrompt, model, starterMessages }
  //   VIDEO      → { url, durationSec }
  //   ASSESSMENT → { assessmentId }
  contentRef  Json
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  progress    LessonProgress[]
  assessments Assessment[]

  @@index([moduleId, order])
}

enum EnrollmentRole {
  STUDENT
  TA
}

model Enrollment {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  role        EnrollmentRole   @default(STUDENT)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?
  progress    LessonProgress[]
  submissions Submission[]

  @@unique([userId, courseId])
  @@index([courseId])
}

enum LessonProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model LessonProgress {
  id           String               @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment           @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lessonId     String
  lesson       Lesson               @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  status       LessonProgressStatus @default(NOT_STARTED)
  score        Float?
  lastSeenAt   DateTime             @default(now())
  completedAt  DateTime?

  @@unique([enrollmentId, lessonId])
  @@index([lessonId])
}

enum AssessmentType {
  MULTIPLE_CHOICE
  SHORT_ANSWER
  FREE_RESPONSE
}

model Assessment {
  id            String         @id @default(cuid())
  lessonId      String
  lesson        Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type          AssessmentType
  // Rubric / question structure as JSON.  Auto-graded types include answer keys;
  // free-response includes a rubric the AI/educator scores against.
  rubric        Json
  passingScore  Float          @default(0.7)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  submissions   Submission[]

  @@index([lessonId])
}

enum SubmissionGradingMode {
  AUTO
  AI_SUGGESTED
  MANUAL
}

model Submission {
  id            String                 @id @default(cuid())
  assessmentId  String
  assessment    Assessment             @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  enrollmentId  String
  enrollment    Enrollment             @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User                   @relation(fields: [userId], references: [id])
  payload       Json
  score         Float?
  gradingMode   SubmissionGradingMode  @default(AUTO)
  gradedById    String?
  gradedBy      User?                  @relation("SubmissionGrader", fields: [gradedById], references: [id])
  gradedAt      DateTime?
  // Regrade chain — a new Submission supersedes an older one rather than mutating it.
  supersedesId  String?                @unique
  supersedes    Submission?            @relation("SubmissionRegrade", fields: [supersedesId], references: [id])
  supersededBy  Submission?            @relation("SubmissionRegrade")
  createdAt     DateTime               @default(now())

  @@index([assessmentId])
  @@index([enrollmentId])
  @@index([userId])
}
